# Salin ke .env untuk dev lokal: cp .env.example .env
# Semua env var dibaca terpusat oleh src/platform/config (config.Load()).

# development | production | test
APP_ENV=development
# Railway mengisi PORT otomatis di production.
PORT=8080
# Dipakai untuk link di email (reset password). Di Railway otomatis dari RAILWAY_PUBLIC_DOMAIN bila kosong.
BASE_URL=http://localhost:8080
# debug | info | warn | error
LOG_LEVEL=debug
# Wajib (kecuali APP_ENV=test). `make db-up` menjalankan Postgres lokal di port 5433.
DATABASE_URL=postgres://lovoria:lovoria@localhost:5433/lovoria?sslmode=disable
# Pool pgx (opsional).
# DB_MAX_CONNS=10
# DB_MIN_CONNS=0
# DB_MAX_CONN_LIFETIME=30m
# DB_MAX_CONN_IDLE_TIME=5m
# DB_CONNECT_TIMEOUT=5s
# Integration test: user harus boleh CREATE DATABASE (tiap test package dapat DB sendiri).
DATABASE_URL_TEST=postgres://lovoria:lovoria@localhost:5433/lovoria?sslmode=disable
SHUTDOWN_TIMEOUT=10s
# true: /static dibaca dari disk (default di development); false: dari embed binary.
# STATIC_FROM_DISK=true

# Email (reset password). log = hanya ditulis ke log (default, cocok untuk dev).
MAIL_DRIVER=log
MAIL_FROM="Lovoria <no-reply@lovoria.local>"
# MAIL_DRIVER=smtp → SMTP_HOST, SMTP_PORT (587, STARTTLS), SMTP_USERNAME, SMTP_PASSWORD
# MAIL_DRIVER=resend → RESEND_API_KEY

# Penyimpanan foto. local = disk (HANYA development, ditolak di production); r2 = Cloudflare R2.
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/tmp/lovoria-media
# STORAGE_QUOTA_MB=500
# STORAGE_DRIVER=r2 → wajib:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lovoria-media
# R2_PUBLIC_URL=https://media.lovoria.com

# Kunci HMAC form publik (RSVP). Kosong = acak tiap start. Production: openssl rand -hex 32
# APP_SECRET=

# Custom domain (Cloudflare for SaaS) — lihat doc/custom-domain.md. Isi ketiganya atau kosongkan.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CUSTOM_DOMAIN_CNAME_TARGET=domains.lovoria.com
# CUSTOM_DOMAIN_HOST_HEADER=X-Lovoria-Host
# Host Lovoria tambahan (mis. domain Railway lama setelah pindah ke domain sendiri).
# EXTRA_HOSTS=lovaria-production.up.railway.app

# Kata kasar tambahan untuk buku ucapan (dipisah koma), pesan yang cocok disembunyikan otomatis.
# GUESTBOOK_BLOCKED_WORDS=

# Lifecycle: Kenangan → Arsip otomatis setelah N hari sejak H+1.
# LIFECYCLE_ARCHIVE_DAYS=365
