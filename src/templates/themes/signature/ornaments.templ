package signature

import (
	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
	"github.com/khamdanngazis/lovaria/static"
)

// Ornamen tema Signature: SVG inline dekoratif (aria-hidden) yang mengikuti
// warna teks (currentColor), serta bunga & pita watercolor per preset warna.

// sparkle: bintang empat sudut (motif brand Lunovia).
templ sparkle(class string) {
	<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class={ class }>
		<path d="M12 0c.6 6.2 5.8 11.4 12 12-6.2.6-11.4 5.8-12 12-.6-6.2-5.8-11.4-12-12C6.2 11.4 11.4 6.2 12 0z"></path>
	</svg>
}

// divider: garis tipis – bintang – garis tipis.
templ divider(class string) {
	<div class={ "flex items-center justify-center gap-3 text-secondary", class } aria-hidden="true">
		<span class="h-px w-14 bg-current opacity-70"></span>
		@sparkle("h-3 w-3")
		<span class="h-px w-14 bg-current opacity-70"></span>
	</div>
}

// monogram: inisial pasangan dalam lingkaran tipis, terbaca di latar terang.
templ monogram(v view.View, class string) {
	{{ g, b := base.Initials(v) }}
	if g != "" || b != "" {
		<div class={ "lv-display inline-flex items-center justify-center rounded-full border border-secondary text-primary", class } aria-hidden="true">
			<span>{ g }</span>
			if g != "" && b != "" {
				<span class="mx-1 text-[0.6em] text-secondary">&amp;</span>
			}
			<span>{ b }</span>
		</div>
	}
}

// artSize: ukuran asli potongan aset (e2e/floral-tints.js).
func artSize(name string) (w, h string) {
	switch name {
	case "cluster":
		return "416", "332"
	case "corner":
		return "411", "488"
	case "ribbon-left":
		return "416", "168"
	case "ribbon":
		return "843", "308"
	}
	return "68", "44"
}

func artURL(v view.View, name string) string {
	return static.URL("img/themes/signature/floral/" + v.Tokens.Preset + "/" + name + ".webp")
}

// art: potongan aset floral dekoratif. Induk mengatur posisi lewat class; teks
// harus berada di atasnya (relative) dan padding bagian menjaga tidak tertutup.
templ art(v view.View, name, class string, eager bool) {
	{{ w, h := artSize(name) }}
	<img
		src={ artURL(v, name) }
		alt=""
		aria-hidden="true"
		width={ w }
		height={ h }
		if eager {
			fetchpriority="high"
		} else {
			loading="lazy"
		}
		decoding="async"
		class={ "pointer-events-none select-none", class }
	/>
}

// ribbonBand: pita satin melintang selebar halaman sebagai pemisah bagian.
templ ribbonBand(v view.View) {
	@art(v, "ribbon", "block h-auto w-full", false)
}

// frameLines: bingkai garis tipis bersudut takik ala kartu cetak. Dibuat dari
// empat garis + empat busur supaya sudutnya tidak melar di ukuran apa pun.
templ frameLines(class string) {
	<div class={ "pointer-events-none absolute text-secondary", class } aria-hidden="true">
		<span class="absolute inset-x-4 top-0 h-px bg-current opacity-60"></span>
		<span class="absolute inset-x-4 bottom-0 h-px bg-current opacity-60"></span>
		<span class="absolute inset-y-4 left-0 w-px bg-current opacity-60"></span>
		<span class="absolute inset-y-4 right-0 w-px bg-current opacity-60"></span>
		@frameCorner("left-0 top-0")
		@frameCorner("right-0 top-0 -scale-x-100")
		@frameCorner("bottom-0 left-0 -scale-y-100")
		@frameCorner("bottom-0 right-0 rotate-180")
	</div>
}

templ frameCorner(class string) {
	<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-opacity="0.6" class={ "absolute h-4 w-4", class }>
		<path d="M0 16a16 16 0 0 0 16-16" vector-effect="non-scaling-stroke"></path>
	</svg>
}

// label: teks kecil renggang diapit garis tipis.
templ label(text string) {
	<div class="flex items-center justify-center gap-3 text-muted">
		<span class="h-px w-8 flex-none bg-secondary opacity-60 sm:w-14" aria-hidden="true"></span>
		<p class="text-xs uppercase tracking-[0.3em]">{ text }</p>
		<span class="h-px w-8 flex-none bg-secondary opacity-60 sm:w-14" aria-hidden="true"></span>
	</div>
}

// names: nama mempelai serif besar dengan "&" lembut yang menyelip di antaranya.
templ namesStack(groom, bride string) {
	<span class="block break-words">{ groom }</span>
	<span class="relative z-0 -my-3 block text-[0.86em] font-normal italic leading-none text-secondary opacity-75" aria-hidden="true">&amp;</span>
	<span class="sr-only">dan</span>
	<span class="relative block break-words">{ bride }</span>
}

// infoRow: tanggal | jam | tempat tiga kolom dengan garis pemisah.
templ infoRow(date, timeText, venue string) {
	<dl class="mx-auto grid max-w-xl grid-cols-3 divide-x divide-secondary/40 text-center text-sm leading-snug text-deep">
		@infoCell(iconCalendar, "Tanggal", date)
		@infoCell(iconClock, "Waktu", timeText)
		@infoCell(iconPin, "Tempat", venue)
	</dl>
}

templ infoCell(path, term, value string) {
	<div class="min-w-0 px-2">
		<div class="flex justify-center text-primary">
			@icon(path)
		</div>
		<dt class="sr-only">{ term }</dt>
		<dd class="mt-2 break-words">{ value }</dd>
	</div>
}

// icon: ikon garis tipis untuk info acara & hadiah.
templ icon(path string) {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-6 w-6 flex-none text-primary">
		<path d={ path }></path>
	</svg>
}

const (
	iconCalendar = "M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"
	iconClock    = "M12 7v5l3 2m6-2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"
	iconPin      = "M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"
	iconBank     = "M3 10l9-6 9 6M5 10v8m4.7-8v8m4.6-8v8M19 10v8M3 21h18"
)
