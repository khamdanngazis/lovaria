// Package signature: tema Lunovia Signature (T33) — Editorial Floral Luxury:
// kanvas ivory, serif besar, bunga watercolor. Layout, tipografi, dan komposisi
// tetap; warna dari preset (theme.signaturePresets). Tema bawaan wedding baru.
package signature

import (
	"strings"

	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/src/templates/shared"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

const (
	eyebrow = "text-xs uppercase tracking-[0.32em]"
	tagline = "Together, in every chapter of our forever."
)

// Layout: satu kolom di ponsel; kolom lebar (≤ 1150px) di desktop, tanpa panel
// samping, di atas kanvas yang menyatu dengan latar halaman.
templ Layout(v view.View) {
	@layouts.Document(layouts.Meta{Title: "The Wedding of " + v.Couple.Names(), Description: v.OG.Description, Theme: v.ThemeID, Cacheable: true}, base.Head(v), "lv-invitation lv-signature min-h-dvh antialiased") {
		@base.PreviewBanner(v)
		<main class="mx-auto min-h-dvh w-full max-w-[1150px] overflow-hidden bg-surface lg:shadow-2xl lg:shadow-black/10">
			@base.MemoryBanner(v)
			{ children... }
		</main>
	}
}

// Hero: 01 Opening Cover — kertas bercahaya dalam bingkai tipis; bunga besar,
// pita, dan kelopak keluar dari tepi halaman, nama mempelai sebagai fokus.
templ Hero(v view.View) {
	{{ groom, bride := base.FirstNames(v) }}
	<section id="opening" class="lv-paper relative flex min-h-dvh flex-col overflow-hidden text-ink">
		@frameLines("inset-3")
		@art(v, "bouquet", "absolute left-0 top-[-56px] w-[44%] max-w-[380px] md:top-[-90px] [@media(max-height:700px)]:top-[-70px] [@media(max-height:700px)]:w-[38%]", true)
		@art(v, "cluster", "absolute bottom-[12%] left-[-14%] w-[52%] max-w-[380px] opacity-30 blur-[6px]", false)
		@art(v, "ribbon-left", "absolute bottom-0 left-0 w-[56%] max-w-[480px]", true)
		@art(v, "corner", "absolute bottom-0 right-0 w-[50%] max-w-[420px]", true)
		@art(v, "petal-a", "absolute left-[7%] top-[46%] w-5 rotate-[35deg]", false)
		@art(v, "petal-b", "absolute right-[8%] top-[44%] w-7 -rotate-[28deg]", false)
		<div class="lv-cover-body relative my-auto px-8 pb-52 pt-40 text-center md:pb-40 md:pt-24 [@media(max-height:700px)]:pb-36 [@media(max-height:700px)]:pt-28">
			@monogram(v, "h-14 w-14 text-lg")
			<div class="mt-5">
				@label("The Wedding of")
			</div>
			<h1 class="mt-5 text-[clamp(2.75rem,15vw,5.5rem)] font-medium leading-[1.02] text-deep">
				@namesStack(groom, bride)
			</h1>
			<p class="mt-5 text-sm tracking-wide">{ v.DateText }</p>
			<div class="mt-6">
				<p class={ "text-muted", eyebrow }>{ base.GreetingText(v, "Kepada Yth.") }</p>
				<p class="mx-auto mt-2 max-w-xs break-words text-xl text-deep" style="font-family: var(--lv-font-heading)">{ base.GuestName(v) }</p>
			</div>
			@base.OpenButton(v, "lv-btn relative mt-6 px-8", "Buka Undangan", "Lihat Kenangan")
		</div>
	</section>
}

// Intro: 02 Wedding Hero — nama, tagline, dan baris info acara pertama.
templ Intro(v view.View) {
	<section id="wedding-hero" class="lv-paper relative overflow-hidden text-center">
		@art(v, "petal-c", "absolute left-[8%] top-8 w-7 rotate-12", false)
		@art(v, "petal-a", "absolute right-[10%] top-6 w-5 -rotate-[40deg]", false)
		<div class={ "relative px-6 pt-20 md:px-12", templ.KV("md:grid md:grid-cols-2 md:items-center md:gap-12", base.CoverOf(v) != "") }>
			<div>
				@label("The Wedding of")
				<h2 class="mt-6 break-words text-5xl font-medium leading-[1.1] text-deep md:text-6xl">{ v.Couple.Names() }</h2>
				<p class="lv-display mx-auto mt-5 max-w-xs text-2xl italic leading-snug text-primary">{ tagline }</p>
				@divider("mt-7")
				<div class="mt-8">
					if len(v.Events) > 0 {
						@infoRow(v.DateText, v.Events[0].TimeText, v.Events[0].Venue)
					} else {
						<p class="text-sm tracking-wide">{ v.DateText }</p>
					}
				</div>
			</div>
			if base.CoverOf(v) != "" {
				<div class="mx-auto mt-12 w-full max-w-sm border border-secondary/50 p-2 md:mt-0">
					<div class="lv-photo aspect-[4/5] overflow-hidden">
						@base.CoverImage(v, "h-full w-full object-cover")
					</div>
				</div>
			}
		</div>
		<div class="mt-10">
			@ribbonBand(v, "ribbon")
		</div>
	</section>
}

// SectionTitle: judul editorial → garis-bintang-garis → keterangan.
templ SectionTitle(title, subtitle string) {
	<div class="mb-12 text-center">
		<h2 class="text-4xl leading-tight text-deep">{ title }</h2>
		<div class="mt-4 flex items-center justify-center gap-3 text-secondary" aria-hidden="true">
			<span class="h-px w-14 bg-current opacity-70"></span>
			@sparkle("h-3 w-3")
			<span class="h-px w-14 bg-current opacity-70"></span>
		</div>
		if subtitle != "" {
			<p class="mx-auto mt-4 max-w-sm text-sm leading-relaxed text-muted">{ subtitle }</p>
		}
	</div>
}

// Couple: 03 Opening Message — salam dan kalimat undangan, lalu potret mempelai.
// Potret di sini, bukan di cerita, supaya tetap tampil bila cerita disembunyikan.
templ Couple(v view.View) {
	<section id="couple" class="relative overflow-hidden px-6 pb-20 pt-16 md:px-12">
		@art(v, "sprig", "mx-auto mb-6 w-[78%] max-w-[420px]", false)
		<div class="relative">
			// Kalimat undangan milik pasangan menggantikan kalimat bawaan.
			if v.Description != "" {
				@base.Title(v, "Dengan Penuh Syukur", "")
				<p class="mx-auto -mt-6 mb-12 max-w-md whitespace-pre-line text-center text-sm leading-relaxed">{ v.Description }</p>
			} else {
				@base.Title(v, "Dengan Penuh Syukur", "Dengan memohon rahmat Tuhan, kami bermaksud menyelenggarakan pernikahan")
			}
			<div class="md:grid md:grid-cols-2 md:gap-12">
				@person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc, false)
				<p class="my-8 text-center text-5xl italic text-secondary md:hidden" style="font-family: var(--lv-font-heading)" aria-hidden="true">&amp;</p>
				<div class="md:mt-24">
					@person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc, true)
				</div>
			</div>
		</div>
	</section>
}

// person: potret 4:5 berselang kiri/kanan di ponsel; tanpa foto → teks di tengah.
templ person(name, photo, desc string, right bool) {
	if photo != "" {
		<div class={ "w-[80%] md:w-full", templ.KV("ml-auto text-right md:text-left", right) }>
			<div class="border border-secondary/50 p-1.5">
				<img src={ photo } alt={ name } loading="lazy" decoding="async" class="lv-photo aspect-[4/5] w-full object-cover"/>
			</div>
			<h3 class="mt-5 break-words text-2xl leading-tight text-deep">{ name }</h3>
			if desc != "" {
				<p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-muted">{ desc }</p>
			}
		</div>
	} else {
		<div class="text-center">
			<h3 class="break-words text-2xl leading-tight text-deep">{ name }</h3>
			if desc != "" {
				<p class="mx-auto mt-2 max-w-xs whitespace-pre-line text-sm leading-relaxed text-muted">{ desc }</p>
			}
		</div>
	}
}

// storyDate memisahkan tahun dari tanggal cerita: "12 Maret 2019" → "2019",
// "12 Maret"; "2019" → "2019", "".
func storyDate(text string) (year, rest string) {
	text = strings.TrimSpace(text)
	i := strings.LastIndex(text, " ")
	if i < 0 {
		return text, ""
	}
	return text[i+1:], text[:i]
}

// LoveStory: 04 Couple Story — bab bergaya buku cerita pada satu garis waktu;
// foto bercetak berselang kiri-kanan di desktop. Tanpa foto tetap utuh karena
// tahun besar & garis waktu yang menjadi tulang punggungnya.
templ LoveStory(v view.View) {
	if len(v.Stories) > 0 {
		<section id="story" class="lv-paper relative overflow-hidden pt-40 md:pt-24">
			@art(v, "cluster", "absolute left-[-14%] top-[-8px] w-[46%] max-w-[300px] -rotate-12", false)
			<div class="relative px-6 pb-20 md:px-12">
				@base.Title(v, "Cerita Kami", "Setiap bab membawa kami semakin dekat ke hari ini.")
				<ol class="relative mx-auto max-w-4xl">
					<span class="absolute inset-y-0 left-1/2 hidden w-px -translate-x-1/2 bg-secondary/50 md:block" aria-hidden="true"></span>
					for i, s := range v.Stories {
						@storyChapter(s, i)
					}
				</ol>
				<p class="lv-display mx-auto mt-14 max-w-xs text-center text-2xl italic leading-snug text-primary">…and this is only the beginning.</p>
			</div>
		</section>
	}
}

// storyChapter: satu bab — ponsel satu kolom dengan penyambung garis antarbab;
// desktop dua kolom di kiri-kanan garis waktu.
templ storyChapter(s view.Story, i int) {
	{{ year, rest := storyDate(s.DateText) }}
	<li class="relative md:grid md:grid-cols-2 md:items-center md:gap-20 md:py-10">
		<span class="absolute left-1/2 top-1/2 z-10 hidden -translate-x-1/2 -translate-y-1/2 text-secondary md:block" aria-hidden="true">
			@sparkle("h-3.5 w-3.5")
		</span>
		if i > 0 {
			<span class="mx-auto mb-3 block h-12 w-px bg-secondary/50 md:hidden" aria-hidden="true"></span>
		}
		@sparkle("mx-auto mb-3 h-3.5 w-3.5 text-secondary md:hidden")
		<div class={ "text-center", templ.KV("md:order-2 md:text-left", i%2 == 0), templ.KV("md:text-right", i%2 == 1) }>
			<p class="lv-display text-6xl italic leading-none text-primary">{ year }</p>
			if rest != "" {
				<p class={ "mt-2 text-muted", eyebrow }>{ rest }</p>
			}
			<h3 class="mt-3 break-words text-2xl leading-snug text-deep">{ s.Title }</h3>
			if s.Description != "" {
				<p class="mt-3 whitespace-pre-line text-left text-sm leading-relaxed first-letter:float-left first-letter:mr-1.5 first-letter:font-[family-name:var(--lv-font-heading)] first-letter:text-5xl first-letter:leading-[0.85] first-letter:text-primary">{ s.Description }</p>
			}
		</div>
		if s.PhotoURL != "" {
			<div class={ "mx-auto mt-6 w-[88%] border border-secondary/50 bg-paper p-1.5 shadow-sm md:mt-0 md:w-full", templ.KV("-rotate-[1.5deg] md:order-1", i%2 == 0), templ.KV("rotate-[1.5deg]", i%2 == 1) }>
				<img src={ s.PhotoURL } alt={ s.Title } loading="lazy" decoding="async" class="lv-photo aspect-[4/3] w-full object-cover"/>
			</div>
		}
	</li>
}

// Events: 05 Wedding Event — satu kartu cetak berbingkai tipis per acara, baris
// info tiga kolom seperti undangan fisik.
templ Events(v view.View) {
	if len(v.Events) > 0 {
		<section id="events" class="px-6 py-20 md:px-12">
			@base.Title(v, "Acara", base.EventsSubtitle(v))
			<div class="grid gap-8 md:grid-cols-2">
				for _, e := range v.Events {
					<article class="relative bg-paper px-5 py-10 text-center">
						@frameLines("inset-1.5")
						<div class="relative">
							<p class={ "text-muted", eyebrow }>{ e.TypeLabel }</p>
							<h3 class="mt-3 break-words text-3xl leading-tight text-deep">{ e.Name }</h3>
							@divider("mt-5")
							<div class="mt-6">
								@infoRow(e.DateText, e.TimeText, e.Venue)
							</div>
							if e.Address != "" {
								<p class="mt-5 text-sm leading-relaxed text-muted">{ e.Address }</p>
							}
							if e.Description != "" {
								<p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-muted">{ e.Description }</p>
							}
							if e.MapsURL != "" || e.CalendarURL != "" {
								<div class="mt-6 flex flex-wrap justify-center gap-2">
									if e.MapsURL != "" {
										<a href={ templ.SafeURL(e.MapsURL) } target="_blank" rel="noopener" class="lv-btn lv-btn-sm">Buka Peta</a>
									}
									if e.CalendarURL != "" {
										<a href={ templ.SafeURL(e.CalendarURL) } class="lv-btn-outline lv-btn-sm">Simpan ke Kalender</a>
									}
								</div>
							}
						</div>
					</article>
				}
			</div>
		</section>
	}
}

// galleryWide: foto mana yang selebar dua kolom. Foto lanskap lebar & potret
// sempit; bila orientasinya seragam (atau tanpa ukuran) memakai pola bawaan
// supaya grid tetap asimetris. Potret berjumlah ganjil: foto lanskap di
// sebelahnya ikut menyempit sebagai pasangan, supaya grid tidak berlubang dan
// potret tidak terpotong jadi lanskap.
func galleryWide(photos []view.Photo) []bool {
	wide := make([]bool, len(photos))
	last, narrow := -1, 0
	for i, p := range photos {
		wide[i] = p.Width > p.Height
		if !wide[i] {
			last, narrow = i, narrow+1
		}
	}
	if narrow == 0 || narrow == len(photos) {
		for i := range photos {
			wide[i] = base.Wide(i, len(photos))
		}
		return wide
	}
	if narrow%2 == 1 {
		if last+1 < len(photos) {
			wide[last+1] = false
		} else {
			wide[last-1] = false
		}
	}
	return wide
}

// Gallery: 06 — grid asimetris lanskap & potret dari ukuran foto asli.
templ Gallery(v view.View) {
	if len(v.Gallery) > 0 {
		{{ wide := galleryWide(v.Gallery) }}
		<section id="gallery" class="px-4 py-20 md:px-12">
			@base.Title(v, "Galeri", "")
			<div class="mx-auto grid max-w-4xl grid-flow-dense grid-cols-2 gap-2 md:gap-4">
				for i, p := range v.Gallery {
					<a
						href={ templ.SafeURL(p.URL) }
						data-lightbox
						if p.Caption != "" {
							data-caption={ p.Caption }
						}
						aria-label={ base.PhotoLabel(p, i) }
						class={ "lv-photo block overflow-hidden", templ.KV("col-span-2", wide[i]) }
					>
						<img src={ p.ThumbURL } alt={ p.Caption } loading="lazy" decoding="async" class={ "w-full object-cover", templ.KV("aspect-[3/2]", wide[i]), templ.KV("aspect-[3/4]", !wide[i]) }/>
					</a>
				}
			</div>
		</section>
	}
}

// Checkin: 08 Guest Pass — komposisi kartu fisik. QR selalu fungsional: tanpa QR
// pribadi hanya tampil info (link umum) atau contoh kartu (preview dashboard).
templ Checkin(v view.View) {
	if g := v.CheckinGuest(); v.Checkin.QRURL != "" && g != nil {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "QR Kehadiran", "Tunjukkan QR ini kepada penerima tamu di pintu masuk.")
			@guestPass(v) {
				<div class="mx-auto mt-6 w-full max-w-[15rem] rounded-xl border border-secondary/50 bg-white p-3">
					<img src={ v.Checkin.QRURL } alt={ "Kode QR kehadiran untuk " + g.Name } width="512" height="512" loading="lazy" decoding="async" class="block h-auto w-full [image-rendering:pixelated]"/>
				</div>
				<p class="mt-5 break-words text-lg text-deep" style="font-family: var(--lv-font-heading)">{ g.Name }</p>
				<p class="mt-1 text-sm text-muted">Berlaku untuk { shared.CheckinPax(g) } orang</p>
				<a href={ templ.SafeURL(v.Checkin.QRURL) } download={ "qr-kehadiran-" + g.Code + ".png" } class="lv-btn-outline lv-btn-sm mt-5">Simpan QR</a>
				<p class="mt-3 text-xs text-muted">Simpan gambarnya supaya tetap bisa ditunjukkan tanpa sinyal.</p>
			}
		</section>
	} else if v.Checkin.Sample && v.Guest != nil {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "QR Kehadiran", "Contoh kartu tamu. Tiap tamu mendapat QR pribadi di undangannya.")
			@guestPass(v) {
				<div class="mx-auto mt-6 flex aspect-square w-full max-w-[15rem] items-center justify-center border border-dashed border-line bg-white p-6 text-sm text-muted">Contoh — QR pribadi tamu tampil di sini</div>
				<p class="mt-5 break-words text-lg text-deep" style="font-family: var(--lv-font-heading)">{ v.Guest.Name }</p>
			}
		</section>
	} else if v.Checkin.Available {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "Kehadiran", "")
			<p class="mx-auto max-w-sm text-center text-sm leading-relaxed">QR kehadiran pribadi Anda tersedia di link undangan yang kami kirimkan. Tunjukkan QR tersebut kepada penerima tamu di pintu masuk.</p>
		</section>
	}
}

// guestPass: kartu tamu seperti kartu undangan cetak; QR di kotak bergaris tipis.
templ guestPass(v view.View) {
	<div class="lv-paper relative mx-auto max-w-sm overflow-hidden">
		@frameLines("inset-2")
		@art(v, "rose", "absolute right-[-7%] top-[-5%] w-[36%] rotate-[18deg]", false)
		<div class="relative px-6 py-10 text-center">
			@monogram(v, "h-14 w-14 text-lg")
			<div class="mt-4">
				@label("Guest Pass")
			</div>
			<p class="mt-3 break-words text-3xl leading-tight text-deep" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
			<p class="mt-2 text-sm">{ v.DateText }</p>
			if len(v.Events) > 0 {
				<p class="mt-1 break-words text-sm text-muted">{ v.Events[0].Venue }</p>
			}
			{ children... }
		</div>
	</div>
}

// Gift: 09 Wedding Gift — latar lembut, kartu minimal. Judul memakai warna gelap
// supaya kontras di atas latar Soft semua preset.
templ Gift(v view.View) {
	if len(v.Gifts) > 0 {
		<section id="gift" class="bg-soft pb-20 [&_h2+div+p]:text-ink">
			@ribbonBand(v, "ribbon2")
			<div class="px-6 pt-10">
				@base.Title(v, "Tanda Kasih", "Doa restu Anda sudah lebih dari cukup. Namun bila ingin memberi tanda kasih, dapat melalui:")
				<div class="mx-auto grid max-w-3xl gap-4 md:grid-cols-2">
					for _, gf := range v.Gifts {
						<div class="lv-card p-6 text-center">
							<div class="flex justify-center">
								@icon(iconBank)
							</div>
							if gf.Type == "address" {
								<p class="mt-3 text-xs font-medium uppercase tracking-wide text-primary">Kirim hadiah</p>
								if gf.AccountName != "" {
									<p class="mt-2 font-semibold">{ gf.AccountName }</p>
								}
								<p class="mt-1 whitespace-pre-line break-words text-sm">{ gf.Address }</p>
								<button type="button" hidden data-copy={ gf.Address } class="lv-btn-outline lv-btn-sm mt-4">Salin Alamat</button>
							} else {
								<p class="mt-3 text-xs font-medium uppercase tracking-wide text-primary">{ gf.Provider }</p>
								<p class="mt-2 select-all break-words text-xl tracking-wider text-deep">{ gf.AccountNumber }</p>
								<p class="mt-1 text-sm">a.n. { gf.AccountName }</p>
								<button type="button" hidden data-copy={ gf.AccountNumber } class="lv-btn lv-btn-sm mt-4">Salin Nomor</button>
							}
						</div>
					}
				</div>
			</div>
		</section>
	}
}

// Closing: 10 — ucapan terima kasih, nama, tanggal di atas pita & bunga; branding
// Lunovia halus.
templ Closing(v view.View) {
	<section id="closing" class="lv-paper relative overflow-hidden px-8 pb-72 pt-24 text-center md:pb-64">
		@frameLines("inset-3")
		@art(v, "ribbon-left", "absolute bottom-0 left-0 w-[56%] max-w-[480px]", false)
		@art(v, "corner", "absolute bottom-0 right-0 w-[50%] max-w-[420px]", false)
		@art(v, "petal-b", "absolute left-[10%] top-14 w-7 rotate-12", false)
		<div class="relative">
			<p class="mx-auto max-w-xs whitespace-pre-line text-sm leading-relaxed">{ base.ClosingText(v, "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.", "Terima kasih atas doa dan restu yang telah Bapak/Ibu/Saudara/i berikan untuk kami.") }</p>
			<p class="lv-display mt-10 text-2xl italic text-primary">With love,</p>
			<p class="mt-3 break-words text-5xl font-medium leading-tight text-deep" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
			@divider("mt-8")
			<p class="mt-6 text-sm tracking-wide">{ v.DateText }</p>
			@base.Credit(v, "mt-10 text-xs text-muted", "Dibuat dengan Lunovia")
		</div>
	</section>
}
