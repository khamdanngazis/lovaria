// Package signature: tema Lunovia Signature (T33) — Editorial Floral Luxury:
// kanvas ivory, serif besar, bunga watercolor. Layout, tipografi, dan komposisi
// tetap; warna dari preset (theme.signaturePresets). Tema bawaan wedding baru.
package signature

import (
	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/src/templates/shared"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

const (
	eyebrow = "text-xs uppercase tracking-[0.32em]"
	tagline = "Together, in every chapter of our forever."
)

// Layout: satu kolom di ponsel; kolom lebar (≤ 1150px) di desktop, tanpa panel
// samping, di atas kanvas yang menyatu dengan latar halaman.
templ Layout(v view.View) {
	@layouts.Document(layouts.Meta{Title: "The Wedding of " + v.Couple.Names(), Description: v.OG.Description, Theme: v.ThemeID, Cacheable: true}, base.Head(v), "lv-invitation lv-signature min-h-dvh antialiased") {
		@base.PreviewBanner(v)
		<main class="mx-auto min-h-dvh w-full max-w-[1150px] overflow-hidden">
			@base.MemoryBanner(v)
			{ children... }
		</main>
	}
}

// Hero: 01 Opening Cover — kanvas ivory layar penuh, bunga di dua sudut, nama
// mempelai sebagai fokus. Foto sampul tampil di Intro.
templ Hero(v view.View) {
	{{ groom, bride := base.FirstNames(v) }}
	<section id="opening" class="relative flex min-h-dvh flex-col overflow-hidden bg-surface text-ink">
		@floral(v, "tl", floralLarge, true)
		@floral(v, "br", floralLarge, true)
		<div class="lv-cover-body relative my-auto px-8 py-32 text-center [@media(max-height:700px)]:py-20">
			@monogram(v, "h-16 w-16 text-xl")
			<p class={ "mt-7 text-muted", eyebrow }>The Wedding of</p>
			<h1 class="lv-display mt-5 break-words text-6xl leading-[1.05] text-deep md:text-7xl [@media(max-height:700px)]:text-5xl">
				{ groom }
				<span class="my-1 block text-4xl italic text-secondary">&amp;</span>
				{ bride }
			</h1>
			@divider("mt-7")
			<p class="mt-6 text-sm tracking-wide">{ v.DateText }</p>
			<div class="mt-9 [@media(max-height:700px)]:mt-6">
				<p class={ "text-muted", eyebrow }>{ base.GreetingText(v, "Kepada Yth.") }</p>
				<p class="mt-2 break-words text-xl text-deep" style="font-family: var(--lv-font-heading)">{ base.GuestName(v) }</p>
			</div>
			@base.OpenButton(v, "lv-btn mt-8 px-8", "Buka Undangan", "Lihat Kenangan")
		</div>
	</section>
}

// Intro: 02 Wedding Hero — identitas pernikahan setelah sampul dibuka.
templ Intro(v view.View) {
	<section id="wedding-hero" class="relative overflow-hidden px-6 py-24 text-center md:px-12">
		@floral(v, "tr", floralSmall, false)
		<div class={ "relative", templ.KV("md:grid md:grid-cols-2 md:items-center md:gap-12", base.CoverOf(v) != "") }>
			<div>
				<p class={ "text-muted", eyebrow }>THE WEDDING OF</p>
				<h2 class="lv-display mt-6 break-words text-5xl leading-[1.1] text-deep md:text-6xl">{ v.Couple.Names() }</h2>
				<p class="lv-display mx-auto mt-5 max-w-xs text-xl italic leading-snug">{ tagline }</p>
				@divider("mt-7")
				<p class="mt-6 text-sm tracking-wide">{ v.DateText }</p>
			</div>
			if base.CoverOf(v) != "" {
				<div class="lv-photo mx-auto mt-10 aspect-[4/5] w-full max-w-sm overflow-hidden md:mt-0">
					@base.CoverImage(v, "h-full w-full object-cover")
				</div>
			}
		</div>
	</section>
}

// SectionTitle: bintang kecil → judul editorial → keterangan.
templ SectionTitle(title, subtitle string) {
	<div class="mb-12 text-center">
		@sparkle("mx-auto h-3 w-3 text-secondary")
		<h2 class="mt-4 text-4xl leading-tight text-primary">{ title }</h2>
		if subtitle != "" {
			<p class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-muted">{ subtitle }</p>
		}
	</div>
}

// Couple: 03 Opening Message — salam dan kalimat undangan, lalu potret mempelai.
// Potret di sini, bukan di cerita, supaya tetap tampil bila cerita disembunyikan.
templ Couple(v view.View) {
	<section id="couple" class="px-6 py-20 md:px-12">
		// Kalimat undangan milik pasangan menggantikan kalimat bawaan.
		if v.Description != "" {
			@base.Title(v, "Dengan Penuh Syukur", "")
			<p class="mx-auto -mt-6 mb-12 max-w-md whitespace-pre-line text-center text-sm leading-relaxed">{ v.Description }</p>
		} else {
			@base.Title(v, "Dengan Penuh Syukur", "Dengan memohon rahmat Tuhan, kami bermaksud menyelenggarakan pernikahan")
		}
		<div class="md:grid md:grid-cols-2 md:gap-12">
			@person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc, false)
			<p class="lv-display my-8 text-center text-5xl italic text-secondary md:hidden" aria-hidden="true">&amp;</p>
			<div class="md:mt-24">
				@person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc, true)
			</div>
		</div>
	</section>
}

// person: potret 4:5 berselang kiri/kanan di ponsel; tanpa foto → teks di tengah.
templ person(name, photo, desc string, right bool) {
	if photo != "" {
		<div class={ "w-[80%] md:w-full", templ.KV("ml-auto text-right md:text-left", right) }>
			<img src={ photo } alt={ name } loading="lazy" decoding="async" class="lv-photo aspect-[4/5] w-full object-cover"/>
			<h3 class="lv-display mt-5 break-words text-3xl leading-tight text-deep">{ name }</h3>
			if desc != "" {
				<p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-muted">{ desc }</p>
			}
		</div>
	} else {
		<div class="text-center">
			<h3 class="lv-display break-words text-3xl leading-tight text-deep">{ name }</h3>
			if desc != "" {
				<p class="mx-auto mt-2 max-w-xs whitespace-pre-line text-sm leading-relaxed text-muted">{ desc }</p>
			}
		</div>
	}
}

// LoveStory: 04 Couple Story — foto dan teks berselang, tanpa kartu berulang.
templ LoveStory(v view.View) {
	if len(v.Stories) > 0 {
		<section id="story" class="px-6 py-20 md:px-12">
			@base.Title(v, "Cerita Kami", "")
			<ol class="space-y-14">
				for i, s := range v.Stories {
					<li class={ templ.KV("md:grid md:grid-cols-2 md:items-center md:gap-12", s.PhotoURL != "") }>
						if s.PhotoURL != "" {
							<img src={ s.PhotoURL } alt="" loading="lazy" decoding="async" class={ "lv-photo mb-5 aspect-[4/3] w-full object-cover md:mb-0", templ.KV("md:order-2", i%2 == 1) }/>
						}
						<div class={ templ.KV("mx-auto max-w-md text-center", s.PhotoURL == "") }>
							<p class={ "text-muted", eyebrow }>{ s.DateText }</p>
							<h3 class="mt-2 break-words text-2xl leading-snug text-deep">{ s.Title }</h3>
							if s.Description != "" {
								<p class="mt-3 whitespace-pre-line text-sm leading-relaxed">{ s.Description }</p>
							}
						</div>
					</li>
				}
			</ol>
		</section>
	}
}

// Events: 05 Wedding Event — dipisah garis tipis, ikon kalender, jam, lokasi.
templ Events(v view.View) {
	if len(v.Events) > 0 {
		<section id="events" class="bg-paper px-6 py-20 md:px-12">
			@base.Title(v, "Acara", base.EventsSubtitle(v))
			<div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
				for _, e := range v.Events {
					<article class="border-t border-line pt-8">
						<p class={ "text-muted", eyebrow }>{ e.TypeLabel }</p>
						<h3 class="mt-2 break-words text-3xl leading-tight text-deep">{ e.Name }</h3>
						<dl class="mt-6 space-y-4 text-sm">
							<div class="flex gap-3">
								@icon(iconCalendar)
								<div>
									<dt class="sr-only">Tanggal</dt>
									<dd class="font-medium">{ e.DateText }</dd>
								</div>
							</div>
							<div class="flex gap-3">
								@icon(iconClock)
								<div>
									<dt class="sr-only">Waktu</dt>
									<dd>{ e.TimeText }</dd>
								</div>
							</div>
							<div class="flex gap-3">
								@icon(iconPin)
								<div>
									<dt class="sr-only">Tempat</dt>
									<dd class="font-medium">{ e.Venue }</dd>
									if e.Address != "" {
										<dd class="text-muted">{ e.Address }</dd>
									}
								</div>
							</div>
						</dl>
						if e.Description != "" {
							<p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-muted">{ e.Description }</p>
						}
						if e.MapsURL != "" || e.CalendarURL != "" {
							<div class="mt-6 flex flex-wrap gap-2">
								if e.MapsURL != "" {
									<a href={ templ.SafeURL(e.MapsURL) } target="_blank" rel="noopener" class="lv-btn lv-btn-sm">Buka Peta</a>
								}
								if e.CalendarURL != "" {
									<a href={ templ.SafeURL(e.CalendarURL) } class="lv-btn-outline lv-btn-sm">Simpan ke Kalender</a>
								}
							</div>
						}
					</article>
				}
			</div>
		</section>
	}
}

// galleryWide: foto mana yang selebar dua kolom. Foto lanskap lebar & potret
// sempit; bila orientasinya seragam (atau tanpa ukuran) memakai pola bawaan
// supaya grid tetap asimetris. Potret berjumlah ganjil: foto lanskap di
// sebelahnya ikut menyempit sebagai pasangan, supaya grid tidak berlubang dan
// potret tidak terpotong jadi lanskap.
func galleryWide(photos []view.Photo) []bool {
	wide := make([]bool, len(photos))
	last, narrow := -1, 0
	for i, p := range photos {
		wide[i] = p.Width > p.Height
		if !wide[i] {
			last, narrow = i, narrow+1
		}
	}
	if narrow == 0 || narrow == len(photos) {
		for i := range photos {
			wide[i] = base.Wide(i, len(photos))
		}
		return wide
	}
	if narrow%2 == 1 {
		if last+1 < len(photos) {
			wide[last+1] = false
		} else {
			wide[last-1] = false
		}
	}
	return wide
}

// Gallery: 06 — grid asimetris lanskap & potret dari ukuran foto asli.
templ Gallery(v view.View) {
	if len(v.Gallery) > 0 {
		{{ wide := galleryWide(v.Gallery) }}
		<section id="gallery" class="px-4 py-20 md:px-12">
			@base.Title(v, "Galeri", "")
			<div class="mx-auto grid max-w-4xl grid-flow-dense grid-cols-2 gap-2 md:gap-4">
				for i, p := range v.Gallery {
					<a
						href={ templ.SafeURL(p.URL) }
						data-lightbox
						if p.Caption != "" {
							data-caption={ p.Caption }
						}
						aria-label={ base.PhotoLabel(p, i) }
						class={ "lv-photo block overflow-hidden", templ.KV("col-span-2", wide[i]) }
					>
						<img src={ p.ThumbURL } alt={ p.Caption } loading="lazy" decoding="async" class={ "w-full object-cover", templ.KV("aspect-[3/2]", wide[i]), templ.KV("aspect-[3/4]", !wide[i]) }/>
					</a>
				}
			</div>
		</section>
	}
}

// Checkin: 08 Guest Pass — komposisi kartu fisik. QR selalu fungsional: tanpa QR
// pribadi hanya tampil info (link umum) atau contoh kartu (preview dashboard).
templ Checkin(v view.View) {
	if v.Checkin.QRURL != "" && v.Guest != nil {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "QR Kehadiran", "Tunjukkan QR ini kepada penerima tamu di pintu masuk.")
			@guestPass(v) {
				<div class="mx-auto mt-6 w-full max-w-[15rem] bg-white p-2">
					<img src={ v.Checkin.QRURL } alt={ "Kode QR kehadiran untuk " + v.Guest.Name } width="512" height="512" loading="lazy" decoding="async" class="block h-auto w-full [image-rendering:pixelated]"/>
				</div>
				<p class="mt-5 break-words text-lg text-deep" style="font-family: var(--lv-font-heading)">{ v.Guest.Name }</p>
				<p class="mt-1 text-sm text-muted">Berlaku untuk { shared.CheckinPax(v.Guest) } orang</p>
				<a href={ templ.SafeURL(v.Checkin.QRURL) } download={ "qr-kehadiran-" + v.Guest.Code + ".png" } class="lv-btn-outline lv-btn-sm mt-5">Simpan QR</a>
				<p class="mt-3 text-xs text-muted">Simpan gambarnya supaya tetap bisa ditunjukkan tanpa sinyal.</p>
			}
		</section>
	} else if v.Checkin.Sample && v.Guest != nil {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "QR Kehadiran", "Contoh kartu tamu. Tiap tamu mendapat QR pribadi bila check-in dinyalakan.")
			@guestPass(v) {
				<div class="mx-auto mt-6 flex aspect-square w-full max-w-[15rem] items-center justify-center border border-dashed border-line bg-white p-6 text-sm text-muted">Contoh — QR pribadi tamu tampil di sini</div>
				<p class="mt-5 break-words text-lg text-deep" style="font-family: var(--lv-font-heading)">{ v.Guest.Name }</p>
			}
		</section>
	} else if v.Checkin.Available {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "Kehadiran", "")
			<p class="mx-auto max-w-sm text-center text-sm leading-relaxed">QR kehadiran pribadi Anda tersedia di link undangan yang kami kirimkan. Tunjukkan QR tersebut kepada penerima tamu di pintu masuk.</p>
		</section>
	}
}

// guestPass: kartu tamu berbingkai ganda seperti kartu undangan cetak.
templ guestPass(v view.View) {
	<div class="mx-auto max-w-sm border border-line bg-paper p-2">
		<div class="border border-line px-5 py-8 text-center">
			@monogram(v, "h-14 w-14 text-lg")
			<p class={ "mt-4 text-muted", eyebrow }>Guest Pass</p>
			<p class="lv-display mt-2 break-words text-3xl leading-tight text-deep">{ v.Couple.Names() }</p>
			<p class="mt-2 text-sm">{ v.DateText }</p>
			if len(v.Events) > 0 {
				<p class="mt-1 break-words text-sm text-muted">{ v.Events[0].Venue }</p>
			}
			{ children... }
		</div>
	</div>
}

// Gift: 09 Wedding Gift — latar lembut, kartu minimal. Judul memakai warna gelap
// supaya kontras di atas latar Soft semua preset.
templ Gift(v view.View) {
	if len(v.Gifts) > 0 {
		<section id="gift" class="bg-soft px-6 py-20 [&_h2]:text-deep [&_h2+p]:text-ink">
			@base.Title(v, "Tanda Kasih", "Doa restu Anda sudah lebih dari cukup. Namun bila ingin memberi tanda kasih, dapat melalui:")
			<div class="mx-auto grid max-w-3xl gap-4 md:grid-cols-2">
				for _, gf := range v.Gifts {
					<div class="lv-card p-6 text-center">
						<div class="flex justify-center">
							@icon(iconBank)
						</div>
						if gf.Type == "address" {
							<p class="mt-3 text-xs font-medium uppercase tracking-wide text-primary">Kirim hadiah</p>
							if gf.AccountName != "" {
								<p class="mt-2 font-semibold">{ gf.AccountName }</p>
							}
							<p class="mt-1 whitespace-pre-line break-words text-sm">{ gf.Address }</p>
							<button type="button" hidden data-copy={ gf.Address } class="lv-btn-outline lv-btn-sm mt-4">Salin Alamat</button>
						} else {
							<p class="mt-3 text-xs font-medium uppercase tracking-wide text-primary">{ gf.Provider }</p>
							<p class="mt-2 select-all break-words text-xl tracking-wider text-deep">{ gf.AccountNumber }</p>
							<p class="mt-1 text-sm">a.n. { gf.AccountName }</p>
							<button type="button" hidden data-copy={ gf.AccountNumber } class="lv-btn lv-btn-sm mt-4">Salin Nomor</button>
						}
					</div>
				}
			</div>
		</section>
	}
}

// Closing: 10 — ucapan terima kasih, nama, tanggal; branding Lunovia halus.
templ Closing(v view.View) {
	<section id="closing" class="relative overflow-hidden bg-surface px-8 py-44 text-center md:py-56">
		@floral(v, "tr", floralMedium, false)
		@floral(v, "bl", floralMedium, false)
		<div class="relative">
			<p class="mx-auto max-w-xs whitespace-pre-line text-sm leading-relaxed">{ base.ClosingText(v, "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.", "Terima kasih atas doa dan restu yang telah Bapak/Ibu/Saudara/i berikan untuk kami.") }</p>
			<p class="lv-display mt-10 text-xl italic text-muted">With love,</p>
			<p class="lv-display mt-3 break-words text-5xl leading-tight text-deep">{ v.Couple.Names() }</p>
			@divider("mt-8")
			<p class="mt-6 text-sm tracking-wide">{ v.DateText }</p>
			@base.Credit(v, "mt-12 text-xs text-muted", "Dibuat dengan Lunovia")
		</div>
	</section>
}
