// Package signature: tema Lunovia Signature (T33) — Editorial Floral Luxury:
// kanvas ivory, serif besar, bunga watercolor. Layout, tipografi, dan komposisi
// tetap; warna dari preset (theme.signaturePresets). Tema bawaan wedding baru.
package signature

import (
	"fmt"
	"strings"
	"unicode/utf8"

	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/src/templates/shared"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

const (
	eyebrow = "text-xs uppercase tracking-[0.32em]"
	tagline = "Together, in every chapter of our forever."
)

// Layout: satu kolom di ponsel; mulai tablet dua panel — panel kiri menempel
// (foto sampul, nama, tanggal), kolom undangan menggulir di kanan. Kolom kanan
// selebar ponsel, jadi semua bagian memakai susunan yang sama di setiap layar;
// ukuran nama mengikuti lebar kolom (cqw), bukan lebar layar.
templ Layout(v view.View) {
	@layouts.Document(layouts.Meta{Title: "The Wedding of " + v.Couple.Names(), Description: v.OG.Description, Theme: v.ThemeID, Cacheable: true}, base.Head(v), "lv-invitation lv-signature min-h-dvh antialiased") {
		@base.PreviewBanner(v)
		<div class="md:grid md:grid-cols-[minmax(0,1fr)_28rem] xl:grid-cols-[minmax(0,1fr)_30rem]">
			@sidePanel(v)
			<main class="mx-auto min-h-dvh w-full max-w-md overflow-hidden bg-surface shadow-2xl shadow-black/10 [container-type:inline-size] md:max-w-none">
				@base.MemoryBanner(v)
				{ children... }
			</main>
		</div>
	}
}

// sidePanel: panel kiri tablet & desktop — dekoratif (isi yang sama ada di sampul),
// jadi aria-hidden. Tersembunyi di ponsel; fotonya lazy supaya tidak diunduh di
// sana. Tanpa foto: kertas bercahaya dengan bunga.
templ sidePanel(v view.View) {
	if cover := base.CoverOf(v); cover != "" {
		<aside class="sticky top-0 hidden h-dvh overflow-hidden bg-deep text-white md:block" aria-hidden="true">
			<img src={ cover } alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover"/>
			<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0)_35%,rgba(0,0,0,0.55)_62%,rgba(0,0,0,0.82))]"></div>
			<div class="relative flex h-full flex-col items-center justify-end px-10 pb-16 text-center">
				@base.Monogram(v, "h-16 w-16 text-xl")
				<p class="mt-6 text-xs uppercase tracking-[0.35em] opacity-90">The Wedding of</p>
				<p class="mt-4 text-5xl leading-tight xl:text-6xl" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
				<div class="mt-6 h-px w-16 bg-accent"></div>
				<p class="mt-6 text-sm tracking-wide">{ v.DateText }</p>
			</div>
		</aside>
	} else {
		<aside class="lv-paper sticky top-0 hidden h-dvh overflow-hidden text-deep md:block" aria-hidden="true">
			@art(v, "bouquet", "absolute left-0 top-[-60px] w-[60%] max-w-[360px]", false)
			@art(v, "corner", "absolute bottom-0 right-0 w-[50%] max-w-[320px]", false)
			<div class="relative flex h-full flex-col items-center justify-center px-10 text-center">
				<p class="text-xs uppercase tracking-[0.35em] text-muted">The Wedding of</p>
				<p class="mt-4 text-5xl leading-tight xl:text-6xl" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
				@divider("mt-6")
				<p class="mt-6 text-sm tracking-wide">{ v.DateText }</p>
			</div>
		</aside>
	}
}

// nameSize: ukuran nama di sampul dari nama depan terpanjang, sebesar mungkin
// tanpa memotong kata. Layar pendek satu tingkat lebih kecil agar tombol terjangkau.
func nameSize(groom, bride string) string {
	switch n := max(utf8.RuneCountInString(groom), utf8.RuneCountInString(bride)); {
	case n <= 7:
		return "text-[clamp(3.25rem,19cqw,7rem)] [@media(max-height:700px)]:text-[clamp(2.75rem,15cqw,5.5rem)]"
	case n <= 10:
		return "text-[clamp(2.75rem,15cqw,5.5rem)] [@media(max-height:700px)]:text-[clamp(2.25rem,11cqw,4.5rem)]"
	}
	return "text-[clamp(2.25rem,11cqw,4.5rem)]"
}

// Hero: 01 Opening Cover — kertas bercahaya dalam bingkai tipis; nama mempelai
// sebagai fokus dengan ruang lega, bunga & pita hanya di sudut jauh.
templ Hero(v view.View) {
	{{ groom, bride := base.FirstNames(v) }}
	<section id="opening" class="lv-paper relative flex min-h-dvh flex-col overflow-hidden text-ink">
		@frameLines("inset-3")
		@art(v, "bouquet", "absolute left-0 top-[-56px] w-[38%] max-w-[320px] [@media(max-height:700px)]:top-[-70px] [@media(max-height:700px)]:w-[32%]", true)
		@art(v, "ribbon-left", "absolute bottom-0 left-0 w-[46%] max-w-[400px]", true)
		@art(v, "corner", "absolute bottom-0 right-0 w-[42%] max-w-[340px]", true)
		<div class="lv-cover-body relative my-auto px-6 pb-40 pt-36 text-center [@media(max-height:700px)]:pb-28 [@media(max-height:700px)]:pt-20">
			@monogram(v, "h-11 w-11 text-sm")
			<div class="mt-4">
				@label("The Wedding of")
			</div>
			<h1 class={ "mt-8 font-medium leading-[1.02] text-deep [@media(max-height:700px)]:mt-5", nameSize(groom, bride) }>
				@namesStack(groom, bride)
			</h1>
			<p class="mt-8 text-sm tracking-wide [@media(max-height:700px)]:mt-5">{ v.DateText }</p>
			<div class="mt-6">
				<p class={ "text-muted", eyebrow }>{ base.GreetingText(v, "Kepada Yth.") }</p>
				<p class="mx-auto mt-2 max-w-xs break-words text-xl text-deep" style="font-family: var(--lv-font-heading)">{ base.GuestName(v) }</p>
			</div>
			@base.OpenButton(v, "lv-btn relative mt-6 px-8", "Buka Undangan", "Lihat Kenangan")
		</div>
	</section>
}

// Intro: 02 Wedding Hero — nama, tagline, dan baris info acara pertama.
templ Intro(v view.View) {
	<section id="wedding-hero" class="lv-paper relative overflow-hidden text-center">
		@art(v, "petal-c", "absolute left-[8%] top-8 w-7 rotate-12", false)
		@art(v, "petal-a", "absolute right-[10%] top-6 w-5 -rotate-[40deg]", false)
		<div class="relative px-6 pt-20">
			<div>
				@label("The Wedding of")
				<h2 class="mt-6 break-words text-5xl font-medium leading-[1.1] text-deep">{ v.Couple.Names() }</h2>
				<p class="lv-display mx-auto mt-5 max-w-xs text-2xl italic leading-snug text-primary">{ tagline }</p>
				@divider("mt-7")
				<div class="mt-8">
					if len(v.Events) > 0 {
						@infoRow(v.DateText, v.Events[0].TimeText, v.Events[0].Venue)
					} else {
						<p class="text-sm tracking-wide">{ v.DateText }</p>
					}
				</div>
			</div>
			if base.CoverOf(v) != "" {
				<div class="mx-auto mt-12 w-full max-w-sm border border-secondary/50 p-2">
					<div class="lv-photo aspect-[4/5] overflow-hidden">
						@base.CoverImage(v, "h-full w-full object-cover")
					</div>
				</div>
			}
		</div>
		<div class="mt-10">
			@ribbonBand(v, "ribbon")
		</div>
	</section>
}

// SectionTitle: judul editorial → garis-bintang-garis → keterangan.
templ SectionTitle(title, subtitle string) {
	<div class="mb-12 text-center">
		<h2 class="text-4xl leading-tight text-deep">{ title }</h2>
		<div class="mt-4 flex items-center justify-center gap-3 text-secondary" aria-hidden="true">
			<span class="h-px w-14 bg-current opacity-70"></span>
			@sparkle("h-3 w-3")
			<span class="h-px w-14 bg-current opacity-70"></span>
		</div>
		if subtitle != "" {
			<p class="mx-auto mt-4 max-w-sm text-sm leading-relaxed text-muted">{ subtitle }</p>
		}
	</div>
}

// Couple: 03 Opening Message — salam dan kalimat undangan, lalu potret mempelai.
// Potret di sini, bukan di cerita, supaya tetap tampil bila cerita disembunyikan.
templ Couple(v view.View) {
	<section id="couple" class="relative overflow-hidden px-6 pb-20 pt-16">
		@art(v, "sprig", "mx-auto mb-6 w-[78%] max-w-[420px]", false)
		<div class="relative">
			// Kalimat undangan milik pasangan menggantikan kalimat bawaan.
			if v.Description != "" {
				@base.Title(v, "Dengan Penuh Syukur", "")
				<p class="mx-auto -mt-6 mb-12 max-w-md whitespace-pre-line text-center text-sm leading-relaxed">{ v.Description }</p>
			} else {
				@base.Title(v, "Dengan Penuh Syukur", "Dengan memohon rahmat Tuhan, kami bermaksud menyelenggarakan pernikahan")
			}
			<div>
				@person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc, false)
				<p class="my-8 text-center text-5xl italic text-secondary" style="font-family: var(--lv-font-heading)" aria-hidden="true">&amp;</p>
				<div>
					@person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc, true)
				</div>
			</div>
		</div>
	</section>
}

// person: potret 4:5 berselang kiri/kanan di ponsel; tanpa foto → teks di tengah.
templ person(name, photo, desc string, right bool) {
	if photo != "" {
		<div class={ "w-[80%]", templ.KV("ml-auto text-right", right) }>
			<div class="border border-secondary/50 p-1.5">
				<img src={ photo } alt={ name } loading="lazy" decoding="async" class="lv-photo aspect-[4/5] w-full object-cover"/>
			</div>
			<h3 class="mt-5 break-words text-2xl leading-tight text-deep">{ name }</h3>
			if desc != "" {
				<p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-muted">{ desc }</p>
			}
		</div>
	} else {
		<div class="text-center">
			<h3 class="break-words text-2xl leading-tight text-deep">{ name }</h3>
			if desc != "" {
				<p class="mx-auto mt-2 max-w-xs whitespace-pre-line text-sm leading-relaxed text-muted">{ desc }</p>
			}
		</div>
	}
}

// storyDate memisahkan tahun dari tanggal cerita: "12 Maret 2019" → "2019",
// "12 Maret"; "2019" → "2019", "".
func storyDate(text string) (year, rest string) {
	text = strings.TrimSpace(text)
	i := strings.LastIndex(text, " ")
	if i < 0 {
		return text, ""
	}
	return text[i+1:], text[:i]
}

// LoveStory: 04 Couple Story — bab bergaya buku cerita pada satu garis waktu;
// foto bercetak berselang kiri-kanan di desktop. Tanpa foto tetap utuh karena
// tahun besar & garis waktu yang menjadi tulang punggungnya.
templ LoveStory(v view.View) {
	if len(v.Stories) > 0 {
		<section id="story" class="lv-paper relative overflow-hidden pt-40">
			@art(v, "cluster", "absolute left-[-14%] top-[-8px] w-[46%] max-w-[300px] -rotate-12", false)
			<div class="relative px-6 pb-20">
				@base.Title(v, "Cerita Kami", "Setiap bab membawa kami semakin dekat ke hari ini.")
				<ol class="relative mx-auto max-w-4xl">
					for i, s := range v.Stories {
						@storyChapter(s, i)
					}
				</ol>
				<p class="lv-display mx-auto mt-14 max-w-xs text-center text-2xl italic leading-snug text-primary">…and this is only the beginning.</p>
			</div>
		</section>
	}
}

// storyChapter: satu bab — ponsel satu kolom dengan penyambung garis antarbab;
// desktop dua kolom di kiri-kanan garis waktu.
templ storyChapter(s view.Story, i int) {
	{{ year, rest := storyDate(s.DateText) }}
	<li class="relative">
		if i > 0 {
			<span class="mx-auto mb-3 block h-12 w-px bg-secondary/50" aria-hidden="true"></span>
		}
		@sparkle("mx-auto mb-3 h-3.5 w-3.5 text-secondary")
		<div class="text-center">
			<p class="lv-display text-6xl italic leading-none text-primary">{ year }</p>
			if rest != "" {
				<p class={ "mt-2 text-muted", eyebrow }>{ rest }</p>
			}
			<h3 class="mt-3 break-words text-2xl leading-snug text-deep">{ s.Title }</h3>
			if s.Description != "" {
				<p class="mt-3 whitespace-pre-line text-left text-sm leading-relaxed first-letter:float-left first-letter:mr-1.5 first-letter:font-[family-name:var(--lv-font-heading)] first-letter:text-5xl first-letter:leading-[0.85] first-letter:text-primary">{ s.Description }</p>
			}
		</div>
		if s.PhotoURL != "" {
			<div class={ "mx-auto mt-6 w-[88%] border border-secondary/50 bg-paper p-1.5 shadow-sm", templ.KV("-rotate-[1.5deg]", i%2 == 0), templ.KV("rotate-[1.5deg]", i%2 == 1) }>
				<img src={ s.PhotoURL } alt={ s.Title } loading="lazy" decoding="async" class="lv-photo aspect-[4/3] w-full object-cover"/>
			</div>
		}
	</li>
}

// Events: 05 Wedding Event — satu kartu cetak berbingkai tipis per acara, baris
// info tiga kolom seperti undangan fisik.
templ Events(v view.View) {
	if len(v.Events) > 0 {
		<section id="events" class="px-6 py-20">
			@base.Title(v, "Acara", base.EventsSubtitle(v))
			<div class="grid gap-8">
				for _, e := range v.Events {
					<article class="relative bg-paper px-5 py-10 text-center">
						@frameLines("inset-1.5")
						<div class="relative">
							<p class={ "text-muted", eyebrow }>{ e.TypeLabel }</p>
							<h3 class="mt-3 break-words text-3xl leading-tight text-deep">{ e.Name }</h3>
							@divider("mt-5")
							<div class="mt-6">
								@infoRow(e.DateText, e.TimeText, e.Venue)
							</div>
							if e.Address != "" {
								<p class="mt-5 text-sm leading-relaxed text-muted">{ e.Address }</p>
							}
							if e.Description != "" {
								<p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-muted">{ e.Description }</p>
							}
							if e.MapsURL != "" || e.CalendarURL != "" {
								<div class="mt-6 flex flex-wrap justify-center gap-2">
									if e.MapsURL != "" {
										<a href={ templ.SafeURL(e.MapsURL) } target="_blank" rel="noopener" class="lv-btn lv-btn-sm">Buka Peta</a>
									}
									if e.CalendarURL != "" {
										<a href={ templ.SafeURL(e.CalendarURL) } class="lv-btn-outline lv-btn-sm">Simpan ke Kalender</a>
									}
								</div>
							}
						</div>
					</article>
				}
			</div>
		</section>
	}
}

// galleryBlock: satu blok album; tiap sel memegang satu foto. Foto mengisi selnya
// (absolute), jadi ukuran sel hanya ditentukan kelas blok & sel.
type galleryBlock struct {
	Class string
	Cells []galleryCell
}

type galleryCell struct {
	Photo view.Photo
	Index int // urutan asli, untuk label aksesibilitas
	Class string
}

func isPortrait(p view.Photo) bool { return p.Height > p.Width }

// galleryBlocks menyusun album editorial: blok utama (satu foto besar + dua
// pendamping), lalu kolase berselang dengan rasio berbeda. Foto pertama selalu
// foto utama; di kolase, foto lanskap ditaruh di slot lebar dan potret di slot
// tegak supaya wajah tidak terpotong. Sisa 1–2 foto menutup album tanpa lubang.
func galleryBlocks(photos []view.Photo) []galleryBlock {
	if len(photos) == 0 {
		return nil
	}
	n := min(3, len(photos))
	blocks := []galleryBlock{galleryLead(photos[:n])}
	for i, round := n, 0; i < len(photos); i, round = i+3, round+1 {
		end := min(i+3, len(photos))
		blocks = append(blocks, galleryCollage(photos[i:end], i, round))
	}
	return blocks
}

func galleryLead(ps []view.Photo) galleryBlock {
	portrait := isPortrait(ps[0])
	switch len(ps) {
	case 1:
		if portrait {
			return galleryBlock{"mx-auto max-w-md", []galleryCell{{ps[0], 0, "aspect-[4/5]"}}}
		}
		return galleryBlock{"", []galleryCell{{ps[0], 0, "aspect-[3/2]"}}}
	case 2:
		return galleryBlock{"grid aspect-[9/4] grid-cols-[2fr_1fr]", []galleryCell{{ps[0], 0, ""}, {ps[1], 1, ""}}}
	}
	if portrait {
		return galleryBlock{"grid grid-cols-2", []galleryCell{
			{ps[0], 0, "col-span-2 aspect-[4/5]"},
			{ps[1], 1, "aspect-square"},
			{ps[2], 2, "aspect-square"},
		}}
	}
	return galleryBlock{"grid grid-cols-2", []galleryCell{
		{ps[0], 0, "col-span-2 aspect-[3/2]"},
		{ps[1], 1, "aspect-square"},
		{ps[2], 2, "aspect-square"},
	}}
}

// galleryCollage: 1–3 foto mulai dari indeks asli offset. round mengganti posisi
// slot lebar supaya kolase berikutnya tidak mengulang bentuk yang sama.
func galleryCollage(ps []view.Photo, offset, round int) galleryBlock {
	cell := func(i int, class string) galleryCell { return galleryCell{ps[i], offset + i, class} }
	switch len(ps) {
	case 1:
		if isPortrait(ps[0]) {
			return galleryBlock{"mx-auto max-w-md", []galleryCell{cell(0, "aspect-[4/5]")}}
		}
		return galleryBlock{"", []galleryCell{cell(0, "aspect-[3/2]")}}
	case 2:
		switch {
		case isPortrait(ps[0]) && isPortrait(ps[1]):
			return galleryBlock{"grid aspect-[3/2] grid-cols-2", []galleryCell{cell(0, ""), cell(1, "")}}
		case isPortrait(ps[0]):
			return galleryBlock{"grid aspect-[9/4] grid-cols-[1fr_2fr]", []galleryCell{cell(0, ""), cell(1, "")}}
		}
		return galleryBlock{"grid aspect-[9/4] grid-cols-[2fr_1fr]", []galleryCell{cell(0, ""), cell(1, "")}}
	}
	// Foto paling lanskap menempati slot lebar; bila semua potret, tiga kolom sama.
	wide, ratio := -1, 1.0
	for i, p := range ps {
		if p.Height == 0 {
			if wide < 0 {
				wide = i
			}
			continue
		}
		if r := float64(p.Width) / float64(p.Height); r > ratio {
			wide, ratio = i, r
		}
	}
	const narrow = "aspect-[3/4]"
	if wide < 0 {
		return galleryBlock{"grid grid-cols-3 aspect-[9/4]", []galleryCell{cell(0, ""), cell(1, ""), cell(2, "")}}
	}
	var rest []galleryCell
	for i := range ps {
		if i != wide {
			rest = append(rest, cell(i, narrow))
		}
	}
	w := cell(wide, "col-span-2 aspect-[3/2]")
	if round%2 == 0 {
		return galleryBlock{"grid grid-flow-dense grid-cols-2", []galleryCell{rest[0], w, rest[1]}}
	}
	return galleryBlock{"grid grid-cols-2", []galleryCell{w, rest[0], rest[1]}}
}

// gallerySrcset: thumbnail untuk slot kecil, foto penuh untuk slot besar. Tanpa
// ukuran asli (Width 0) cukup thumbnail, sama seperti sebelumnya.
func gallerySrcset(p view.Photo) string {
	if p.Width <= 480 || p.URL == p.ThumbURL {
		return ""
	}
	return fmt.Sprintf("%s 480w, %s %dw", p.ThumbURL, p.URL, p.Width)
}

// gallerySizes: lebar tampil sel untuk pemilihan srcset.
func gallerySizes(c galleryCell) string {
	if c.Index == 0 || strings.Contains(c.Class, "col-span-2") || strings.Contains(c.Class, "aspect-[3/2]") {
		return "(min-width: 768px) 30rem, 100vw"
	}
	return "(min-width: 768px) 15rem, 50vw"
}

// Gallery: 06 — album editorial: foto utama, pendamping, lalu kolase berselang,
// dengan sudut & jarak yang sama di semua foto.
templ Gallery(v view.View) {
	if len(v.Gallery) > 0 {
		<section id="gallery" class="px-4 py-20">
			@base.Title(v, "Galeri", "")
			<div class="mx-auto max-w-5xl space-y-2">
				for _, b := range galleryBlocks(v.Gallery) {
					<div class={ "gap-2", b.Class }>
						for _, c := range b.Cells {
							<a
								href={ templ.SafeURL(c.Photo.URL) }
								data-lightbox
								if c.Photo.Caption != "" {
									data-caption={ c.Photo.Caption }
								}
								aria-label={ base.PhotoLabel(c.Photo, c.Index) }
								class={ "lv-photo relative block overflow-hidden", c.Class }
							>
								<img
									src={ c.Photo.ThumbURL }
									if gallerySrcset(c.Photo) != "" {
										srcset={ gallerySrcset(c.Photo) }
										sizes={ gallerySizes(c) }
									}
									alt={ c.Photo.Caption }
									loading="lazy"
									decoding="async"
									class="absolute inset-0 h-full w-full object-cover"
								/>
							</a>
						}
					</div>
				}
			</div>
		</section>
	}
}

// Checkin: 08 Guest Pass — kartu akses bergaya tiket. QR selalu fungsional: tanpa
// QR pribadi hanya tampil info (link umum) atau contoh kartu (preview dashboard).
templ Checkin(v view.View) {
	if g := v.CheckinGuest(); v.Checkin.QRURL != "" && g != nil {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "QR Kehadiran", "Kartu akses pribadi Anda untuk hari bahagia kami.")
			@guestPass(v) {
				@qrFrame() {
					<img src={ v.Checkin.QRURL } alt={ "Kode QR kehadiran untuk " + g.Name } width="512" height="512" loading="lazy" decoding="async" class="block h-auto w-full [image-rendering:pixelated]"/>
				}
				@passHolder(g)
				<ol class="mt-6 space-y-3 border-t border-secondary/40 pt-5 text-left text-sm leading-relaxed">
					@passStep("1", "Tunjukkan QR ini kepada penerima tamu di pintu masuk.")
					@passStep("2", "Penerima tamu memindai QR dan mencatat kehadiran Anda.")
					@passStep("3", "Simpan gambarnya supaya tetap bisa ditunjukkan tanpa sinyal.")
				</ol>
				<a href={ templ.SafeURL(v.Checkin.QRURL) } download={ "qr-kehadiran-" + g.Code + ".png" } class="lv-btn-outline lv-btn-sm mt-6">Simpan QR</a>
			}
		</section>
	} else if v.Checkin.Sample && v.Guest != nil {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "QR Kehadiran", "Contoh kartu tamu. Tiap tamu mendapat QR pribadi di undangannya.")
			@guestPass(v) {
				@qrFrame() {
					<div class="flex aspect-square w-full items-center justify-center p-6 text-center text-sm text-muted">Contoh — QR pribadi tamu tampil di sini</div>
				}
				@passHolder(v.Guest)
			}
		</section>
	} else if v.Checkin.Available {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "Kehadiran", "")
			<p class="mx-auto max-w-sm text-center text-sm leading-relaxed">QR kehadiran pribadi Anda tersedia di link undangan yang kami kirimkan. Tunjukkan QR tersebut kepada penerima tamu di pintu masuk.</p>
		</section>
	}
}

// guestPass: kartu akses — kepala berisi identitas acara, garis sobek bertakik
// seperti tiket, lalu badan kartu berisi QR & petunjuk (children).
templ guestPass(v view.View) {
	<div class="lv-paper relative mx-auto max-w-sm overflow-hidden rounded-lg shadow-xl shadow-black/10">
		@frameLines("inset-2")
		@art(v, "rose", "absolute right-[-5%] top-[-3%] w-[28%] rotate-[18deg]", false)
		@art(v, "petal-b", "absolute bottom-5 left-5 w-5 rotate-12", false)
		<div class="relative px-7 pb-6 pt-9 text-center">
			@monogram(v, "h-12 w-12 text-base")
			<p class="mt-4 text-xs uppercase tracking-[0.28em] text-primary">Wedding Guest Pass</p>
			<p class="mt-3 break-words text-3xl leading-tight text-deep" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
			<p class="mt-3 text-sm">{ v.DateText }</p>
			if len(v.Events) > 0 {
				<p class="mt-1 break-words text-sm text-muted">{ v.Events[0].Venue }</p>
			}
		</div>
		<div class="relative h-6" aria-hidden="true">
			<span class="absolute inset-x-6 top-1/2 border-t border-dashed border-secondary/70"></span>
			<span class="absolute -left-3 top-0 h-6 w-6 rounded-full border border-secondary/50 bg-surface"></span>
			<span class="absolute -right-3 top-0 h-6 w-6 rounded-full border border-secondary/50 bg-surface"></span>
		</div>
		<div class="relative px-7 pb-10 pt-5 text-center">
			{ children... }
		</div>
	</div>
}

// qrFrame: area putih kontras tinggi dengan siku pemindai di keempat sudut. Siku
// berada di luar area putih supaya tidak mengganggu zona tenang QR.
templ qrFrame() {
	<div class="relative mx-auto w-full max-w-[14rem] p-2.5">
		<span class="absolute left-0 top-0 h-5 w-5 border-l-2 border-t-2 border-primary" aria-hidden="true"></span>
		<span class="absolute right-0 top-0 h-5 w-5 border-r-2 border-t-2 border-primary" aria-hidden="true"></span>
		<span class="absolute bottom-0 left-0 h-5 w-5 border-b-2 border-l-2 border-primary" aria-hidden="true"></span>
		<span class="absolute bottom-0 right-0 h-5 w-5 border-b-2 border-r-2 border-primary" aria-hidden="true"></span>
		<div class="bg-white p-2">
			{ children... }
		</div>
	</div>
}

// passHolder: pemegang kartu. Kode undangan juga dipakai penerima tamu untuk
// mencari manual bila QR tidak terbaca.
templ passHolder(g *view.Guest) {
	<p class={ "mt-5 text-muted", eyebrow }>Tamu undangan</p>
	<p class="mt-1 break-words text-xl leading-snug text-deep" style="font-family: var(--lv-font-heading)">{ g.Name }</p>
	<p class="mt-1 text-sm">Berlaku untuk { shared.CheckinPax(g) } orang</p>
	if g.Code != "" {
		<p class="mt-1 text-sm text-muted">Kode <span class="font-bold tracking-[0.15em] text-deep">{ g.Code }</span></p>
	}
}

templ passStep(number, text string) {
	<li class="flex gap-3">
		<span class="flex h-6 w-6 flex-none items-center justify-center rounded-full border border-secondary text-xs text-primary" aria-hidden="true">{ number }</span>
		<span>{ text }</span>
	</li>
}

// Gift: 09 Wedding Gift — latar lembut, kartu minimal. Judul memakai warna gelap
// supaya kontras di atas latar Soft semua preset.
templ Gift(v view.View) {
	if len(v.Gifts) > 0 {
		<section id="gift" class="bg-soft pb-20 [&_h2+div+p]:text-ink">
			@ribbonBand(v, "ribbon2")
			<div class="px-6 pt-10">
				@base.Title(v, "Tanda Kasih", "Doa restu Anda sudah lebih dari cukup. Namun bila ingin memberi tanda kasih, dapat melalui:")
				<div class="mx-auto grid max-w-3xl gap-4">
					for _, gf := range v.Gifts {
						<div class="lv-card p-6 text-center">
							<div class="flex justify-center">
								@icon(iconBank)
							</div>
							if gf.Type == "address" {
								<p class="mt-3 text-xs font-medium uppercase tracking-wide text-primary">Kirim hadiah</p>
								if gf.AccountName != "" {
									<p class="mt-2 font-semibold">{ gf.AccountName }</p>
								}
								<p class="mt-1 whitespace-pre-line break-words text-sm">{ gf.Address }</p>
								<button type="button" hidden data-copy={ gf.Address } class="lv-btn-outline lv-btn-sm mt-4">Salin Alamat</button>
							} else {
								<p class="mt-3 text-xs font-medium uppercase tracking-wide text-primary">{ gf.Provider }</p>
								<p class="mt-2 select-all break-words text-xl tracking-wider text-deep">{ gf.AccountNumber }</p>
								<p class="mt-1 text-sm">a.n. { gf.AccountName }</p>
								<button type="button" hidden data-copy={ gf.AccountNumber } class="lv-btn lv-btn-sm mt-4">Salin Nomor</button>
							}
						</div>
					}
				</div>
			</div>
		</section>
	}
}

// Closing: 10 — ucapan terima kasih, nama, tanggal di atas pita & bunga; branding
// Lunovia halus.
templ Closing(v view.View) {
	<section id="closing" class="lv-paper relative overflow-hidden px-8 pb-72 pt-24 text-center">
		@frameLines("inset-3")
		@art(v, "ribbon-left", "absolute bottom-0 left-0 w-[56%] max-w-[480px]", false)
		@art(v, "corner", "absolute bottom-0 right-0 w-[50%] max-w-[420px]", false)
		@art(v, "petal-b", "absolute left-[10%] top-14 w-7 rotate-12", false)
		<div class="relative">
			<p class="mx-auto max-w-xs whitespace-pre-line text-sm leading-relaxed">{ base.ClosingText(v, "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.", "Terima kasih atas doa dan restu yang telah Bapak/Ibu/Saudara/i berikan untuk kami.") }</p>
			<p class="lv-display mt-10 text-2xl italic text-primary">With love,</p>
			<p class="mt-3 break-words text-5xl font-medium leading-tight text-deep" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
			@divider("mt-8")
			<p class="mt-6 text-sm tracking-wide">{ v.DateText }</p>
			@base.Credit(v, "mt-10 text-xs text-muted", "Dibuat dengan Lunovia")
		</div>
	</section>
}
