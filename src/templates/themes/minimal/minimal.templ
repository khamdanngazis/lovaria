// Package minimal: tema bersih — putih lega, huruf kapital berjarak, rata kiri.
package minimal

import (
	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

templ Hero(v view.View) {
	<section id="opening" class="flex min-h-dvh flex-col justify-between px-8 py-12">
		<p class="text-[11px] uppercase tracking-[0.4em] opacity-60">The Wedding of</p>
		<div>
			<h1 class="text-5xl font-semibold uppercase leading-none tracking-tight">{ v.Couple.GroomName }</h1>
			<p class="my-3 text-sm uppercase tracking-[0.4em] text-primary">and</p>
			<h1 class="text-5xl font-semibold uppercase leading-none tracking-tight">{ v.Couple.BrideName }</h1>
			<p class="mt-6 text-sm">{ v.DateText }</p>
		</div>
		if base.CoverOf(v) != "" {
			<img src={ base.CoverOf(v) } alt="" class="my-8 aspect-[4/3] w-full object-cover grayscale-[20%]"/>
		}
		<div class="flex items-end justify-between gap-4 border-t border-current/20 pt-6">
			<div>
				<p class="text-[11px] uppercase tracking-[0.3em] opacity-60">Untuk</p>
				<p class="mt-1 font-semibold">{ base.GuestName(v) }</p>
			</div>
			<a href="#couple" class="bg-ink px-5 py-3 text-xs uppercase tracking-[0.25em] text-surface" style="background: var(--lv-ink)">Buka</a>
		</div>
	</section>
}

templ Couple(v view.View) {
	<section id="couple" class="px-8 py-20">
		<p class="text-[11px] uppercase tracking-[0.4em] text-primary">Mempelai</p>
		@person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc)
		@person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc)
		<div class="mt-16 border-l-2 border-primary pl-5">
			<p class="text-[11px] uppercase tracking-[0.4em] opacity-60">Tanggal</p>
			<p class="mt-2 text-2xl font-semibold">{ v.DateText }</p>
			if v.Description != "" {
				<p class="mt-3 whitespace-pre-line text-sm opacity-80">{ v.Description }</p>
			}
		</div>
	</section>
}

templ person(name, photo, desc string) {
	<div class="mt-10 grid grid-cols-[6rem_1fr] items-center gap-5">
		if photo != "" {
			<img src={ photo } alt={ name } loading="lazy" class="aspect-square w-24 object-cover"/>
		} else {
			<div class="aspect-square w-24 bg-primary/10"></div>
		}
		<div>
			<h3 class="text-2xl font-semibold">{ name }</h3>
			if desc != "" {
				<p class="mt-1 whitespace-pre-line text-sm opacity-70">{ desc }</p>
			}
		</div>
	</div>
}

templ Closing(v view.View) {
	<section id="closing" class="px-8 py-24">
		<p class="text-sm opacity-70">Terima kasih atas doa dan kehadiran Anda.</p>
		<p class="mt-6 text-3xl font-semibold uppercase tracking-tight">{ v.Couple.Names() }</p>
		<p class="mt-20 text-[11px] uppercase tracking-[0.3em] opacity-40">Lovoria</p>
	</section>
}
