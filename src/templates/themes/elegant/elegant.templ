// Package elegant: tema klasik — emas, serif, bingkai garis tipis & ornamen.
package elegant

import (
	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

templ ornament() {
	<svg class="mx-auto my-4 h-4 w-40 text-primary" viewBox="0 0 160 16" fill="none" stroke="currentColor" aria-hidden="true">
		<path d="M0 8h64M96 8h64" stroke-width="1"></path>
		<path d="M80 2l6 6-6 6-6-6z" stroke-width="1.2"></path>
	</svg>
}

templ Hero(v view.View) {
	<section id="opening" class="relative flex min-h-dvh items-center justify-center overflow-hidden p-6 text-center">
		if base.CoverOf(v) != "" {
			<img src={ base.CoverOf(v) } alt="" class="absolute inset-0 h-full w-full object-cover"/>
			<div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-black/70"></div>
		}
		<div class={ "relative w-full border px-6 py-14", templ.KV("border-white/60 text-white", base.CoverOf(v) != ""), templ.KV("border-primary/50", base.CoverOf(v) == "") }>
			<p class="text-[11px] uppercase tracking-[0.4em]">The Wedding of</p>
			@ornament()
			<h1 class="text-5xl leading-tight">{ v.Couple.GroomName }</h1>
			<p class="my-2 text-3xl italic" style="font-family: var(--lv-font-heading)">&amp;</p>
			<h1 class="text-5xl leading-tight">{ v.Couple.BrideName }</h1>
			@ornament()
			<p class="text-sm tracking-widest">{ v.DateText }</p>
			<p class="mt-10 text-xs uppercase tracking-[0.3em] opacity-80">Kepada Yth.</p>
			<p class="mt-2 text-xl" style="font-family: var(--lv-font-heading)">{ base.GuestName(v) }</p>
			<a href="#couple" class="mt-8 inline-block border border-current px-8 py-3 text-xs uppercase tracking-[0.3em]">Buka Undangan</a>
		</div>
	</section>
}

templ Couple(v view.View) {
	<section id="couple" class="px-6 py-20 text-center">
		<p class="text-xs uppercase tracking-[0.35em] text-primary">Bismillah</p>
		<p class="mx-auto mt-4 max-w-xs text-sm italic opacity-80">Dengan memohon rahmat dan ridho Tuhan, kami bermaksud menyelenggarakan pernikahan putra-putri kami</p>
		@ornament()
		@person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc)
		<p class="my-8 text-5xl text-primary" style="font-family: var(--lv-font-heading)">&amp;</p>
		@person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc)
		<div class="mt-14 border-y border-primary/40 py-8">
			<p class="text-xs uppercase tracking-[0.35em] text-primary">Save the Date</p>
			<p class="mt-3 text-2xl" style="font-family: var(--lv-font-heading)">{ v.DateText }</p>
			if v.Description != "" {
				<p class="mt-3 whitespace-pre-line text-sm opacity-80">{ v.Description }</p>
			}
		</div>
	</section>
}

templ person(name, photo, desc string) {
	<div>
		if photo != "" {
			<div class="mx-auto w-44 border border-primary/50 p-2">
				<img src={ photo } alt={ name } loading="lazy" class="aspect-[3/4] w-full object-cover"/>
			</div>
		}
		<h3 class="mt-5 text-3xl">{ name }</h3>
		if desc != "" {
			<p class="mx-auto mt-2 max-w-xs whitespace-pre-line text-sm opacity-80">{ desc }</p>
		}
	</div>
}

templ Events(v view.View) {
	if len(v.Events) > 0 {
		<section id="events" class="bg-primary/5 px-6 py-20">
			@base.SectionTitle("Rangkaian Acara", "")
			<div class="space-y-6">
				for _, e := range v.Events {
					@base.EventCard(e, "border border-primary/40 bg-surface p-8 text-center")
				}
			</div>
		</section>
	}
}
