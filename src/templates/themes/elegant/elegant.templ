// Package elegant: tema Elegan (T21) — klasik formal: bingkai ganda dengan
// ornamen sudut, semua rata tengah, foto dan kartu acara berbingkai
// (Cormorant Garamond + Lato).
package elegant

import (
	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

const eyebrow = "text-[11px] uppercase tracking-[0.35em]"

// matted: bingkai foto ala pigura — garis tipis dengan jarak ke foto.
const matted = "border border-accent/70 p-1.5"

// Hero: sampul berbingkai ganda di atas latar gading. Foto sampul tampil
// sebagai pigura di tengah yang mengisi sisa tinggi (menyusut di layar
// pendek); tanpa foto, monogram menggantikannya.
templ Hero(v view.View) {
	{{ groom, bride := base.FirstNames(v) }}
	<section id="opening" class="relative flex min-h-dvh flex-col px-9 py-10 text-center">
		@frame()
		<div class="lv-cover-body relative flex flex-1 flex-col items-center">
			<p class={ "text-muted", eyebrow }>The Wedding of</p>
			<h1 class="mt-4 break-words text-6xl leading-[1.05]">
				{ groom }
				<span class="block text-3xl italic text-primary">&amp;</span>
				{ bride }
			</h1>
			@flourish("mt-5")
			if base.CoverOf(v) != "" {
				// Desktop: foto ada di panel kiri → monogram menggantikannya.
				<div class={ "relative mt-5 min-h-28 w-full max-w-64 flex-1 lg:hidden", matted }>
					<div class="absolute inset-1.5 overflow-hidden">
						@base.CoverImage(v, "absolute inset-0 h-full w-full object-cover")
					</div>
				</div>
				<div class="my-auto hidden py-6 lg:block">
					@base.Monogram(v, "h-20 w-20 text-2xl")
				</div>
			} else {
				<div class="my-auto py-6">
					@base.Monogram(v, "h-20 w-20 text-2xl")
				</div>
			}
			<p class="mt-5 text-sm tracking-[0.2em]">{ v.DateText }</p>
			<p class={ "mt-6 text-muted", eyebrow }>{ base.GreetingText(v, "Kepada Yth.") }</p>
			<p class="mt-1 break-words text-2xl" style="font-family: var(--lv-font-heading)">{ base.GuestName(v) }</p>
			@base.OpenButton(v, "lv-btn mt-5 uppercase tracking-[0.25em]", "Buka Undangan", "Lihat Kenangan")
		</div>
	</section>
}

// SectionTitle: judul serif rata tengah di atas ornamen garis.
templ SectionTitle(title, subtitle string) {
	<div class="mb-10 text-center">
		<h2 class="text-4xl leading-tight">{ title }</h2>
		@flourish("mt-3")
		if subtitle != "" {
			<p class="mx-auto mt-4 max-w-xs text-sm italic leading-relaxed opacity-80">{ subtitle }</p>
		}
	</div>
}

templ Couple(v view.View) {
	<section id="couple" class="px-6 py-20 text-center">
		@base.Title(v, "Mempelai", "Dengan memohon rahmat dan ridho Tuhan, kami bermaksud menyelenggarakan pernikahan putra-putri kami")
		@person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc)
		<p class="my-7 text-5xl italic text-primary" style="font-family: var(--lv-font-heading)" aria-hidden="true">&amp;</p>
		@person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc)
		<div class="relative mt-16 px-6 py-12">
			@frame()
			<p class={ "relative text-muted", eyebrow }>Save the Date</p>
			<p class="relative mt-3 text-3xl" style="font-family: var(--lv-font-heading)">{ v.DateText }</p>
			if v.Description != "" {
				<p class="relative mx-auto mt-3 max-w-xs whitespace-pre-line text-sm leading-relaxed text-muted">{ v.Description }</p>
			}
		</div>
	</section>
}

// person: potret 3:4 dalam pigura; tanpa foto → hanya nama & keterangan.
templ person(name, photo, desc string) {
	<div>
		if photo != "" {
			<div class={ "mx-auto w-48", matted }>
				<img src={ photo } alt={ name } loading="lazy" decoding="async" class="aspect-[3/4] w-full object-cover"/>
			</div>
		}
		<h3 class={ "break-words text-4xl leading-tight", templ.KV("mt-5", photo != "") }>{ name }</h3>
		if desc != "" {
			<p class="mx-auto mt-2 max-w-xs whitespace-pre-line text-sm leading-relaxed text-muted">{ desc }</p>
		}
	</div>
}

// LoveStory: bab rata tengah yang dipisah belah ketupat kecil.
templ LoveStory(v view.View) {
	if len(v.Stories) > 0 {
		<section id="story" class="px-6 py-20 text-center">
			@base.Title(v, "Cerita Kami", "")
			<ol>
				for i, s := range v.Stories {
					<li>
						if i > 0 {
							<div class="mx-auto my-8 h-2 w-2 rotate-45 border border-accent" aria-hidden="true"></div>
						}
						<p class={ "text-muted", eyebrow }>{ s.DateText }</p>
						<h3 class="mt-2 break-words text-3xl leading-tight">{ s.Title }</h3>
						if s.PhotoURL != "" {
							<div class={ "mx-auto mt-4 w-4/5", matted }>
								<img src={ s.PhotoURL } alt="" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover"/>
							</div>
						}
						if s.Description != "" {
							<p class="mx-auto mt-3 max-w-xs whitespace-pre-line text-sm leading-relaxed text-muted">{ s.Description }</p>
						}
					</li>
				}
			</ol>
		</section>
	}
}

// Events: kartu berbingkai ganda, rata tengah.
templ Events(v view.View) {
	if len(v.Events) > 0 {
		<section id="events" class="bg-primary/[0.06] px-6 py-20">
			@base.Title(v, "Rangkaian Acara", base.EventsSubtitle(v))
			<div class="space-y-6">
				for _, e := range v.Events {
					<article class="border border-accent/70 bg-surface p-1.5 text-center">
						<div class="border border-accent/40 px-6 py-9">
							<p class={ "text-primary", eyebrow }>{ e.TypeLabel }</p>
							<h3 class="mt-2 break-words text-3xl leading-tight">{ e.Name }</h3>
							<div class="mx-auto my-5 h-px w-12 bg-accent" aria-hidden="true"></div>
							<p class="text-sm font-bold">{ e.DateText }</p>
							<p class="text-sm text-muted">{ e.TimeText }</p>
							<p class="mt-4 text-sm font-bold">{ e.Venue }</p>
							if e.Address != "" {
								<p class="text-sm text-muted">{ e.Address }</p>
							}
							if e.Description != "" {
								<p class="mt-3 whitespace-pre-line text-sm italic leading-relaxed text-muted">{ e.Description }</p>
							}
							if e.MapsURL != "" || e.CalendarURL != "" {
								<div class="mt-6 flex flex-wrap justify-center gap-2">
									if e.MapsURL != "" {
										<a href={ templ.SafeURL(e.MapsURL) } target="_blank" rel="noopener" class="lv-btn lv-btn-sm">Buka Peta</a>
									}
									if e.CalendarURL != "" {
										<a href={ templ.SafeURL(e.CalendarURL) } class="lv-btn-outline lv-btn-sm">Simpan ke Kalender</a>
									}
								</div>
							}
						</div>
					</article>
				}
			</div>
		</section>
	}
}

// Gallery: deretan pigura — foto lebar diselingi pasangan potret.
templ Gallery(v view.View) {
	if len(v.Gallery) > 0 {
		<section id="gallery" class="px-5 py-20">
			@base.Title(v, "Galeri", "")
			<div class="grid grid-cols-2 gap-3">
				for i, p := range v.Gallery {
					<a href={ templ.SafeURL(p.URL) } data-lightbox aria-label={ base.PhotoLabel(p, i) } class={ "block", matted, templ.KV("col-span-2", base.Wide(i, len(v.Gallery))) }>
						<img src={ p.ThumbURL } alt={ p.Caption } loading="lazy" decoding="async" class={ "w-full object-cover", templ.KV("aspect-[3/2]", base.Wide(i, len(v.Gallery))), templ.KV("aspect-[3/4]", !base.Wide(i, len(v.Gallery))) }/>
					</a>
				}
			</div>
		</section>
	}
}

// Closing: penutup gelap berbingkai ganda.
templ Closing(v view.View) {
	<section id="closing" class="relative bg-deep px-10 py-24 text-center text-white">
		@frame()
		<div class="relative">
			@base.Monogram(v, "h-20 w-20 text-2xl")
			<p class="mx-auto mt-8 max-w-xs whitespace-pre-line text-sm italic leading-relaxed opacity-85">{ base.ClosingText(v, "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.", "Terima kasih atas doa dan restu yang telah Bapak/Ibu/Saudara/i berikan untuk kami.") }</p>
			@flourish("mt-8")
			<p class={ "mt-8 opacity-75", eyebrow }>Kami yang berbahagia</p>
			<p class="mt-3 break-words text-5xl leading-tight" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
			<p class="mt-12 text-xs opacity-60">Dibuat dengan Lovoria</p>
		</div>
	</section>
}
