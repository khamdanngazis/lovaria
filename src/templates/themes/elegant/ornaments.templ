package elegant

// Ornamen tema Elegan: SVG inline dekoratif (aria-hidden) yang mengikuti warna
// teks (currentColor) — tanpa berkas gambar tambahan.

// flourish: garis tipis – belah ketupat – garis tipis.
templ flourish(class string) {
	<svg class={ "mx-auto h-4 w-40 text-accent", class } viewBox="0 0 160 16" fill="none" stroke="currentColor" aria-hidden="true">
		<path d="M0 8h60M100 8h60" stroke-width="1"></path>
		<path d="M80 2l6 6-6 6-6-6z" stroke-width="1.2"></path>
		<path d="M66 8l3-3 3 3-3 3zM88 8l3-3 3 3-3 3z" stroke-width="1"></path>
	</svg>
}

// corner: ornamen sudut bingkai (digambar untuk kiri-atas; sudut lain diputar).
templ corner(class string) {
	<svg class={ "absolute h-9 w-9", class } viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
		<path d="M1 35V9a8 8 0 0 1 8-8h26"></path>
		<path d="M7 35V13a6 6 0 0 1 6-6h22"></path>
		<path d="M13 13l5 5-5 5-5-5z" transform="translate(4 -4)"></path>
	</svg>
}

// frame: bingkai ganda dengan ornamen di keempat sudut.
templ frame() {
	<div class="pointer-events-none absolute inset-3 border border-accent/70 text-accent" aria-hidden="true">
		<div class="absolute inset-1.5 border border-accent/40"></div>
		@corner("-left-1 -top-1")
		@corner("-right-1 -top-1 rotate-90")
		@corner("-bottom-1 -right-1 rotate-180")
		@corner("-bottom-1 -left-1 -rotate-90")
	</div>
}
