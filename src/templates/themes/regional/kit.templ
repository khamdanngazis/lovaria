// Package regional: Koleksi Daerah (T28) — tema yang terinspirasi budaya daerah
// Indonesia dengan rasa modern: Javanese Heritage, Sundanese Romance, Minang
// Heritage, Balinese Elegance, Bugis Royal.
//
// Tiap tema punya sampul, ornamen khas (1–2 penanda budaya), bentuk foto, warna,
// dan huruf sendiri (heroes.templ, ornaments.templ). Kerangka bagian lain
// (mempelai, cerita, acara, galeri, penutup) dipakai bersama lewat Kit, sehingga
// tema daerah baru cukup menambah satu Kit + satu sampul.
package regional

import (
	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

const eyebrow = "text-[11px] uppercase tracking-[0.32em]"

// Bentuk foto potret khas tiap daerah.
const (
	shapeOval   = "rounded-[50%]"                                                                                                            // Jawa: medali lonjong ala potret keraton
	shapeCircle = "rounded-full"                                                                                                             // Sunda: bulat lembut
	shapePlain  = "rounded-[var(--lv-radius)]"                                                                                               // Minang: persegi bermahkota gonjong
	shapeGate   = "[clip-path:polygon(50%_0,63%_7%,63%_13%,79%_13%,79%_21%,100%_21%,100%_100%,0_100%,0_21%,21%_21%,21%_13%,37%_13%,37%_7%)]" // Bali: siluet gapura berundak
	shapeHex    = "[clip-path:polygon(50%_0,100%_20%,100%_80%,50%_100%,0_80%,0_20%)]"                                                        // Bugis: segi enam tegak
)

// Kit: gaya satu tema daerah untuk bagian-bagian bersama.
type Kit struct {
	// Divider: ornamen pembatas judul bagian (penanda budaya utama).
	Divider func(class string) templ.Component
	// Band: pita pola khas (batik, songket, …) di tepi bagian & kartu.
	Band func(class string) templ.Component
	// Crown: ornamen di atas foto mempelai & kartu acara (nil = tanpa).
	Crown func(class string) templ.Component
	// Shape & Aspect: bentuk dan rasio foto potret mempelai.
	Shape, Aspect string
	// Title, Name: kelas judul bagian (h2) dan nama (h3).
	Title, Name string
	// Card: kelas kartu acara.
	Card string
	// Tint: latar bagian selang-seling (cerita).
	Tint string
	// Side: mempelai berdampingan (true) atau bersusun di tengah (false).
	Side bool
	// Intro: kalimat pembuka bagian mempelai.
	Intro string
	// Farewell: kalimat penutup bawaan.
	Farewell string
}

// SectionTitle: judul bagian + ornamen khas daerah.
templ (k Kit) SectionTitle(title, subtitle string) {
	<div class="mb-10 text-center">
		<h2 class={ k.Title }>{ title }</h2>
		@k.Divider("mt-3")
		if subtitle != "" {
			<p class="mx-auto mt-4 max-w-xs text-sm leading-relaxed opacity-75">{ subtitle }</p>
		}
	</div>
}

templ (k Kit) Couple(v view.View) {
	<section id="couple" class="px-6 py-20 text-center">
		@base.Title(v, "Mempelai", k.Intro)
		if k.Side {
			<div class="grid grid-cols-2 gap-5">
				@k.person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc, "w-full")
				@k.person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc, "w-full")
			</div>
		} else {
			@k.person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc, "mx-auto w-48")
			<p class="my-6 text-5xl italic text-accent" style="font-family: var(--lv-font-heading)" aria-hidden="true">&amp;</p>
			@k.person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc, "mx-auto w-48")
		}
		<div class="mt-16 overflow-hidden border border-line bg-white/50">
			@k.Band("h-5 text-accent/60")
			<div class="px-6 py-9">
				<p class={ "text-muted", eyebrow }>Save the date</p>
				<p class="mt-3 text-3xl leading-tight" style="font-family: var(--lv-font-heading)">{ v.DateText }</p>
				if v.Description != "" {
					<p class="mx-auto mt-4 max-w-xs whitespace-pre-line text-sm leading-relaxed text-muted">{ v.Description }</p>
				}
			</div>
			@k.Band("h-5 text-accent/60")
		</div>
	</section>
}

// person: potret berbentuk khas daerah; tanpa foto → hanya nama & keterangan.
templ (k Kit) person(name, photo, desc, width string) {
	<div class="min-w-0">
		if photo != "" {
			<div class={ width }>
				if k.Crown != nil {
					@k.Crown("mx-auto mb-1 h-5 w-4/5 text-accent")
				}
				<div class={ "border border-accent/70 p-1.5", k.Shape }>
					<img src={ photo } alt={ name } loading="lazy" decoding="async" class={ "w-full object-cover", k.Aspect, k.Shape }/>
				</div>
			</div>
		}
		<h3 class={ k.Name, templ.KV("mt-4", photo != "") }>{ name }</h3>
		if desc != "" {
			<p class="mx-auto mt-2 max-w-xs whitespace-pre-line text-sm leading-relaxed text-muted">{ desc }</p>
		}
	</div>
}

// LoveStory: linimasa bergaris dengan penanda belah ketupat.
templ (k Kit) LoveStory(v view.View) {
	if len(v.Stories) > 0 {
		<section id="story" class={ "px-6 py-20", k.Tint }>
			@base.Title(v, "Cerita Kami", "")
			<ol class="relative ml-2 space-y-9 border-l border-accent/60 pl-7">
				for _, s := range v.Stories {
					<li class="relative">
						<span class="absolute -left-[2.05rem] top-1.5 h-2.5 w-2.5 rotate-45 border border-accent bg-surface" aria-hidden="true"></span>
						<p class={ "text-muted", eyebrow }>{ s.DateText }</p>
						<h3 class="mt-1.5 break-words text-2xl leading-snug">{ s.Title }</h3>
						if s.PhotoURL != "" {
							<img src={ s.PhotoURL } alt="" loading="lazy" decoding="async" class="lv-photo mt-4 aspect-[4/3] w-full object-cover"/>
						}
						if s.Description != "" {
							<p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-muted">{ s.Description }</p>
						}
					</li>
				}
			</ol>
		</section>
	}
}

// Events: kartu rata tengah dengan pita pola di atasnya.
templ (k Kit) Events(v view.View) {
	if len(v.Events) > 0 {
		<section id="events" class="px-6 py-20">
			@base.Title(v, "Rangkaian Acara", base.EventsSubtitle(v))
			<div class="space-y-7">
				for _, e := range v.Events {
					<div>
						if k.Crown != nil {
							@k.Crown("mx-auto h-7 w-3/5 text-primary")
						}
						<article class={ "overflow-hidden text-center", k.Card }>
							@k.Band("h-4 text-accent/70")
							<div class="px-6 py-8">
								<p class={ "text-primary", eyebrow }>{ e.TypeLabel }</p>
								<h3 class="mt-2 break-words text-3xl leading-tight">{ e.Name }</h3>
								<div class="mx-auto my-5 h-px w-12 bg-accent" aria-hidden="true"></div>
								<p class="text-sm font-semibold">{ e.DateText }</p>
								<p class="text-sm text-muted">{ e.TimeText }</p>
								<p class="mt-4 text-sm font-semibold">{ e.Venue }</p>
								if e.Address != "" {
									<p class="text-sm text-muted">{ e.Address }</p>
								}
								if e.Description != "" {
									<p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-muted">{ e.Description }</p>
								}
								if e.MapsURL != "" || e.CalendarURL != "" {
									<div class="mt-6 flex flex-wrap justify-center gap-2">
										if e.MapsURL != "" {
											<a href={ templ.SafeURL(e.MapsURL) } target="_blank" rel="noopener" class="lv-btn lv-btn-sm">Buka Peta</a>
										}
										if e.CalendarURL != "" {
											<a href={ templ.SafeURL(e.CalendarURL) } class="lv-btn-outline lv-btn-sm">Simpan ke Kalender</a>
										}
									</div>
								}
							</div>
						</article>
					</div>
				}
			</div>
		</section>
	}
}

// Gallery: mozaik di antara dua pita pola.
templ (k Kit) Gallery(v view.View) {
	if len(v.Gallery) > 0 {
		<section id="gallery" class="py-20">
			<div class="px-6">
				@base.Title(v, "Galeri", "")
			</div>
			@k.Band("h-5 text-accent/60")
			<div class="grid grid-cols-2 gap-1.5 px-1.5 py-1.5">
				for i, p := range v.Gallery {
					<a href={ templ.SafeURL(p.URL) } data-lightbox aria-label={ base.PhotoLabel(p, i) } class={ "lv-photo block overflow-hidden", templ.KV("col-span-2", base.Wide(i, len(v.Gallery))) }>
						<img src={ p.ThumbURL } alt={ p.Caption } loading="lazy" decoding="async" class={ "w-full object-cover", templ.KV("aspect-[3/2]", base.Wide(i, len(v.Gallery))), templ.KV("aspect-[3/4]", !base.Wide(i, len(v.Gallery))) }/>
					</a>
				}
			</div>
			@k.Band("h-5 text-accent/60")
		</section>
	}
}

// Closing: penutup gelap berbingkai pita pola, dengan monogram.
templ (k Kit) Closing(v view.View) {
	<section id="closing" class="bg-deep text-center text-white">
		@k.Band("h-6 text-accent/70")
		<div class="px-8 py-20">
			@base.Monogram(v, "h-20 w-20 text-2xl")
			<p class="mx-auto mt-8 max-w-xs whitespace-pre-line text-sm leading-relaxed opacity-85">{ base.ClosingText(v, k.Farewell, "Terima kasih atas doa dan restu yang telah Bapak/Ibu/Saudara/i berikan untuk kami.") }</p>
			@k.Divider("mt-8")
			<p class={ "mt-8 opacity-75", eyebrow }>Kami yang berbahagia</p>
			<p class="mt-3 break-words text-5xl leading-tight" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
			@base.Credit(v, "mt-12 text-xs opacity-60", "Dibuat dengan Lunovia")
		</div>
		@k.Band("h-6 text-accent/70")
	</section>
}

const closingDefault = "Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu."

// Lima tema Koleksi Daerah.
var (
	Jawa = Kit{
		Divider: kawungDivider, Band: kawungBand, Shape: shapeOval, Aspect: "aspect-[3/4]",
		Title: "text-4xl leading-tight", Name: "break-words text-4xl leading-tight",
		Card: "border border-accent/60 bg-surface", Tint: "bg-primary/[0.06]",
		Intro:    "Dengan memohon rahmat dan ridho Tuhan, kami bermaksud menyelenggarakan pernikahan putra-putri kami",
		Farewell: closingDefault,
	}
	Sunda = Kit{
		Divider: leafDivider, Band: hills, Shape: shapeCircle, Aspect: "aspect-square", Side: true,
		Title: "text-5xl leading-tight text-primary", Name: "break-words text-3xl leading-tight text-primary",
		Card: "rounded-[2rem] border border-line bg-white/70", Tint: "bg-primary/[0.07]",
		Intro:    "Dua hati dari tanah Priangan, dipertemukan dalam cinta dan disatukan dalam doa",
		Farewell: closingDefault,
	}
	Minang = Kit{
		Divider: gonjongDivider, Band: songketBand, Crown: gonjong, Shape: shapePlain, Aspect: "aspect-[3/4]",
		Title: "text-3xl uppercase leading-tight tracking-[0.12em]", Name: "break-words text-2xl uppercase leading-snug tracking-[0.08em]",
		Card: "border border-accent bg-surface", Tint: "bg-primary/[0.06]",
		Intro:    "Dengan memohon rahmat Allah SWT serta restu ninik mamak dan keluarga, kami bermaksud menyelenggarakan pernikahan",
		Farewell: closingDefault,
	}
	Bali = Kit{
		Divider: frangipaniDivider, Band: patraBand, Shape: shapeGate, Aspect: "aspect-[3/4]", Side: true,
		Title: "text-4xl leading-tight", Name: "break-words text-2xl leading-snug",
		Card: "border-y-2 border-accent bg-white/60", Tint: "bg-primary/[0.07]",
		Intro:    "Atas asung kertha wara nugraha Ida Sang Hyang Widhi Wasa, kami bermaksud melangsungkan upacara pernikahan",
		Farewell: closingDefault,
	}
	Bugis = Kit{
		Divider: sulapaDivider, Band: sabbeBand, Shape: shapeHex, Aspect: "aspect-[4/5]",
		Title: "text-3xl uppercase leading-tight tracking-[0.14em]", Name: "break-words text-2xl uppercase leading-snug tracking-[0.1em]",
		Card: "border border-accent bg-surface", Tint: "bg-primary/[0.06]",
		Intro:    "Dengan memohon rahmat Allah SWT dan restu kedua keluarga besar, kami bermaksud menyelenggarakan pernikahan",
		Farewell: closingDefault,
	}
)
