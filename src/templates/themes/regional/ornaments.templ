package regional

// Ornamen Koleksi Daerah (T28): SVG inline dekoratif (aria-hidden) yang
// mengikuti warna teks (currentColor). Motif hanya dipakai sebagai pita, bingkai,
// atau detail — tidak memenuhi latar.

// defs: definisi pola (sekali per halaman, dirender di sampul); pita memakainya
// lewat url(#…).
templ defs() {
	<svg class="absolute h-0 w-0" aria-hidden="true" focusable="false">
		<defs>
			// Jawa — batik kawung: empat kelopak lonjong mengelilingi titik.
			<pattern id="rg-kawung" width="24" height="24" patternUnits="userSpaceOnUse">
				<g fill="none" stroke="currentColor" stroke-width="1">
					<ellipse cx="12" cy="5.5" rx="3.2" ry="5"></ellipse>
					<ellipse cx="12" cy="18.5" rx="3.2" ry="5"></ellipse>
					<ellipse cx="5.5" cy="12" rx="5" ry="3.2"></ellipse>
					<ellipse cx="18.5" cy="12" rx="5" ry="3.2"></ellipse>
				</g>
				<circle cx="12" cy="12" r="1.1" fill="currentColor"></circle>
			</pattern>
			// Minang — songket: belah ketupat berantai dengan titik emas.
			<pattern id="rg-songket" width="20" height="20" patternUnits="userSpaceOnUse">
				<path d="M10 1l9 9-9 9-9-9z" fill="none" stroke="currentColor" stroke-width="1"></path>
				<path d="M10 6l4 4-4 4-4-4z" fill="currentColor"></path>
				<circle cx="0" cy="0" r="1.2" fill="currentColor"></circle>
				<circle cx="20" cy="0" r="1.2" fill="currentColor"></circle>
				<circle cx="0" cy="20" r="1.2" fill="currentColor"></circle>
				<circle cx="20" cy="20" r="1.2" fill="currentColor"></circle>
			</pattern>
			// Bali — patra: sulur bergelung berulang.
			<pattern id="rg-patra" width="32" height="20" patternUnits="userSpaceOnUse">
				<path d="M0 16c6 0 8-5 8-8a4 4 0 118 0c0 2-1.5 3-3 3M16 16c6 0 8-5 8-8a4 4 0 118 0c0 2-1.5 3-3 3M0 19h32" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
			</pattern>
			// Bugis — lipa sabbe: kotak-kotak sarung sutra.
			<pattern id="rg-sabbe" width="20" height="20" patternUnits="userSpaceOnUse">
				<path d="M0 4h20M0 16h20M4 0v20M16 0v20" stroke="currentColor" stroke-width="2.2" opacity="0.55"></path>
				<path d="M0 10h20M10 0v20" stroke="currentColor" stroke-width="0.8"></path>
			</pattern>
		</defs>
	</svg>
}

// band: pita pola selebar wadahnya.
templ band(pattern, class string) {
	<svg class={ "block w-full", class } aria-hidden="true" focusable="false">
		<rect width="100%" height="100%" fill={ "url(#" + pattern + ")" }></rect>
	</svg>
}

templ kawungBand(class string) {
	@band("rg-kawung", class)
}

templ songketBand(class string) {
	@band("rg-songket", class)
}

templ patraBand(class string) {
	@band("rg-patra", class)
}

templ sabbeBand(class string) {
	@band("rg-sabbe", class)
}

// hills: lapisan perbukitan Priangan (Sunda).
templ hills(class string) {
	<svg class={ "block w-full", class } viewBox="0 0 400 90" preserveAspectRatio="none" aria-hidden="true" focusable="false">
		<path d="M0 90V52c40-22 70-26 104-8 30 16 52 14 82-10 34-27 62-24 96 2 34 26 70 22 118-14v68z" fill="currentColor" opacity="0.35"></path>
		<path d="M0 90V70c46-20 84-18 122-2 40 17 74 12 110-8 40-22 80-18 168 14v16z" fill="currentColor" opacity="0.6"></path>
	</svg>
}

// rule: garis – ornamen tengah – garis (pembatas judul bagian).
templ rule(class string) {
	<div class={ "flex items-center justify-center gap-3 text-accent", class } aria-hidden="true">
		<span class="h-px w-10 bg-current opacity-70"></span>
		{ children... }
		<span class="h-px w-10 bg-current opacity-70"></span>
	</div>
}

// Jawa: bunga kawung tunggal.
templ kawungDivider(class string) {
	@rule(class) {
		<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
			<ellipse cx="12" cy="5.5" rx="3.2" ry="5"></ellipse>
			<ellipse cx="12" cy="18.5" rx="3.2" ry="5"></ellipse>
			<ellipse cx="5.5" cy="12" rx="5" ry="3.2"></ellipse>
			<ellipse cx="18.5" cy="12" rx="5" ry="3.2"></ellipse>
			<circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
		</svg>
	}
}

// Sunda: pucuk berdaun tiga.
templ leafDivider(class string) {
	@rule(class) {
		<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 22V11"></path>
			<path d="M12 11c-3-1-4.5-4-4-8 3 1 4.5 4 4 8zM12 11c3-1 4.5-4 4-8-3 1-4.5 4-4 8z"></path>
			<path d="M12 17c-3 0-5.5-1.5-7-4.5 3.5-.5 6 1 7 4.500zM12 17c3 0 5.5-1.5 7-4.5-3.5-.5-6 1-7 4.500z"></path>
		</svg>
	}
}

// Minang: gonjong — atap Rumah Gadang dengan ujung melengkung ke atas.
templ gonjong(class string) {
	<svg class={ class } viewBox="0 0 240 70" fill="currentColor" aria-hidden="true" focusable="false">
		<path d="M0 68c24-6 40-26 44-62 5 30 18 46 40 50 10-10 16-24 18-44 3 22 9 36 18 44 9-8 15-22 18-44 2 20 8 34 18 44 22-4 35-20 40-50 4 36 20 56 44 62z"></path>
	</svg>
}

templ gonjongDivider(class string) {
	<div class={ "text-accent", class } aria-hidden="true">
		@gonjong("mx-auto h-6 w-24")
	</div>
}

// Bali: bunga kamboja berkelopak lima.
templ frangipaniDivider(class string) {
	@rule(class) {
		<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
			<path d="M12 12c-2-3-2-7 0-10 2 3 2 7 0 10zM12 12c3-2 7-2 9.5.8-2.7 2.2-6.5 2-9.5-.8zM12 12c3.5 1 5.8 4 5.9 7.8-3.5-.5-5.8-3.6-5.9-7.800zM12 12c-.1 4.2-2.4 7.3-5.9 7.8.1-3.8 2.4-6.8 5.9-7.800zM12 12c-3 2.8-6.8 3-9.5.8C5 10 9 10 12 12z"></path>
			<circle cx="12" cy="12" r="1.3" fill="currentColor"></circle>
		</svg>
	}
}

// Bugis: sulapa eppa — belah ketupat bersusun.
templ sulapaDivider(class string) {
	@rule(class) {
		<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
			<path d="M12 1l11 11-11 11L1 12z"></path>
			<path d="M12 6l6 6-6 6-6-6z"></path>
			<path d="M12 10l2 2-2 2-2-2z" fill="currentColor"></path>
		</svg>
	}
}
