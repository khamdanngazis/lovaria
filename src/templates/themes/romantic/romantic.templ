// Package romantic: tema Romantis (T21) — lembut dan personal: foto melengkung
// (arch), ornamen bunga garis, judul tulisan tangan, linimasa cerita
// berselang-seling (Great Vibes + Lora).
package romantic

import (
	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

const eyebrow = "text-[11px] uppercase tracking-[0.3em]"

// arch: foto berbentuk lengkung dengan garis tepi champagne.
const arch = "rounded-t-full border border-accent p-1.5"

// soft: kartu lembut setengah transparan.
const soft = "rounded-[2rem] bg-white/70 shadow-sm shadow-primary/10"

// Hero: sampul lembut — foto lengkung mengisi sisa tinggi (menyusut di layar
// pendek); tanpa foto, monogram dalam karangan daun.
templ Hero(v view.View) {
	{{ groom, bride := base.FirstNames(v) }}
	<section id="opening" class="relative flex min-h-dvh flex-col overflow-hidden px-7 py-10 text-center">
		@petals()
		<div class="lv-cover-body relative flex flex-1 flex-col items-center">
			if base.CoverOf(v) != "" {
				// Desktop: foto ada di panel kiri → karangan daun menggantikannya.
				<div class={ "relative min-h-44 w-[68%] max-w-60 flex-1 lg:hidden", arch }>
					<div class="absolute inset-1.5 overflow-hidden rounded-t-full">
						@base.CoverImage(v, "absolute inset-0 h-full w-full object-cover")
					</div>
				</div>
				@crest(v, "hidden lg:flex")
			} else {
				@crest(v, "flex")
			}
			<p class={ "mt-6 text-muted", eyebrow }>The Wedding of</p>
			<h1 class="mt-2 break-words text-6xl leading-[1.15] text-primary">{ groom } &amp; { bride }</h1>
			@sprig("mt-2")
			<p class="mt-3 text-sm">{ v.DateText }</p>
			<div class={ "mt-5 w-full px-6 py-4", soft }>
				<p class="text-xs text-muted">{ base.GreetingText(v, "Kepada Yth. Bapak/Ibu/Saudara/i") }</p>
				<p class="mt-1 break-words text-lg font-semibold">{ base.GuestName(v) }</p>
			</div>
			@base.OpenButton(v, "lv-btn mt-5 shadow-lg shadow-primary/25", "Buka Undangan", "Lihat Kenangan")
		</div>
	</section>
}

// crest: monogram di dalam karangan daun.
templ crest(v view.View, class string) {
	<div class={ "relative my-auto h-44 w-44 flex-none items-center justify-center", class }>
		@wreath("absolute inset-0 h-full w-full")
		<div class="relative text-primary">
			@base.Monogram(v, "h-20 w-20 border-transparent text-3xl")
		</div>
	</div>
}

// SectionTitle: judul tulisan tangan di atas ranting bunga.
templ SectionTitle(title, subtitle string) {
	<div class="mb-10 text-center">
		<h2 class="text-5xl leading-tight text-primary">{ title }</h2>
		@sprig("mt-1")
		if subtitle != "" {
			<p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-muted">{ subtitle }</p>
		}
	</div>
}

templ Couple(v view.View) {
	<section id="couple" class="relative overflow-hidden px-6 py-20 text-center">
		@petals()
		<div class="relative">
			@base.Title(v, "Mempelai", "Dua hati yang dipertemukan dalam cinta dan disatukan dalam doa")
			<div class="grid grid-cols-2 gap-4">
				@person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc)
				@person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc)
			</div>
			<div class={ "mt-14 px-6 py-9", soft }>
				<p class="text-4xl text-primary" style="font-family: var(--lv-font-heading)">Save the Date</p>
				<p class="mt-2 font-semibold">{ v.DateText }</p>
				if v.Description != "" {
					<p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-muted">{ v.Description }</p>
				}
			</div>
		</div>
	</section>
}

// person: potret lengkung; tanpa foto → lengkung berisi ranting.
templ person(name, photo, desc string) {
	<div class="min-w-0">
		<div class={ arch }>
			if photo != "" {
				<img src={ photo } alt={ name } loading="lazy" decoding="async" class="aspect-[3/4] w-full rounded-t-full object-cover"/>
			} else {
				<div class="flex aspect-[3/4] w-full items-center justify-center rounded-t-full bg-primary/10" aria-hidden="true">
					@wreath("h-16 w-16")
				</div>
			}
		</div>
		<h3 class="mt-3 break-words text-3xl leading-tight text-primary">{ name }</h3>
		if desc != "" {
			<p class="mt-1 whitespace-pre-line text-xs leading-relaxed text-muted">{ desc }</p>
		}
	</div>
}

// LoveStory: linimasa berselang-seling — foto lengkung di kiri lalu kanan;
// cerita tanpa foto tampil di tengah.
templ LoveStory(v view.View) {
	if len(v.Stories) > 0 {
		<section id="story" class="bg-primary/[0.06] px-6 py-20">
			@base.Title(v, "Cerita Kami", "")
			<ol class="space-y-10">
				for i, s := range v.Stories {
					if s.PhotoURL != "" {
						<li class="grid grid-cols-2 items-center gap-5">
							<div class={ arch, templ.KV("order-2", i%2 == 1) }>
								<img src={ s.PhotoURL } alt="" loading="lazy" decoding="async" class="aspect-[3/4] w-full rounded-t-full object-cover"/>
							</div>
							<div class={ "min-w-0", templ.KV("text-right", i%2 == 1) }>
								@storyText(s)
							</div>
						</li>
					} else {
						<li class="text-center">
							@storyText(s)
						</li>
					}
				}
			</ol>
		</section>
	}
}

templ storyText(s view.Story) {
	<p class={ "text-muted", eyebrow }>{ s.DateText }</p>
	<h3 class="mt-1 break-words text-3xl leading-tight text-primary">{ s.Title }</h3>
	if s.Description != "" {
		<p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-muted">{ s.Description }</p>
	}
}

// Events: kartu lembut membulat, rata tengah.
templ Events(v view.View) {
	if len(v.Events) > 0 {
		<section id="events" class="relative overflow-hidden px-6 py-20">
			@petals()
			<div class="relative">
				@base.Title(v, "Acara", base.EventsSubtitle(v))
				<div class="space-y-5">
					for _, e := range v.Events {
						<article class={ "px-6 py-8 text-center", soft }>
							<p class={ "text-muted", eyebrow }>{ e.TypeLabel }</p>
							<h3 class="mt-1 break-words text-4xl leading-tight text-primary">{ e.Name }</h3>
							<p class="mt-4 text-sm font-semibold">{ e.DateText }</p>
							<p class="text-sm text-muted">{ e.TimeText }</p>
							<p class="mt-3 text-sm font-semibold">{ e.Venue }</p>
							if e.Address != "" {
								<p class="text-sm text-muted">{ e.Address }</p>
							}
							if e.Description != "" {
								<p class="mt-3 whitespace-pre-line text-sm italic leading-relaxed text-muted">{ e.Description }</p>
							}
							if e.MapsURL != "" || e.CalendarURL != "" {
								<div class="mt-5 flex flex-wrap justify-center gap-2">
									if e.MapsURL != "" {
										<a href={ templ.SafeURL(e.MapsURL) } target="_blank" rel="noopener" class="lv-btn lv-btn-sm">Buka Peta</a>
									}
									if e.CalendarURL != "" {
										<a href={ templ.SafeURL(e.CalendarURL) } class="lv-btn-outline lv-btn-sm">Simpan ke Kalender</a>
									}
								</div>
							}
						</article>
					}
				</div>
			</div>
		</section>
	}
}

// Gallery: foto membulat; foto lebar pembuka tiap kelompok berbentuk lengkung.
templ Gallery(v view.View) {
	if len(v.Gallery) > 0 {
		<section id="gallery" class="px-5 py-20">
			@base.Title(v, "Galeri", "")
			<div class="grid grid-cols-2 gap-3">
				for i, p := range v.Gallery {
					<a href={ templ.SafeURL(p.URL) } data-lightbox aria-label={ base.PhotoLabel(p, i) } class={ "block overflow-hidden", templ.KV("col-span-2 rounded-t-[8rem] rounded-b-3xl", base.Wide(i, len(v.Gallery))), templ.KV("rounded-3xl", !base.Wide(i, len(v.Gallery))) }>
						<img src={ p.ThumbURL } alt={ p.Caption } loading="lazy" decoding="async" class={ "w-full object-cover", templ.KV("aspect-[4/3]", base.Wide(i, len(v.Gallery))), templ.KV("aspect-[3/4]", !base.Wide(i, len(v.Gallery))) }/>
					</a>
				}
			</div>
		</section>
	}
}

// Closing: penutup gelap hangat dengan nama tulisan tangan.
templ Closing(v view.View) {
	{{ groom, bride := base.FirstNames(v) }}
	<section id="closing" class="bg-deep px-8 py-24 text-center text-white">
		@sprig("")
		<p class="mx-auto mt-8 max-w-xs whitespace-pre-line text-sm leading-relaxed opacity-85">{ base.ClosingText(v, "Terima kasih telah menjadi bagian dari hari bahagia kami.", "Terima kasih atas doa dan restu yang telah diberikan untuk kami.") }</p>
		<p class={ "mt-10 opacity-75", eyebrow }>Dengan cinta</p>
		<p class="mt-3 break-words text-6xl leading-[1.15]" style="font-family: var(--lv-font-heading)">{ groom } &amp; { bride }</p>
		@base.Credit(v, "mt-12 text-xs opacity-60", "Dibuat dengan ♡ di Lunovia")
	</section>
}
