// Package romantic: tema lembut — merah muda, judul tulisan tangan, foto lengkung.
package romantic

import (
	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

// petals: aksen dekoratif lingkaran lembut (CSS murni).
templ petals() {
	<div aria-hidden="true" class="pointer-events-none absolute -left-16 -top-16 h-48 w-48 rounded-full bg-primary/15 blur-2xl"></div>
	<div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -right-10 h-56 w-56 rounded-full bg-primary/20 blur-3xl"></div>
}

templ Hero(v view.View) {
	<section id="opening" class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-6 py-16 text-center">
		@petals()
		if base.CoverOf(v) != "" {
			<img src={ base.CoverOf(v) } alt="" fetchpriority="low" class="relative h-72 w-56 rounded-t-full object-cover shadow-xl ring-8 ring-white/70"/>
		}
		<p class="relative mt-8 text-xs uppercase tracking-[0.3em] opacity-80">The Wedding of</p>
		<h1 class="relative mt-2 text-6xl leading-tight text-primary">{ v.Couple.Names() }</h1>
		<p class="relative mt-3 text-sm">{ v.DateText }</p>
		<div class="relative mt-8 rounded-2xl bg-white/70 px-6 py-4 shadow-sm">
			<p class="text-xs opacity-80">Kepada Yth. Bapak/Ibu/Saudara/i</p>
			<p class="mt-1 text-lg font-semibold">{ base.GuestName(v) }</p>
		</div>
		<a href="#couple" class="relative mt-6 inline-block rounded-full bg-primary px-8 py-3 text-sm font-medium text-white shadow-lg shadow-primary/30">♡ Buka Undangan</a>
	</section>
}

templ Couple(v view.View) {
	<section id="couple" class="relative overflow-hidden px-6 py-20 text-center">
		@petals()
		<h2 class="relative text-5xl text-primary">Mempelai</h2>
		<p class="relative mx-auto mt-3 max-w-xs text-sm opacity-80">Dua hati yang dipertemukan dalam cinta dan disatukan dalam doa</p>
		<div class="relative mt-10 grid grid-cols-2 gap-4">
			@person(v.Couple.GroomName, v.Couple.GroomPhoto, v.Couple.GroomDesc)
			@person(v.Couple.BrideName, v.Couple.BridePhoto, v.Couple.BrideDesc)
		</div>
		<div class="relative mt-12 rounded-[2rem] bg-white/70 px-6 py-8 shadow-sm">
			<p class="text-4xl text-primary" style="font-family: var(--lv-font-heading)">Save the Date</p>
			<p class="mt-2 font-semibold">{ v.DateText }</p>
			if v.Description != "" {
				<p class="mt-3 whitespace-pre-line text-sm opacity-80">{ v.Description }</p>
			}
		</div>
	</section>
}

templ person(name, photo, desc string) {
	<div>
		if photo != "" {
			<img src={ photo } alt={ name } loading="lazy" class="aspect-[3/4] w-full rounded-t-full object-cover shadow-md"/>
		} else {
			<div class="aspect-[3/4] w-full rounded-t-full bg-primary/15"></div>
		}
		<h3 class="mt-3 text-3xl text-primary">{ name }</h3>
		if desc != "" {
			<p class="mt-1 whitespace-pre-line text-xs opacity-80">{ desc }</p>
		}
	</div>
}

templ Closing(v view.View) {
	<section id="closing" class="relative overflow-hidden px-6 py-24 text-center">
		@petals()
		<p class="relative mx-auto max-w-xs text-sm opacity-80">Terima kasih telah menjadi bagian dari hari bahagia kami</p>
		<p class="relative mt-6 text-6xl text-primary" style="font-family: var(--lv-font-heading)">{ v.Couple.Names() }</p>
		<p class="relative mt-16 text-xs opacity-50">Dibuat dengan ♡ di Lovoria</p>
	</section>
}
