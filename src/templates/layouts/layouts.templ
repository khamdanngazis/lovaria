package layouts

import (
	"fmt"

	"github.com/khamdanngazis/lovaria/src/platform/web"
	"github.com/khamdanngazis/lovaria/static"
)

// htmxConfig: respons 422 (validasi gagal) & 429 (rate limit) tetap di-swap supaya pesan tampil.
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true},{"code":"429","swap":true},{"code":"[45]..","swap":false,"error":true}]}`

// DefaultTheme dipakai bila halaman tidak menentukan tema.
// Pemetaan tema → layout/token nantinya hanya lewat theme registry (modules/theme, T08).
const DefaultTheme = "default"

// Meta berisi metadata halaman untuk <head>.
type Meta struct {
	Title       string
	Description string
	// Theme mengisi atribut data-theme di <html> (dipakai CSS token tema, T08).
	Theme string
	// Cacheable: halaman boleh di-cache bersama (undangan publik) — tanpa token
	// CSRF per pengunjung di HTML. Form di halaman seperti ini wajib memakai
	// proteksi sendiri (mis. token HMAC RSVP, T10).
	Cacheable bool
}

func (m Meta) theme() string {
	if m.Theme == "" {
		return DefaultTheme
	}
	return m.Theme
}

func (m Meta) title() string {
	if m.Title == "" {
		return "Lovoria"
	}
	return m.Title + " · Lovoria"
}

templ base(meta Meta, bodyClass string) {
	@Document(meta, nil, bodyClass) {
		{ children... }
	}
}

// Document adalah kerangka HTML lengkap. head (boleh nil) disisipkan di akhir
// <head> — dipakai tema undangan untuk font, token CSS, dan meta OG.
templ Document(meta Meta, head templ.Component, bodyClass string) {
	<!DOCTYPE html>
	<html lang="id" data-theme={ meta.theme() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.title() }</title>
			if meta.Description != "" {
				<meta name="description" content={ meta.Description }/>
			}
			<meta name="htmx-config" content={ htmxConfig }/>
			if !meta.Cacheable {
				<meta name="csrf-token" content={ web.CSRFToken(ctx) }/>
			}
			<link rel="icon" href={ static.URL("img/favicon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ static.URL("css/app.css") }/>
			<script src={ static.URL("js/htmx.min.js") } defer></script>
			// Halaman undangan (Cacheable) tidak memakai Alpine / komponen dashboard.
			if !meta.Cacheable {
				<script src={ static.URL("js/lovoria.js") } defer></script>
				<script src={ static.URL("js/alpine.min.js") } defer></script>
			}
			if head != nil {
				@head
			}
		</head>
		if meta.Cacheable {
			<body class={ bodyClass }>
				{ children... }
			</body>
		} else {
			<body class={ bodyClass } hx-headers={ web.HXHeaders(ctx) }>
				{ children... }
			</body>
		}
	</html>
}

// BrandFontsURL: huruf brand (Inter untuk UI, Playfair Display untuk judul &
// wordmark) — dipakai landing, auth, dashboard, dan halaman publik Lovoria.
const BrandFontsURL = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"

// BrandFonts memuat huruf brand. blocking=false: preload yang dijadikan
// stylesheet oleh JS halaman (landing.js / lovoria.js, tanpa handler inline —
// CSP); blocking=true untuk halaman tanpa JS tersebut (halaman Cacheable).
templ BrandFonts(blocking bool) {
	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	if blocking {
		<link rel="stylesheet" href={ BrandFontsURL }/>
	} else {
		<link rel="preload" as="style" href={ BrandFontsURL } data-font-css/>
		<noscript><link rel="stylesheet" href={ BrandFontsURL }/></noscript>
	}
	<meta name="theme-color" content="#FAF7F5"/>
}

// BrandBody: kelas <body> halaman Lovoria di luar undangan (warna & huruf brand).
const BrandBody = "min-h-dvh bg-lovoria-bg font-ui text-lovoria-text antialiased"

// Public adalah layout dasar halaman publik Lovoria (error, privasi, syarat,
// undangan tidak ditemukan / diarsipkan) — warna & huruf brand, mobile-first.
templ Public(meta Meta) {
	@Document(meta, BrandFonts(meta.Cacheable), BrandBody) {
		<main class="mx-auto w-full max-w-screen-sm px-4 py-8">
			{ children... }
		</main>
		@LegalLinks("mx-auto max-w-screen-sm px-4 pb-8")
	}
}

// LegalLinks: tautan Kebijakan Privasi & Syarat (footer halaman publik & auth).
templ LegalLinks(class string) {
	<footer class={ "text-center text-xs text-lovoria-muted", class }>
		<a href="/privacy" class="hover:text-lovoria-primary hover:underline">Kebijakan Privasi</a>
		<span aria-hidden="true">·</span>
		<a href="/terms" class="hover:text-lovoria-primary hover:underline">Syarat &amp; Ketentuan</a>
	</footer>
}

// ErrorPage: halaman error bergaya (404, 403, 429, 500, …) untuk semua route.
templ ErrorPage(code int, title, message string) {
	@Public(Meta{Title: title}) {
		<section class="py-20 text-center">
			<a href="/" aria-label="Lovoria — beranda" class="inline-block text-lovoria-primary">
				@BrandLogo("")
			</a>
			<p class="mt-10 font-display text-7xl text-lovoria-primary">{ fmt.Sprint(code) }</p>
			<h1 class="mt-4 font-display text-2xl text-lovoria-deep">{ title }</h1>
			<p class="mx-auto mt-3 max-w-sm text-lovoria-muted">{ message }</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a href="/" class="ui-btn ui-btn-primary">Ke beranda</a>
				if _, ok := web.CurrentUser(ctx); ok {
					<a href="/dashboard" class="ui-btn ui-btn-secondary">Ke dashboard</a>
				}
			</div>
		</section>
	}
}

// Dashboard adalah layout dasar UI couple.
templ Dashboard(meta Meta) {
	@Document(meta, BrandFonts(false), BrandBody) {
		if web.ReadOnly(ctx) {
			// Admin melihat dashboard pasangan (T16): semua perubahan ditolak server.
			<div class="sticky top-0 z-50 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 bg-lovoria-warning px-4 py-2 text-center text-sm font-medium text-white">
				<span>Mode admin — lihat saja. Perubahan tidak bisa disimpan.</span>
				<form method="post" action="/admin/view/stop">
					@CSRFField()
					<button type="submit" class="rounded-md bg-white px-2.5 py-0.5 text-xs font-medium text-lovoria-warning focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">Keluar</button>
				</form>
			</div>
		}
		<header class="border-b border-lovoria-border bg-lovoria-surface">
			<div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
				<a href="/dashboard" aria-label="Lovoria — dashboard" class="text-lovoria-primary">
					@BrandLogo("[&>span]:text-base")
				</a>
				@accountMenu()
			</div>
		</header>
		<main class="mx-auto w-full max-w-5xl px-4 py-6">
			if web.ReadOnly(ctx) {
				// Semua kontrol form dinonaktifkan; server tetap menolak perubahan (403).
				<fieldset disabled class="lv-readonly m-0 min-w-0 border-0 p-0">
					{ children... }
				</fieldset>
			} else {
				{ children... }
			}
		</main>
	}
}

// accountMenu: navigasi header dashboard. Tautan utama tampil langsung di layar
// lebar; menu akun (tombol hamburger di ponsel, avatar + nama di layar lebar)
// memakai <details> sehingga tetap berfungsi tanpa JS — Alpine hanya menutupnya
// saat klik di luar atau menekan Escape.
templ accountMenu() {
	if u, ok := web.CurrentUser(ctx); ok {
		<nav aria-label="Menu akun" class="flex items-center gap-1 text-sm">
			<a href="/dashboard" class="hidden rounded-lg px-3 py-2 font-medium text-lovoria-muted hover:bg-lovoria-subtle hover:text-lovoria-text sm:block">Beranda</a>
			<a href="/dashboard/weddings" class="hidden rounded-lg px-3 py-2 font-medium text-lovoria-muted hover:bg-lovoria-subtle hover:text-lovoria-text sm:block">Wedding saya</a>
			<details class="group relative" x-data @click.outside="$el.open = false" @keydown.escape.window="$el.open = false">
				<summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg p-1.5 text-lovoria-deep hover:bg-lovoria-subtle focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lovoria-primary sm:py-1 sm:pl-1 sm:pr-2 [&::-webkit-details-marker]:hidden" aria-label="Menu akun">
					// Ponsel: hamburger ↔ tutup. Layar lebar: avatar + nama.
					<span class="sm:hidden">
						@Icon("menu", "h-6 w-6 group-open:hidden")
						@Icon("close", "hidden h-6 w-6 group-open:block")
					</span>
					<span class="hidden h-8 w-8 items-center justify-center rounded-full bg-lovoria-primary-soft font-display text-sm uppercase text-lovoria-primary sm:flex" aria-hidden="true">{ userInitial(u.Name) }</span>
					<span class="hidden max-w-[10rem] truncate font-medium sm:block">{ u.Name }</span>
					@Icon("chevron", "hidden h-4 w-4 text-lovoria-muted transition group-open:rotate-180 sm:block")
				</summary>
				<div class="absolute right-0 top-full z-50 mt-2 w-64 overflow-hidden rounded-2xl border border-lovoria-border bg-lovoria-surface shadow-soft">
					<div class="flex items-center gap-3 border-b border-lovoria-border bg-lovoria-bg px-4 py-3.5">
						<span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-lovoria-primary font-display text-base uppercase text-white" aria-hidden="true">{ userInitial(u.Name) }</span>
						<div class="min-w-0">
							<p class="truncate font-medium text-lovoria-text">{ u.Name }</p>
							<p class="truncate text-xs text-lovoria-muted">{ u.Email }</p>
						</div>
					</div>
					<ul class="p-1.5">
						@menuLink("/dashboard", "home", "Beranda")
						@menuLink("/dashboard/weddings", "heart", "Wedding saya")
						@menuLink("/dashboard/weddings/new", "plus", "Buat wedding baru")
						if u.Role == "admin" {
							@menuLink("/admin", "shield", "Panel admin")
						}
						@menuLink("/", "external", "Halaman utama Lovoria")
					</ul>
					<form method="post" action="/logout" class="border-t border-lovoria-border p-1.5">
						@CSRFField()
						<button type="submit" class="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left font-medium text-lovoria-danger hover:bg-lovoria-danger-soft focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-lovoria-danger">
							@Icon("logout", "h-5 w-5 flex-none")
							Keluar
						</button>
					</form>
				</div>
			</details>
		</nav>
	}
}

templ menuLink(href, icon, label string) {
	<li>
		<a href={ templ.SafeURL(href) } class="flex items-center gap-3 rounded-lg px-3 py-2.5 font-medium text-lovoria-text hover:bg-lovoria-primary-soft hover:text-lovoria-primary focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-lovoria-primary">
			@Icon(icon, "h-5 w-5 flex-none text-lovoria-primary")
			{ label }
		</a>
	</li>
}

// CSRFField adalah input tersembunyi berisi token CSRF untuk form non-htmx.
templ CSRFField() {
	<input type="hidden" name="_csrf" value={ web.CSRFToken(ctx) }/>
}
