package layouts

// uiIcons: ikon garis (viewBox 24, stroke 1.8, ujung membulat) untuk kerangka
// dashboard — digambar sendiri, tanpa library ikon (aturan wajib #7).
var uiIcons = map[string]string{
	"menu":     "M4 7h16M4 12h16M4 17h16",
	"close":    "M6 6l12 12M18 6L6 18",
	"home":     "M3.5 11.2L12 4l8.5 7.2M5.5 9.8V20h13V9.8M10 20v-5.5h4V20",
	"heart":    "M12 20.2s-7.4-4.5-9.1-9.4C1.8 7.6 3.9 4.6 7 4.6c1.9 0 3.5 1 5 2.9 1.5-1.9 3.1-2.9 5-2.9 3.1 0 5.2 3 4.1 6.2-1.7 4.9-9.1 9.4-9.1 9.4z",
	"plus":     "M12 5v14M5 12h14",
	"shield":   "M12 3.2l7.5 2.8v5.6c0 4.4-3 7.9-7.5 9.2-4.5-1.3-7.5-4.8-7.5-9.2V6L12 3.2zM9 12l2.2 2.2L15.2 10",
	"external": "M14 4.5h5.5V10M19.5 4.5l-8 8M10.5 6H6.5a1.5 1.5 0 00-1.5 1.5v10A1.5 1.5 0 006.5 19h10a1.5 1.5 0 001.5-1.5v-4",
	"logout":   "M9.5 4.5h-3A1.5 1.5 0 005 6v12a1.5 1.5 0 001.5 1.5h3M14.5 16l4-4-4-4M18.5 12H9.5",
	"chevron":  "M7 10l5 5 5-5",
}

// Icon: ikon garis dekoratif (aria-hidden); warna mengikuti teks.
templ Icon(name, class string) {
	<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={ class }>
		<path d={ uiIcons[name] }></path>
	</svg>
}

// userInitial: huruf pertama nama pengguna untuk avatar.
func userInitial(name string) string {
	for _, r := range name {
		return string(r)
	}
	return "?"
}
