// Package shared berisi bagian undangan yang sama di semua tema (RSVP, buku
// tamu, hadiah): RSVP (T10), buku ucapan & amplop digital (T11).
package shared

import (
	"fmt"
	"strconv"

	"github.com/khamdanngazis/lovaria/src/modules/theme/view"
	"github.com/khamdanngazis/lovaria/src/templates/themes/base"
)

// RSVPSection: konfirmasi kehadiran (T10). Form POST biasa (tanpa JS) yang
// ditingkatkan htmx: respons berupa section ini lagi (hx-swap outerHTML).
templ RSVPSection(v view.View) {
	if v.AllowRSVP {
		<section id="rsvp" class="px-6 py-20">
			@rsvpTitle(v)
			if v.Guest == nil {
				<p class="lv-photo bg-primary/5 p-6 text-center text-sm">Gunakan link undangan pribadi Anda untuk RSVP.</p>
			} else {
				@rsvpForm(v)
			}
		</section>
	} else if !v.Archived && v.Guest != nil && v.Guest.RSVPStatus != "pending" && v.Guest.RSVPStatus != "" {
		// RSVP ditutup (Kenangan): tampilkan jawaban tamu apa adanya. Arsip
		// tidak memuat data RSVP pribadi (T19).
		<section id="rsvp" class="px-6 py-20">
			@rsvpTitle(v)
			<p class="lv-photo bg-primary/5 p-6 text-center text-sm">{ rsvpSummary(v.Guest) }</p>
		</section>
	}
}

templ rsvpTitle(v view.View) {
	@base.Title(v, "Konfirmasi Kehadiran", "Mohon kabari kami apakah Anda dapat hadir")
}

func rsvpSummary(g *view.Guest) string {
	switch g.RSVPStatus {
	case "attending":
		return fmt.Sprintf("Konfirmasi Anda: Hadir · %d orang", g.RSVPPax)
	case "declined":
		return "Konfirmasi Anda: Tidak dapat hadir"
	}
	return ""
}

// checkinPax: jumlah orang yang tertera di QR kehadiran — jawaban RSVP bila
// tamu sudah konfirmasi hadir, selain itu batas undangan.
func checkinPax(g *view.Guest) string {
	if g.RSVPStatus == "attending" && g.RSVPPax > 0 {
		return strconv.Itoa(g.RSVPPax)
	}
	if g.MaxPax > 0 {
		return strconv.Itoa(g.MaxPax)
	}
	return "1"
}

// rsvpValues: isian form — nilai yang baru dikirim (saat error) atau jawaban tersimpan.
func rsvpValues(v view.View) (status string, pax int, message string) {
	f, g := v.RSVP, v.Guest
	if f.Status != "" {
		return f.Status, f.Pax, f.Message
	}
	status, pax, message = g.RSVPStatus, g.RSVPPax, g.RSVPMessage
	if pax < 1 {
		pax = 1
	}
	return
}

templ rsvpForm(v view.View) {
	{{ status, pax, message := rsvpValues(v) }}
	<div class="lv-card p-5">
		if v.RSVP.Notice != "" {
			<p role="status" class="lv-photo mb-4 bg-primary px-4 py-3 text-center text-sm text-on-primary">{ v.RSVP.Notice }</p>
		} else if s := rsvpSummary(v.Guest); s != "" {
			<p class="mb-4 text-center text-sm">{ s }. Anda masih bisa mengubahnya sampai hari H.</p>
		}
		if v.RSVP.Error != "" {
			<p role="alert" class="lv-photo mb-4 bg-red-50 px-4 py-3 text-center text-sm text-red-700">{ v.RSVP.Error }</p>
		}
		<form
			method="post"
			if v.RSVP.Action != "" {
				action={ templ.SafeURL(v.RSVP.Action) }
				hx-post={ v.RSVP.Action }
				hx-target="#rsvp"
				hx-swap="outerHTML"
				hx-disabled-elt="find button"
			}
			class="group space-y-4"
		>
			<input type="hidden" name="token" value={ v.RSVP.Token }/>
			<fieldset>
				<legend class="mb-2 text-sm font-medium">{ v.Guest.Name }, apakah Anda akan hadir?</legend>
				<div class="grid grid-cols-2 gap-2">
					@rsvpChoice("attending", "Hadir", status)
					@rsvpChoice("declined", "Tidak hadir", status)
				</div>
				@rsvpError(v, "status")
			</fieldset>
			<div class="group-has-[[value=declined]:checked]:hidden">
				<label for="rsvp-pax" class="mb-1 block text-sm font-medium">Jumlah orang</label>
				<select id="rsvp-pax" name="pax" class="lv-input">
					for n := 1; n <= max(1, v.Guest.MaxPax); n++ {
						<option value={ strconv.Itoa(n) } selected?={ n == pax }>{ strconv.Itoa(n) } orang</option>
					}
				</select>
				@rsvpError(v, "pax")
			</div>
			<div>
				<label for="rsvp-message" class="mb-1 block text-sm font-medium">Pesan untuk mempelai <span class="font-normal opacity-70">(opsional)</span></label>
				<textarea id="rsvp-message" name="message" rows="3" maxlength="500" class="lv-input">{ message }</textarea>
				@rsvpError(v, "message")
			</div>
			if v.AllowGuestbook {
				<label class="flex items-start gap-2 text-sm">
					<input type="checkbox" name="to_guestbook" value="1" checked?={ v.RSVP.ToGuestbook } class="mt-0.5 h-4 w-4 accent-primary"/>
					<span>Tampilkan juga pesan ini di buku ucapan</span>
				</label>
			}
			<button
				type="submit"
				disabled?={ v.RSVP.Action == "" }
				class="lv-btn w-full"
			>
				if v.Guest.RSVPStatus == "attending" || v.Guest.RSVPStatus == "declined" {
					Perbarui konfirmasi
				} else {
					Kirim konfirmasi
				}
			</button>
			if v.RSVP.Action == "" {
				<p class="text-center text-xs opacity-70">Form aktif untuk tamu di link undangan pribadi.</p>
			}
		</form>
	</div>
}

templ rsvpChoice(value, label, current string) {
	<label class="lv-input flex cursor-pointer items-center justify-center gap-2 py-3 text-sm has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-on-primary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary has-[:focus-visible]:ring-offset-2">
		<input type="radio" name="status" value={ value } checked?={ current == value } required class="sr-only"/>
		{ label }
	</label>
}

templ rsvpError(v view.View, field string) {
	if msg := v.RSVP.Errors[field]; msg != "" {
		<p class="mt-1 text-sm text-red-700">{ msg }</p>
	}
}

// MemorySection: setelah hari H (Kenangan & Arsip, T19) — foto hari bahagia
// (galeri kategori Pernikahan) dan ucapan favorit pilihan pasangan, tepat
// setelah pembuka.
templ MemorySection(v view.View) {
	if v.ShowsMemory() && (len(v.MemoryPhotos) > 0 || len(v.Guestbook.Favorites) > 0) {
		<section id="memories" class="px-6 py-20">
			@base.Title(v, "Kenangan Hari Bahagia", "Momen yang kami rayakan bersama orang-orang tersayang")
			if len(v.MemoryPhotos) > 0 {
				<div class="grid grid-cols-2 gap-2">
					for i, p := range v.MemoryPhotos {
						<a href={ templ.SafeURL(p.URL) } target="_blank" rel="noopener" class={ "lv-photo block overflow-hidden", templ.KV("col-span-2", i == 0 || (i == len(v.MemoryPhotos)-1 && i%2 == 1)) }>
							<img src={ p.ThumbURL } alt={ memoryAlt(p, i) } loading="lazy" decoding="async" class={ "w-full object-cover", templ.KV("aspect-[4/3]", i == 0), templ.KV("aspect-square", i != 0) }/>
						</a>
					}
				</div>
			}
			if len(v.Guestbook.Favorites) > 0 {
				<h3 class="mb-4 mt-10 text-center text-xl text-primary">Ucapan Pilihan</h3>
				<div class="space-y-3">
					for _, e := range v.Guestbook.Favorites {
						<figure class="lv-card p-5">
							<blockquote class="whitespace-pre-line break-words text-sm italic">“{ e.Message }”</blockquote>
							<figcaption class="mt-3 text-xs opacity-70"><span class="font-semibold not-italic text-primary">{ e.Name }</span> · { e.DateText }</figcaption>
						</figure>
					}
				</div>
			}
		</section>
	}
}

func guestbookSubtitle(v view.View) string {
	if v.AllowGuestbook {
		return "Kirimkan doa dan ucapan untuk kedua mempelai"
	}
	return "Doa dan ucapan dari keluarga & sahabat"
}

func memoryAlt(p view.Photo, i int) string {
	if p.Caption != "" {
		return p.Caption
	}
	return fmt.Sprintf("Foto hari bahagia %d", i+1)
}

// GuestbookSection: ucapan & doa (T11) — form + daftar pesan terbaru dengan
// "Muat lebih banyak". Tetap terbuka saat Kenangan; saat Arsip hanya daftar
// pesan (read-only, T19).
templ GuestbookSection(v view.View) {
	if v.AllowGuestbook || v.Archived {
		{{ g := v.Guestbook }}
		<section id="guestbook" class="px-6 py-20">
			@base.Title(v, "Ucapan & Doa", guestbookSubtitle(v))
			if v.AllowGuestbook {
				<div class="lv-card p-5">
					if g.Notice != "" {
						<p role="status" class="lv-photo mb-4 bg-primary px-4 py-3 text-center text-sm text-on-primary">{ g.Notice }</p>
					}
					if g.Error != "" {
						<p role="alert" class="lv-photo mb-4 bg-red-50 px-4 py-3 text-center text-sm text-red-700">{ g.Error }</p>
					}
					<form
						method="post"
						if g.Action != "" {
							action={ templ.SafeURL(g.Action) }
							hx-post={ g.Action }
							hx-target="#guestbook"
							hx-swap="outerHTML"
							hx-disabled-elt="find button"
						}
						class="space-y-4"
					>
						<input type="hidden" name="token" value={ g.Token }/>
						// Honeypot: manusia tidak melihat kolom ini; bot yang mengisinya ditolak diam-diam.
						<div class="lv-hp" aria-hidden="true">
							<label for="gb-website">Website</label>
							<input id="gb-website" type="text" name="website" tabindex="-1" autocomplete="off"/>
						</div>
						<div>
							<label for="gb-name" class="mb-1 block text-sm font-medium">Nama</label>
							<input id="gb-name" type="text" name="name" value={ g.Name } maxlength="100" required autocomplete="name" class="lv-input"/>
							@fieldError(g.Errors["name"])
						</div>
						<div>
							<label for="gb-message" class="mb-1 block text-sm font-medium">Ucapan</label>
							<textarea id="gb-message" name="message" rows="3" maxlength="500" required class="lv-input">{ g.Message }</textarea>
							@fieldError(g.Errors["message"])
						</div>
						<button type="submit" disabled?={ g.Action == "" } class="lv-btn w-full">Kirim ucapan</button>
					</form>
				</div>
			}
			<div id="guestbook-list" class="mt-6 space-y-3">
				@GuestbookEntries(v)
			</div>
		</section>
	}
}

// GuestbookEntries: potongan daftar pesan + tombol "Muat lebih banyak" (tombol
// diganti potongan berikutnya lewat htmx; tanpa JS berupa link biasa).
templ GuestbookEntries(v view.View) {
	{{ g := v.Guestbook }}
	for _, e := range g.Entries {
		<article class="lv-card p-4">
			<p class="whitespace-pre-line break-words text-sm">{ e.Message }</p>
			<p class="mt-2 text-xs opacity-70"><span class="font-semibold text-primary">{ e.Name }</span> · { e.DateText }</p>
		</article>
	}
	if g.MoreBefore != "" && g.Action != "" {
		{{ more := g.Action + "?before=" + g.MoreBefore }}
		<a href={ templ.SafeURL(more) } hx-get={ more } hx-swap="outerHTML" class="lv-btn-outline block">Muat lebih banyak</a>
	}
}

templ fieldError(msg string) {
	if msg != "" {
		<p class="mt-1 text-sm text-red-700">{ msg }</p>
	}
}

// GiftSection: amplop digital (T11). Disembunyikan bila tidak ada akun.
// Tombol salin dimunculkan invitation.js (tanpa JS nomor tetap bisa diseleksi).
templ GiftSection(v view.View) {
	if len(v.Gifts) > 0 {
		<section id="gift" class="px-6 py-20">
			@base.Title(v, "Tanda Kasih", "Doa restu Anda sudah lebih dari cukup. Namun bila ingin memberi tanda kasih, dapat melalui:")
			<div class="space-y-4">
				for _, gf := range v.Gifts {
					<div class="lv-card p-5 text-center">
						if gf.Type == "address" {
							<p class="text-xs font-medium uppercase tracking-wide text-primary">Kirim hadiah</p>
							if gf.AccountName != "" {
								<p class="mt-2 font-semibold">{ gf.AccountName }</p>
							}
							<p class="mt-1 whitespace-pre-line break-words text-sm">{ gf.Address }</p>
							<button type="button" hidden data-copy={ gf.Address } class="lv-btn-outline lv-btn-sm mt-4">Salin Alamat</button>
						} else {
							<p class="text-xs font-medium uppercase tracking-wide text-primary">{ gf.Provider }</p>
							<p class="mt-2 select-all font-mono text-xl tracking-wider">{ gf.AccountNumber }</p>
							<p class="mt-1 text-sm opacity-80">a.n. { gf.AccountName }</p>
							<button type="button" hidden data-copy={ gf.AccountNumber } class="lv-btn lv-btn-sm mt-4">Salin Nomor</button>
						}
					</div>
				}
			</div>
		</section>
	}
}

// CheckinSection: QR kehadiran tamu (T31) — ditunjukkan di pintu masuk. Hanya
// di link pribadi dan bila pasangan menyalakan check-in. QR selalu di atas
// latar putih supaya terbaca di tema gelap; gambar biasa, tanpa script.
templ CheckinSection(v view.View) {
	if v.Checkin.QRURL != "" && v.Guest != nil {
		<section id="checkin" class="px-6 py-20">
			@base.Title(v, "QR Kehadiran", "Tunjukkan QR ini kepada penerima tamu di pintu masuk.")
			<div class="lv-card mx-auto max-w-xs p-5 text-center">
				<div class="mx-auto w-full max-w-[15rem] rounded-xl bg-white p-2">
					<img src={ v.Checkin.QRURL } alt={ "Kode QR kehadiran untuk " + v.Guest.Name } width="512" height="512" loading="lazy" decoding="async" class="block h-auto w-full [image-rendering:pixelated]"/>
				</div>
				<p class="mt-4 break-words text-lg font-semibold">{ v.Guest.Name }</p>
				<p class="text-sm text-muted">Berlaku untuk { checkinPax(v.Guest) } orang</p>
				<a href={ templ.SafeURL(v.Checkin.QRURL) } download={ "qr-kehadiran-" + v.Guest.Code + ".png" } class="lv-btn-outline lv-btn-sm mt-5 inline-block">Simpan QR</a>
				<p class="mt-3 text-xs text-muted">Simpan gambarnya supaya tetap bisa ditunjukkan tanpa sinyal.</p>
			</div>
		</section>
	}
}
