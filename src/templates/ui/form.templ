// Package ui berisi komponen form dashboard yang dipakai lintas modul.
package ui

// Field mendeskripsikan satu input form.
type Field struct {
	ID           string // id unik di halaman, mis. "wedding-title"
	Name         string
	Label        string
	Type         string // text | email | date | url | password
	Value        string
	Error        string
	Hint         string
	Placeholder  string
	Autocomplete string
	Required     bool
	// Mandatory: tampil sebagai wajib (tanpa label "opsional") tetapi tanpa
	// atribut required — untuk kolom yang wajib hanya pada kondisi tertentu
	// (divalidasi server), supaya kolom yang disembunyikan tidak memblokir submit.
	Mandatory bool
	MaxLength int
	// List: id <datalist> berisi saran isian.
	List string
}

// inputClass: kelas kontrol form bersama (src/styles/app.css, T22).
const inputClass = "ui-input"

templ Input(f Field) {
	<div>
		<label for={ f.ID } class="ui-label">
			{ f.Label }
			if !f.Required && !f.Mandatory {
				<span class="font-normal text-lovoria-muted">(opsional)</span>
			}
		</label>
		<input
			id={ f.ID }
			name={ f.Name }
			type={ f.Type }
			value={ f.Value }
			if f.Placeholder != "" {
				placeholder={ f.Placeholder }
			}
			if f.Autocomplete != "" {
				autocomplete={ f.Autocomplete }
			}
			if f.MaxLength > 0 {
				maxlength={ f.MaxLength }
			}
			if f.List != "" {
				list={ f.List }
			}
			required?={ f.Required }
			if f.Error != "" {
				aria-invalid="true"
			}
			aria-describedby={ f.ID + "-error" }
			class={ inputClass }
		/>
		@hintAndError(f)
	</div>
}

templ TextArea(f Field, rows int) {
	<div>
		<label for={ f.ID } class="ui-label">
			{ f.Label }
			if !f.Required && !f.Mandatory {
				<span class="font-normal text-lovoria-muted">(opsional)</span>
			}
		</label>
		<textarea
			id={ f.ID }
			name={ f.Name }
			rows={ rows }
			if f.Placeholder != "" {
				placeholder={ f.Placeholder }
			}
			if f.MaxLength > 0 {
				maxlength={ f.MaxLength }
			}
			required?={ f.Required }
			if f.Error != "" {
				aria-invalid="true"
			}
			aria-describedby={ f.ID + "-error" }
			class={ inputClass }
		>{ f.Value }</textarea>
		@hintAndError(f)
	</div>
}

// Option adalah pilihan untuk Select.
type Option struct {
	Value string
	Label string
}

templ Select(f Field, options []Option) {
	<div>
		<label for={ f.ID } class="ui-label">
			{ f.Label }
			if !f.Required && !f.Mandatory {
				<span class="font-normal text-lovoria-muted">(opsional)</span>
			}
		</label>
		<select
			id={ f.ID }
			name={ f.Name }
			required?={ f.Required }
			if f.Error != "" {
				aria-invalid="true"
			}
			aria-describedby={ f.ID + "-error" }
			class={ inputClass }
		>
			for _, o := range options {
				<option value={ o.Value } selected?={ o.Value == f.Value }>{ o.Label }</option>
			}
		</select>
		@hintAndError(f)
	</div>
}

templ hintAndError(f Field) {
	if f.Hint != "" && f.Error == "" {
		<p class="ui-hint">{ f.Hint }</p>
	}
	<p id={ f.ID + "-error" } class="ui-error">{ f.Error }</p>
}

// Alert menampilkan pesan error umum form.
templ Alert(msg string) {
	if msg != "" {
		<p class="ui-alert ui-alert-danger" role="alert">{ msg }</p>
	}
}

// Notice menampilkan pesan sukses.
templ Notice(msg string) {
	if msg != "" {
		<p class="ui-alert ui-alert-success" role="status">{ msg }</p>
	}
}

templ PrimaryButton(label string) {
	<button type="submit" class="ui-btn ui-btn-primary w-full sm:w-auto">
		{ label }
	</button>
}

// SecondaryButton adalah tombol submit sekunder dengan name/value (mis. "Kembali").
templ SecondaryButton(label, name, value string) {
	<button type="submit" name={ name } value={ value } formnovalidate class="ui-btn ui-btn-secondary w-full sm:w-auto">
		{ label }
	</button>
}

// Card membungkus konten dalam panel putih.
templ Card() {
	<div class="ui-card">
		{ children... }
	</div>
}

// Varian Badge / Alert (warna status brand; selalu sertakan teks, bukan hanya warna).
const (
	Neutral = "neutral"
	Muted   = "muted"
	Success = "success"
	Warning = "warning"
	Danger  = "danger"
	Info    = "info"
)

// badgeClass / alertClass: nama kelas ditulis lengkap supaya terdeteksi Tailwind.
func badgeClass(variant string) string {
	switch variant {
	case Success:
		return "ui-badge ui-badge-success"
	case Warning:
		return "ui-badge ui-badge-warning"
	case Danger:
		return "ui-badge ui-badge-danger"
	case Info:
		return "ui-badge ui-badge-info"
	case Muted:
		return "ui-badge ui-badge-muted"
	}
	return "ui-badge ui-badge-neutral"
}

// AlertClass: kelas kotak pesan sesuai varian (dipakai juga modul yang
// merender pesan sendiri, mis. fragmen htmx).
func AlertClass(variant string) string {
	switch variant {
	case Success:
		return "ui-alert ui-alert-success"
	case Warning:
		return "ui-alert ui-alert-warning"
	case Info:
		return "ui-alert ui-alert-info"
	}
	return "ui-alert ui-alert-danger"
}

// Badge: label status kecil.
templ Badge(variant, label string) {
	<span class={ badgeClass(variant) }>{ label }</span>
}

// PageHeader: judul halaman (Playfair) + keterangan; children = aksi di kanan.
templ PageHeader(title, subtitle string) {
	<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
		<div class="min-w-0">
			<h1 class="font-display text-2xl leading-tight text-lovoria-deep sm:text-3xl">{ title }</h1>
			if subtitle != "" {
				<p class="mt-1 text-sm text-lovoria-muted">{ subtitle }</p>
			}
		</div>
		{ children... }
	</div>
}

// EmptyState: keadaan kosong (belum ada tamu/foto/ucapan); children = aksi.
templ EmptyState(title, message string) {
	<div class="rounded-2xl border border-dashed border-lovoria-border bg-lovoria-surface px-6 py-10 text-center">
		<p class="font-display text-xl text-lovoria-deep">{ title }</p>
		if message != "" {
			<p class="mx-auto mt-2 max-w-sm text-sm text-lovoria-muted">{ message }</p>
		}
		<div class="mt-5 empty:hidden">
			{ children... }
		</div>
	</div>
}

// ImageUpload adalah field satu foto: upload langsung ke gallery (UploadURL,
// kategori Category) lalu URL hasilnya disimpan di input tersembunyi f.Name.
// Butuh komponen Alpine imageUpload (static/js/lovoria.js).
templ ImageUpload(f Field, uploadURL, category string) {
	<div x-data={ templ.JSFuncCall("imageUpload", uploadURL, category, f.Value).CallInline }>
		<span class="ui-label">
			{ f.Label }
			if !f.Required && !f.Mandatory {
				<span class="font-normal text-lovoria-muted">(opsional)</span>
			}
		</span>
		<input type="hidden" name={ f.Name } value={ f.Value } :value="value"/>
		<div class="mt-1 flex items-center gap-3">
			<div class="flex h-20 w-20 flex-none items-center justify-center overflow-hidden rounded-xl bg-lovoria-subtle text-xs text-lovoria-muted">
				<template x-if="value">
					<img :src="value" alt="" class="h-full w-full object-cover"/>
				</template>
				<span x-show="!value">Belum ada</span>
			</div>
			<div class="min-w-0 space-y-1">
				<label class="ui-btn ui-btn-secondary ui-btn-sm cursor-pointer has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-lovoria-primary" :class="uploading && 'pointer-events-none opacity-60'">
					<span x-text="uploading ? 'Mengunggah… ' + progress + '%' : (value ? 'Ganti foto' : 'Pilih foto')">Pilih foto</span>
					<input id={ f.ID } type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" @change="pick($event)"/>
				</label>
				<button type="button" x-show="value && !uploading" @click="value = ''; $nextTick(() => $dispatch('image-change'))" class="block text-sm text-lovoria-danger hover:underline">Hapus foto</button>
			</div>
		</div>
		if f.Error != "" {
			<p class="ui-error">{ f.Error }</p>
		}
		<p class="ui-error" x-show="error" x-text="error"></p>
	</div>
}
