// Package ui berisi komponen form dashboard yang dipakai lintas modul.
package ui

// Field mendeskripsikan satu input form.
type Field struct {
	ID           string // id unik di halaman, mis. "wedding-title"
	Name         string
	Label        string
	Type         string // text | email | date | url | password
	Value        string
	Error        string
	Hint         string
	Placeholder  string
	Autocomplete string
	Required     bool
	MaxLength    int
}

const inputClass = "mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-base focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"

templ Input(f Field) {
	<div>
		<label for={ f.ID } class="block text-sm font-medium text-slate-800">
			{ f.Label }
			if !f.Required {
				<span class="font-normal text-slate-400">(opsional)</span>
			}
		</label>
		<input
			id={ f.ID }
			name={ f.Name }
			type={ f.Type }
			value={ f.Value }
			if f.Placeholder != "" {
				placeholder={ f.Placeholder }
			}
			if f.Autocomplete != "" {
				autocomplete={ f.Autocomplete }
			}
			if f.MaxLength > 0 {
				maxlength={ f.MaxLength }
			}
			required?={ f.Required }
			if f.Error != "" {
				aria-invalid="true"
			}
			aria-describedby={ f.ID + "-error" }
			class={ inputClass }
		/>
		@hintAndError(f)
	</div>
}

templ TextArea(f Field, rows int) {
	<div>
		<label for={ f.ID } class="block text-sm font-medium text-slate-800">
			{ f.Label }
			if !f.Required {
				<span class="font-normal text-slate-400">(opsional)</span>
			}
		</label>
		<textarea
			id={ f.ID }
			name={ f.Name }
			rows={ rows }
			if f.Placeholder != "" {
				placeholder={ f.Placeholder }
			}
			if f.MaxLength > 0 {
				maxlength={ f.MaxLength }
			}
			required?={ f.Required }
			if f.Error != "" {
				aria-invalid="true"
			}
			aria-describedby={ f.ID + "-error" }
			class={ inputClass }
		>{ f.Value }</textarea>
		@hintAndError(f)
	</div>
}

// Option adalah pilihan untuk Select.
type Option struct {
	Value string
	Label string
}

templ Select(f Field, options []Option) {
	<div>
		<label for={ f.ID } class="block text-sm font-medium text-slate-800">
			{ f.Label }
			if !f.Required {
				<span class="font-normal text-slate-400">(opsional)</span>
			}
		</label>
		<select
			id={ f.ID }
			name={ f.Name }
			required?={ f.Required }
			if f.Error != "" {
				aria-invalid="true"
			}
			aria-describedby={ f.ID + "-error" }
			class={ inputClass }
		>
			for _, o := range options {
				<option value={ o.Value } selected?={ o.Value == f.Value }>{ o.Label }</option>
			}
		</select>
		@hintAndError(f)
	</div>
}

templ hintAndError(f Field) {
	if f.Hint != "" && f.Error == "" {
		<p class="mt-1 text-xs text-slate-500">{ f.Hint }</p>
	}
	<p id={ f.ID + "-error" } class="mt-1 text-sm text-red-600">{ f.Error }</p>
}

// Alert menampilkan pesan error umum form.
templ Alert(msg string) {
	if msg != "" {
		<p class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">{ msg }</p>
	}
}

// Notice menampilkan pesan sukses.
templ Notice(msg string) {
	if msg != "" {
		<p class="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-700" role="status">{ msg }</p>
	}
}

templ PrimaryButton(label string) {
	<button type="submit" class="w-full rounded-lg bg-primary px-4 py-2.5 font-medium text-white hover:opacity-90 disabled:opacity-60 sm:w-auto">
		{ label }
	</button>
}

// SecondaryButton adalah tombol submit sekunder dengan name/value (mis. "Kembali").
templ SecondaryButton(label, name, value string) {
	<button type="submit" name={ name } value={ value } formnovalidate class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 font-medium text-slate-700 hover:bg-slate-50 sm:w-auto">
		{ label }
	</button>
}

// Card membungkus konten dalam panel putih.
templ Card() {
	<div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5 sm:p-6">
		{ children... }
	</div>
}

// ImageUpload adalah field satu foto: upload langsung ke gallery (UploadURL,
// kategori Category) lalu URL hasilnya disimpan di input tersembunyi f.Name.
// Butuh komponen Alpine imageUpload (static/js/lovoria.js).
templ ImageUpload(f Field, uploadURL, category string) {
	<div x-data={ templ.JSFuncCall("imageUpload", uploadURL, category, f.Value).CallInline }>
		<span class="block text-sm font-medium text-slate-800">
			{ f.Label }
			if !f.Required {
				<span class="font-normal text-slate-400">(opsional)</span>
			}
		</span>
		<input type="hidden" name={ f.Name } value={ f.Value } :value="value"/>
		<div class="mt-1 flex items-center gap-3">
			<div class="flex h-20 w-20 flex-none items-center justify-center overflow-hidden rounded-xl bg-slate-100 text-xs text-slate-400">
				<template x-if="value">
					<img :src="value" alt="" class="h-full w-full object-cover"/>
				</template>
				<span x-show="!value">Belum ada</span>
			</div>
			<div class="min-w-0 space-y-1">
				<label class="inline-flex cursor-pointer items-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50" :class="uploading && 'pointer-events-none opacity-60'">
					<span x-text="uploading ? 'Mengunggah… ' + progress + '%' : (value ? 'Ganti foto' : 'Pilih foto')">Pilih foto</span>
					<input id={ f.ID } type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" @change="pick($event)"/>
				</label>
				<button type="button" x-show="value && !uploading" @click="value = ''; $nextTick(() => $dispatch('image-change'))" class="block text-sm text-red-600 hover:underline">Hapus foto</button>
			</div>
		</div>
		if f.Error != "" {
			<p class="mt-1 text-sm text-red-600">{ f.Error }</p>
		}
		<p class="mt-1 text-sm text-red-600" x-show="error" x-text="error"></p>
	</div>
}
