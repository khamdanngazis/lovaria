package admin

import (
	"fmt"
	"net/url"
	"strconv"
	"time"

	"github.com/google/uuid"

	"github.com/khamdanngazis/lovaria/src/modules/auth"
	"github.com/khamdanngazis/lovaria/src/modules/domain"
	"github.com/khamdanngazis/lovaria/src/modules/gallery"
	"github.com/khamdanngazis/lovaria/src/modules/guest"
	"github.com/khamdanngazis/lovaria/src/modules/payment"
	"github.com/khamdanngazis/lovaria/src/modules/theme"
	"github.com/khamdanngazis/lovaria/src/modules/wedding"
	"github.com/khamdanngazis/lovaria/src/platform/web"
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/src/templates/ui"
)

type homeData struct {
	Users, Weddings int
	ByStatus        map[string]int
	Storage         int64
	ActiveDomains   int
	QuotaWarn       int
	Audit           []AuditEntry
}

type weddingData struct {
	W           wedding.Wedding
	Couple      wedding.Couple
	Owner       auth.User
	Guests      guest.Stats
	Usage       gallery.Usage
	Domain      *domain.Domain
	Package     Package
	HasPackage  bool
	Packages    []Package
	History     []wedding.StatusChange
	Audit       []AuditEntry
	Transitions []string
	Flash       flash
	// Orders: riwayat percobaan bayar wedding (T23), terbaru dulu.
	Orders []payment.Order
}

// paidSourceLabel: asal pelunasan untuk tampilan admin.
func paidSourceLabel(src string) string {
	switch src {
	case wedding.PaidGateway:
		return "payment gateway"
	case wedding.PaidAdmin:
		return "ditandai admin"
	case wedding.PaidGrandfathered:
		return "terbit sebelum pembayaran berlaku"
	case wedding.PaidDemo:
		return "undangan contoh"
	}
	return src
}

var statuses = wedding.AllStatuses()

func bytesText(n int64) string {
	switch {
	case n >= 1<<30:
		return fmt.Sprintf("%.1f GB", float64(n)/(1<<30))
	case n >= 1<<20:
		return fmt.Sprintf("%.1f MB", float64(n)/(1<<20))
	default:
		return fmt.Sprintf("%d KB", (n+1023)/1024)
	}
}

func when(t time.Time) string { return t.Format("02/01/2006 15:04") }

func pct(a, b int64) int {
	if b <= 0 {
		return 0
	}
	return int(min(100, a*100/b))
}

// pageURL: URL daftar dengan query yang sama, halaman berbeda.
func pageURL(path string, q url.Values, page int) string {
	v := url.Values{}
	for k, vs := range q {
		v[k] = vs
	}
	v.Set("page", strconv.Itoa(page))
	return path + "?" + v.Encode()
}

var tabs = []struct{ Path, Label string }{
	{"/admin", "Ringkasan"}, {"/admin/users", "Customers"}, {"/admin/weddings", "Weddings"}, {"/admin/themes", "Tema"},
	{"/admin/packages", "Paket"}, {"/admin/payments", "Pembayaran"}, {"/admin/storage", "Storage"}, {"/admin/domains", "Domain"}, {"/admin/support", "Bantuan"}, {"/admin/audit", "Audit log"},
}

templ shell(title, active string) {
	@layouts.Dashboard(layouts.Meta{Title: "Admin · " + title}) {
		<p class="text-xs font-medium uppercase tracking-[0.2em] text-lovoria-accent-ink">Panel admin</p>
		<h1 class="mt-1 font-display text-3xl text-lovoria-deep">{ title }</h1>
		<nav class="ui-tabs scrollbar-none -mx-4 mt-4 px-4" aria-label="Menu admin">
			for _, t := range tabs {
				<a
					href={ templ.SafeURL(t.Path) }
					class="ui-tab"
					if active == t.Path {
						aria-current="page"
					}
				>{ t.Label }</a>
			}
		</nav>
		<div class="mt-6 space-y-4">
			{ children... }
		</div>
	}
}

templ flashMsg(f flash) {
	@ui.Notice(f.Notice)
	@ui.Alert(f.Error)
}

templ stat(label, value, sub string) {
	<div class="ui-card p-4">
		<p class="text-xs text-lovoria-muted">{ label }</p>
		<p class="mt-1 font-display text-2xl text-lovoria-deep">{ value }</p>
		if sub != "" {
			<p class="text-xs text-lovoria-muted">{ sub }</p>
		}
	</div>
}

templ pager(path string, q url.Values, page, total int) {
	if pages := max(1, (total+PerPage-1)/PerPage); pages > 1 {
		<nav class="flex items-center justify-between text-sm" aria-label="Halaman">
			if page > 1 {
				<a href={ templ.SafeURL(pageURL(path, q, page-1)) } class="ui-btn ui-btn-secondary px-3 py-1.5">‹ Sebelumnya</a>
			} else {
				<span></span>
			}
			<span class="text-lovoria-muted">Halaman { strconv.Itoa(page) } dari { strconv.Itoa(pages) } · { strconv.Itoa(total) } data</span>
			if page < pages {
				<a href={ templ.SafeURL(pageURL(path, q, page+1)) } class="ui-btn ui-btn-secondary px-3 py-1.5">Berikutnya ›</a>
			} else {
				<span></span>
			}
		</nav>
	}
}

templ table() {
	<div class="ui-card overflow-x-auto p-0">
		<table class="ui-table">
			{ children... }
		</table>
	</div>
}

templ auditTable(es []AuditEntry) {
	@table() {
		<thead><tr><th>Waktu</th><th>Admin</th><th>Aksi</th><th>Target</th><th>Detail</th></tr></thead>
		<tbody>
			if len(es) == 0 {
				<tr><td colspan="5" class="text-lovoria-muted">Belum ada aksi admin.</td></tr>
			}
			for _, e := range es {
				<tr>
					<td class="whitespace-nowrap">{ when(e.CreatedAt) }</td>
					<td>{ e.AdminEmail }</td>
					<td class="font-mono text-xs">{ e.Action }</td>
					<td class="font-mono text-xs">
						if e.TargetType == "wedding" {
							<a href={ templ.SafeURL("/admin/weddings/" + e.TargetID) } class="text-lovoria-primary hover:underline">{ e.TargetType }:{ e.TargetID[:min(8, len(e.TargetID))] }</a>
						} else if e.TargetType == "user" {
							<a href={ templ.SafeURL("/admin/users/" + e.TargetID) } class="text-lovoria-primary hover:underline">{ e.TargetType }:{ e.TargetID[:min(8, len(e.TargetID))] }</a>
						} else {
							{ e.TargetType }:{ e.TargetID }
						}
					</td>
					<td class="text-xs text-lovoria-muted">
						for k, v := range e.Details {
							<span class="mr-2">{ k }={ v }</span>
						}
					</td>
				</tr>
			}
		</tbody>
	}
}

// ---------- Ringkasan ----------
templ homePage(d homeData) {
	@shell("Ringkasan", "/admin") {
		<div class="grid grid-cols-2 gap-3 md:grid-cols-4">
			@stat("Customers", strconv.Itoa(d.Users), "")
			@stat("Wedding", strconv.Itoa(d.Weddings), "semua status")
			@stat("Storage terpakai", bytesText(d.Storage), "")
			@stat("Custom domain aktif", fmt.Sprintf("%d / 100", d.ActiveDomains), "kuota gratis Cloudflare for SaaS")
		</div>
		if d.ActiveDomains >= d.QuotaWarn {
			@ui.Alert(fmt.Sprintf("Custom domain aktif sudah %d dari kuota gratis 100. Siapkan anggaran untuk hostname tambahan.", d.ActiveDomains))
		}
		<div class="flex flex-wrap gap-2 text-sm">
			for _, st := range statuses {
				<a href={ templ.SafeURL("/admin/weddings?status=" + st) } class="rounded-full bg-lovoria-surface px-3 py-1.5 ring-1 ring-lovoria-border">{ wedding.StatusLabel(st) } · { strconv.Itoa(d.ByStatus[st]) }</a>
			}
		</div>
		<h2 class="pt-2 font-semibold">Aksi admin terbaru</h2>
		@auditTable(d.Audit)
	}
}

// ---------- Customers ----------
templ usersPage(q string, p auth.UserPage) {
	@shell("Customers", "/admin/users") {
		<form method="get" class="flex gap-2">
			<input type="search" name="q" value={ q } placeholder="Cari nama atau email…" aria-label="Cari customer" class="ui-control min-w-0 flex-1 px-3 py-2"/>
			<button type="submit" class="ui-btn ui-btn-primary px-4 py-2 text-sm">Cari</button>
		</form>
		@table() {
			<thead><tr><th>Nama</th><th>Email</th><th>Peran</th><th>Daftar</th><th>Status</th></tr></thead>
			<tbody>
				if len(p.Users) == 0 {
					<tr><td colspan="5" class="text-lovoria-muted">Tidak ada customer yang cocok.</td></tr>
				}
				for _, u := range p.Users {
					<tr>
						<td><a href={ templ.SafeURL("/admin/users/" + u.ID.String()) } class="font-medium text-lovoria-primary hover:underline">{ u.Name }</a></td>
						<td>{ u.Email }</td>
						<td>{ u.Role }</td>
						<td class="whitespace-nowrap">{ web.FormatDateID(u.CreatedAt) }</td>
						<td>
							if u.DisabledAt != nil {
								<span class="rounded-full bg-lovoria-danger-soft px-2 py-0.5 text-xs text-lovoria-danger">Nonaktif</span>
							} else {
								<span class="rounded-full bg-lovoria-success-soft px-2 py-0.5 text-xs text-lovoria-success">Aktif</span>
							}
						</td>
					</tr>
				}
			</tbody>
		}
		@pager("/admin/users", url.Values{"q": {q}}, p.Page, p.Total)
	}
}

templ userPage(u auth.User, ws []wedding.Wedding, f flash) {
	@shell(u.Name, "/admin/users") {
		@flashMsg(f)
		@ui.Card() {
			<dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
				<dt class="text-lovoria-muted">Email</dt>
				<dd>{ u.Email }</dd>
				<dt class="text-lovoria-muted">Peran</dt>
				<dd>{ u.Role }</dd>
				<dt class="text-lovoria-muted">Terdaftar</dt>
				<dd>{ when(u.CreatedAt) }</dd>
				<dt class="text-lovoria-muted">Status</dt>
				<dd>
					if u.DisabledAt != nil {
						Nonaktif sejak { when(*u.DisabledAt) }
					} else {
						Aktif
					}
				</dd>
			</dl>
			<div class="mt-4 flex flex-wrap gap-2">
				<a href={ templ.SafeURL("mailto:" + u.Email) } class="ui-btn ui-btn-secondary px-3 py-2 text-sm">Kirim email</a>
				<form
					method="post"
					action={ templ.SafeURL("/admin/users/" + u.ID.String() + "/disabled") }
					if u.DisabledAt == nil {
						data-confirm="Nonaktifkan akun ini? User langsung keluar dari semua sesi dan tidak bisa login."
					}
				>
					@layouts.CSRFField()
					if u.DisabledAt != nil {
						<input type="hidden" name="disabled" value="0"/>
						<button type="submit" class="ui-btn ui-btn-primary px-3 py-2 text-sm">Aktifkan kembali</button>
					} else {
						<input type="hidden" name="disabled" value="1"/>
						<button type="submit" class="ui-btn ui-btn-danger px-3 py-2 text-sm">Nonaktifkan akun</button>
					}
				</form>
			</div>
		}
		<h2 class="font-semibold">Wedding milik user ini</h2>
		@weddingTable(ws, nil)
	}
}

// ---------- Weddings ----------
templ weddingTable(ws []wedding.Wedding, owners map[string]string) {
	@table() {
		<thead>
			<tr>
				<th>Wedding</th>
				<th>Tanggal</th>
				<th>Status</th>
				<th>Storage</th>
				if owners != nil {
					<th>Pemilik</th>
				}
			</tr>
		</thead>
		<tbody>
			if len(ws) == 0 {
				<tr><td colspan="5" class="text-lovoria-muted">Tidak ada wedding.</td></tr>
			}
			for _, w := range ws {
				<tr>
					<td>
						<a href={ templ.SafeURL("/admin/weddings/" + w.ID.String()) } class="font-medium text-lovoria-primary hover:underline">{ w.Title }</a>
						<p class="text-xs text-lovoria-muted">/w/{ w.Slug }</p>
					</td>
					<td class="whitespace-nowrap">{ w.WeddingDate.Format("02/01/2006") }</td>
					<td>{ wedding.StatusLabel(w.Status) }</td>
					<td class="whitespace-nowrap">{ bytesText(w.StorageUsedBytes) }</td>
					if owners != nil {
						<td>{ owners[w.OwnerUserID.String()] }</td>
					}
				</tr>
			}
		</tbody>
	}
}

func ownerEmails(m map[uuid.UUID]string) map[string]string {
	out := map[string]string{}
	for k, v := range m {
		out[k.String()] = v
	}
	return out
}

func filterQuery(f wedding.AdminFilter) url.Values {
	return url.Values{"status": {f.Status}, "from": {f.From}, "to": {f.To}, "q": {f.Q}, "sort": {f.Sort}}
}

templ weddingsPage(f wedding.AdminFilter, p wedding.WeddingPage, owners map[uuid.UUID]string) {
	@shell("Weddings", "/admin/weddings") {
		<form method="get" class="ui-card grid gap-2 p-3 sm:grid-cols-6">
			<input type="search" name="q" value={ f.Q } placeholder="Judul / slug" aria-label="Cari wedding" class="ui-control px-3 py-2 sm:col-span-2"/>
			<select name="status" aria-label="Status" class="ui-control px-3 py-2">
				<option value="">Semua status</option>
				for _, st := range statuses {
					<option value={ st } selected?={ f.Status == st }>{ wedding.StatusLabel(st) }</option>
				}
			</select>
			<input type="date" name="from" value={ f.From } aria-label="Tanggal dari" class="ui-control px-3 py-2"/>
			<input type="date" name="to" value={ f.To } aria-label="Tanggal sampai" class="ui-control px-3 py-2"/>
			<select name="sort" aria-label="Urutkan" class="ui-control px-3 py-2">
				<option value="created" selected?={ f.Sort == "" || f.Sort == "created" }>Terbaru dibuat</option>
				<option value="date" selected?={ f.Sort == "date" }>Tanggal pernikahan</option>
				<option value="storage" selected?={ f.Sort == "storage" }>Storage terbesar</option>
			</select>
			<button type="submit" class="ui-btn ui-btn-primary px-4 py-2 text-sm sm:col-span-6 sm:justify-self-end">Terapkan</button>
		</form>
		@weddingTable(p.Weddings, ownerEmails(owners))
		@pager("/admin/weddings", filterQuery(f), p.Page, p.Total)
	}
}

templ weddingPage(d weddingData) {
	@shell(d.W.Title, "/admin/weddings") {
		@flashMsg(d.Flash)
		<div class="grid gap-4 md:grid-cols-2">
			@ui.Card() {
				<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<dt class="text-lovoria-muted">Pasangan</dt>
					<dd>{ d.Couple.GroomName } &amp; { d.Couple.BrideName }</dd>
					<dt class="text-lovoria-muted">Tanggal</dt>
					<dd>{ web.FormatDateID(d.W.WeddingDate) }</dd>
					<dt class="text-lovoria-muted">Status</dt>
					<dd class="font-medium">{ wedding.StatusLabel(d.W.Status) }</dd>
					<dt class="text-lovoria-muted">Pemilik</dt>
					<dd><a href={ templ.SafeURL("/admin/users/" + d.Owner.ID.String()) } class="text-lovoria-primary hover:underline">{ d.Owner.Email }</a></dd>
					<dt class="text-lovoria-muted">Tema</dt>
					<dd>{ d.W.ThemeID }</dd>
					<dt class="text-lovoria-muted">Domain</dt>
					<dd>
						if d.Domain != nil {
							{ d.Domain.Domain } · { domain.StatusLabel(d.Domain.Status) }
						} else {
							—
						}
					</dd>
				</dl>
				<div class="mt-4 flex flex-wrap gap-2 text-sm">
					<a href={ templ.SafeURL("/w/" + d.W.Slug) } target="_blank" rel="noopener" class="ui-btn ui-btn-secondary px-3 py-2">Buka website ↗</a>
					<form method="post" action={ templ.SafeURL("/admin/weddings/" + d.W.ID.String() + "/view") }>
						@layouts.CSRFField()
						<button type="submit" class="ui-btn ui-btn-secondary px-3 py-2">Lihat dashboard (lihat saja)</button>
					</form>
				</div>
			}
			@ui.Card() {
				<p class="text-xs uppercase tracking-wide text-lovoria-muted">Tamu & RSVP</p>
				<p class="mt-1 text-sm">{ strconv.Itoa(d.Guests.Total) } tamu · { strconv.Itoa(d.Guests.Attending) } hadir ({ strconv.Itoa(d.Guests.PaxAttending) } orang) · { strconv.Itoa(d.Guests.Declined) } tidak · { strconv.Itoa(d.Guests.Pending) } belum</p>
				<p class="mt-3 text-xs uppercase tracking-wide text-lovoria-muted">Storage</p>
				<p class="mt-1 text-sm">{ bytesText(d.Usage.UsedBytes) } dari { bytesText(d.Usage.QuotaBytes) } ({ strconv.Itoa(pct(d.Usage.UsedBytes, d.Usage.QuotaBytes)) }%)</p>
				<p class="mt-3 text-xs uppercase tracking-wide text-lovoria-muted">Paket</p>
				<form method="post" action={ templ.SafeURL("/admin/weddings/" + d.W.ID.String() + "/package") } class="mt-1 flex gap-2">
					@layouts.CSRFField()
					<select name="package_id" aria-label="Paket" class="ui-control min-w-0 flex-1 px-3 py-2 text-sm">
						<option value="">Default (config)</option>
						for _, p := range d.Packages {
							<option value={ p.ID.String() } selected?={ d.HasPackage && d.Package.ID == p.ID }>{ p.Name } · { strconv.Itoa(p.StorageMB) } MB · arsip { strconv.Itoa(p.ArchiveDays) } hari</option>
						}
					</select>
					<button type="submit" class="ui-btn ui-btn-primary px-3 py-2 text-sm">Simpan</button>
				</form>
			}
		</div>
		@paymentCard(d)
		@ui.Card() {
			<p class="text-xs uppercase tracking-wide text-lovoria-muted">Ubah status (admin)</p>
			if len(d.Transitions) == 0 {
				<p class="mt-1 text-sm text-lovoria-muted">Tidak ada perubahan status yang bisa dilakukan admin dari { wedding.StatusLabel(d.W.Status) }.</p>
			} else {
				<div class="mt-2 flex flex-wrap gap-2">
					for _, to := range d.Transitions {
						<form method="post" action={ templ.SafeURL("/admin/weddings/" + d.W.ID.String() + "/status") } data-confirm={ "Ubah status menjadi " + wedding.StatusLabel(to) + "?" }>
							@layouts.CSRFField()
							<input type="hidden" name="status" value={ to }/>
							<button type="submit" class="ui-btn ui-btn-secondary px-3 py-2 text-sm">→ { wedding.StatusLabel(to) }</button>
						</form>
					}
				</div>
			}
			if len(d.History) > 0 {
				<ul class="mt-3 space-y-1 text-xs text-lovoria-muted">
					for _, h := range d.History {
						<li>{ when(h.At) } — { wedding.StatusLabel(h.From) } → { wedding.StatusLabel(h.To) } ({ string(h.Actor) })</li>
					}
				</ul>
			}
		}
		<h2 class="font-semibold">Audit untuk wedding ini</h2>
		@auditTable(d.Audit)
	}
}

// ---------- Tema, paket, storage, domain, audit ----------
templ themesPage(ts []theme.ThemeDef, counts map[string]int, off map[string]bool, f flash) {
	@shell("Tema", "/admin/themes") {
		@flashMsg(f)
		<p class="text-sm text-lovoria-muted">Tema yang dinonaktifkan tidak bisa dipilih pasangan baru; wedding yang sudah memakainya tetap bisa.</p>
		@table() {
			<thead><tr><th>Tema</th><th>Dipakai</th><th>Status</th><th></th></tr></thead>
			<tbody>
				for _, t := range ts {
					<tr>
						<td><span class="font-medium">{ t.Name }</span> <span class="font-mono text-xs text-lovoria-muted">{ t.ID }</span></td>
						<td>{ strconv.Itoa(counts[t.ID]) } wedding</td>
						<td>
							if off[t.ID] {
								<span class="rounded-full bg-lovoria-border px-2 py-0.5 text-xs">Nonaktif</span>
							} else {
								<span class="rounded-full bg-lovoria-success-soft px-2 py-0.5 text-xs text-lovoria-success">Aktif</span>
							}
						</td>
						<td class="text-right">
							<form method="post" action={ templ.SafeURL("/admin/themes/" + t.ID) }>
								@layouts.CSRFField()
								if off[t.ID] {
									<input type="hidden" name="enabled" value="1"/>
									<button type="submit" class="text-lovoria-primary hover:underline">Aktifkan</button>
								} else {
									<input type="hidden" name="enabled" value="0"/>
									<button type="submit" class="text-lovoria-muted hover:underline">Nonaktifkan</button>
								}
							</form>
						</td>
					</tr>
				}
			</tbody>
		}
	}
}

templ packageFields(p Package, idPrefix string) {
	<input type="text" name="name" value={ p.Name } placeholder="Nama paket" aria-label="Nama paket" required maxlength="60" class="ui-control px-3 py-2"/>
	<input type="number" name="storage_mb" value={ strconv.Itoa(p.StorageMB) } min="1" max="102400" aria-label="Storage (MB)" required class="ui-control px-3 py-2"/>
	<input type="number" name="archive_days" value={ strconv.Itoa(p.ArchiveDays) } min="1" max="3650" aria-label="Arsip setelah (hari)" required class="ui-control px-3 py-2"/>
	<input type="text" name="price_display" value={ p.PriceDisplay } placeholder="Rp 99.000" aria-label="Harga (tampilan)" maxlength="40" class="ui-control px-3 py-2"/>
	<div class="flex items-center gap-3 text-sm sm:col-span-4">
		<label class="flex items-center gap-2">
			<input type="checkbox" name="show_on_landing" value="1" checked?={ p.ShowOnLanding } class="h-4 w-4"/>
			Tampil di landing page
		</label>
		<label class="flex items-center gap-2">
			Urutan
			<input type="number" name="sort_order" value={ strconv.Itoa(p.SortOrder) } min="0" max="999" aria-label="Urutan di landing" class="ui-control w-20 px-2 py-1"/>
		</label>
	</div>
}

templ packagesPage(ps []Package, f flash) {
	@shell("Paket", "/admin/packages") {
		@flashMsg(f)
		<p class="text-sm text-lovoria-muted">Paket menentukan kuota storage & lama arsip wedding (tanpa pembayaran). Wedding tanpa paket memakai nilai default dari config. Centang "Tampil di landing page" untuk menampilkan paket di bagian harga beranda; tanpa paket yang dicentang, bagian harga disembunyikan.</p>
		<div class="hidden grid-cols-[2fr_1fr_1fr_1fr_auto] gap-2 px-1 text-xs font-medium uppercase tracking-wide text-lovoria-muted sm:grid">
			<span>Nama</span><span>Storage (MB)</span><span>Arsip (hari)</span><span>Harga</span><span></span>
		</div>
		for _, p := range ps {
			<div class="ui-card p-3">
				<form method="post" action={ templ.SafeURL("/admin/packages/" + p.ID.String()) } class="grid gap-2 sm:grid-cols-[2fr_1fr_1fr_1fr_auto]">
					@layouts.CSRFField()
					@packageFields(p, p.ID.String())
					<button type="submit" class="ui-btn ui-btn-primary px-3 py-2 text-sm">Simpan</button>
				</form>
				<div class="mt-2 flex items-center justify-between text-xs text-lovoria-muted">
					<span>Dipakai { strconv.Itoa(p.Weddings) } wedding</span>
					<form method="post" action={ templ.SafeURL("/admin/packages/" + p.ID.String() + "/delete") } data-confirm="Hapus paket ini?">
						@layouts.CSRFField()
						<button type="submit" class="text-lovoria-danger hover:underline">Hapus</button>
					</form>
				</div>
			</div>
		}
		<div class="rounded-2xl border border-dashed border-lovoria-control p-3">
			<p class="mb-2 text-sm font-medium">Paket baru</p>
			<form method="post" action="/admin/packages" class="grid gap-2 sm:grid-cols-[2fr_1fr_1fr_1fr_auto]">
				@layouts.CSRFField()
				@packageFields(Package{StorageMB: 500, ArchiveDays: 365}, "new")
				<button type="submit" class="ui-btn ui-btn-primary px-3 py-2 text-sm">Tambah</button>
			</form>
		</div>
	}
}

templ storagePage(total int64, weddings int, top []wedding.Wedding, usage []gallery.Usage) {
	@shell("Storage", "/admin/storage") {
		<div class="grid grid-cols-2 gap-3 md:grid-cols-4">
			@stat("Total terpakai", bytesText(total), strconv.Itoa(weddings)+" wedding")
		</div>
		<h2 class="font-semibold">20 wedding terbesar</h2>
		@table() {
			<thead><tr><th>Wedding</th><th>Terpakai</th><th>Kuota</th><th>%</th></tr></thead>
			<tbody>
				for i, w := range top {
					<tr>
						<td><a href={ templ.SafeURL("/admin/weddings/" + w.ID.String()) } class="text-lovoria-primary hover:underline">{ w.Title }</a></td>
						<td>{ bytesText(usage[i].UsedBytes) }</td>
						<td>{ bytesText(usage[i].QuotaBytes) }</td>
						<td>{ strconv.Itoa(pct(usage[i].UsedBytes, usage[i].QuotaBytes)) }%</td>
					</tr>
				}
			</tbody>
		}
	}
}

templ domainsPage(ds []domain.Domain, total, page, active, warn int) {
	@shell("Custom domain", "/admin/domains") {
		<div class="grid grid-cols-2 gap-3 md:grid-cols-4">
			@stat("Aktif", fmt.Sprintf("%d / 100", active), "kuota gratis Cloudflare for SaaS")
			@stat("Terdaftar", strconv.Itoa(total), "semua status")
		</div>
		if active >= warn {
			@ui.Alert(fmt.Sprintf("Domain aktif sudah %d — mendekati kuota gratis 100.", active))
		}
		@table() {
			<thead><tr><th>Domain</th><th>Status</th><th>Didaftarkan</th><th>Dicek</th><th>Wedding</th></tr></thead>
			<tbody>
				if len(ds) == 0 {
					<tr><td colspan="5" class="text-lovoria-muted">Belum ada custom domain.</td></tr>
				}
				for _, d := range ds {
					<tr>
						<td class="font-medium">{ d.Domain }</td>
						<td>{ domain.StatusLabel(d.Status) }</td>
						<td class="whitespace-nowrap">{ when(d.CreatedAt) }</td>
						<td class="whitespace-nowrap">
							if d.LastCheckedAt != nil {
								{ when(*d.LastCheckedAt) }
							}
						</td>
						<td><a href={ templ.SafeURL("/admin/weddings/" + d.WeddingID.String()) } class="text-lovoria-primary hover:underline">Buka</a></td>
					</tr>
				}
			</tbody>
		}
		@pager("/admin/domains", url.Values{}, page, total)
	}
}

templ auditPage(es []AuditEntry, total, page int) {
	@shell("Audit log", "/admin/audit") {
		@auditTable(es)
		@pager("/admin/audit", url.Values{}, page, total)
	}
}

// ---------- Pembayaran (T23) ----------

// paymentCard: status pelunasan wedding, riwayat order, dan tandai lunas manual.
templ paymentCard(d weddingData) {
	@ui.Card() {
		<div class="flex flex-wrap items-center gap-3">
			<p class="text-xs uppercase tracking-wide text-lovoria-muted">Pembayaran</p>
			if d.W.IsPaid() {
				@ui.Badge(ui.Success, "Lunas ✓")
				<p class="text-sm text-lovoria-muted">{ when(*d.W.PaidAt) } · { paidSourceLabel(d.W.PaidSource) }</p>
			} else {
				@ui.Badge(ui.Muted, "Belum dibayar")
				<p class="text-sm text-lovoria-muted">Publikasi & custom domain masih terkunci.</p>
			}
		</div>
		if len(d.Orders) > 0 {
			<div class="mt-4 overflow-x-auto">
				@ordersTable(d.Orders, false)
			</div>
		}
		if !d.W.IsPaid() {
			<form method="post" action={ templ.SafeURL("/admin/weddings/" + d.W.ID.String() + "/paid") } class="mt-4 border-t border-lovoria-border pt-4" data-confirm="Tandai wedding ini lunas tanpa pembayaran gateway? Tindakan ini tidak bisa dibatalkan.">
				@layouts.CSRFField()
				<label for="paid-note" class="ui-label">Tandai lunas manual</label>
				<p class="ui-hint">Untuk transfer manual, promo, atau uji coba. Catatan tersimpan di audit log.</p>
				<div class="mt-2 flex flex-wrap gap-2">
					<input id="paid-note" name="note" type="text" required minlength="3" maxlength="300" placeholder="mis. transfer manual BCA 4 Okt" class="ui-control min-w-0 flex-1 px-3 py-2 text-sm"/>
					<button type="submit" class="ui-btn ui-btn-secondary">Tandai lunas</button>
				</div>
			</form>
		}
	}
}

func orderBadge(status string) string {
	switch status {
	case payment.StatusPaid:
		return ui.Success
	case payment.StatusPending:
		return ui.Warning
	case payment.StatusFailed:
		return ui.Danger
	}
	return ui.Muted
}

// ordersTable: daftar order; withWedding menambah tautan ke wedding (halaman Pembayaran).
templ ordersTable(orders []payment.Order, withWedding bool) {
	<table class="ui-table">
		<thead>
			<tr>
				<th>No. order</th>
				<th>Dibuat</th>
				<th>Jumlah</th>
				<th>Status</th>
				<th>Metode</th>
				<th>Dibayar</th>
				if withWedding {
					<th>Wedding</th>
				}
			</tr>
		</thead>
		<tbody>
			for _, o := range orders {
				<tr>
					<td class="whitespace-nowrap font-mono text-xs">{ o.Number }</td>
					<td class="whitespace-nowrap">{ when(o.CreatedAt) }</td>
					<td class="whitespace-nowrap">{ payment.Rupiah(o.Amount) }</td>
					<td>
						@ui.Badge(orderBadge(o.Status), payment.StatusLabel(o.Status))
					</td>
					<td class="whitespace-nowrap">
						if o.Method != "" {
							{ o.Method }
						} else {
							—
						}
						<span class="text-lovoria-muted">· { o.Gateway }</span>
					</td>
					<td class="whitespace-nowrap">
						if o.PaidAt != nil {
							{ when(*o.PaidAt) }
						} else {
							—
						}
					</td>
					if withWedding {
						<td><a href={ templ.SafeURL("/admin/weddings/" + o.WeddingID.String()) } class="ui-link">Buka</a></td>
					}
				</tr>
			}
		</tbody>
	</table>
}

templ paymentsPage(orders []payment.Order, total, page int) {
	@shell("Pembayaran", "/admin/payments") {
		<p class="text-sm text-lovoria-muted">Semua percobaan bayar, terbaru dulu ({ strconv.Itoa(total) } order). Status hanya berubah lewat webhook gateway; penelusuran webhook ada di tabel <span class="font-mono">payment_events</span>.</p>
		if len(orders) == 0 {
			@ui.EmptyState("Belum ada pembayaran", "Order muncul di sini saat pasangan menekan Bayar & Publikasikan.")
		} else {
			<div class="ui-card overflow-x-auto p-0 sm:p-0">
				@ordersTable(orders, true)
			</div>
			@pager("/admin/payments", nil, page, total)
		}
	}
}

// supportPage: nomor WhatsApp bantuan pelanggan (T25).
templ supportPage(sup web.Support, f flash) {
	@shell("Bantuan", "/admin/support") {
		@flashMsg(f)
		<p class="text-sm text-lovoria-muted">Nomor WhatsApp (Business) untuk bantuan pelanggan. Tautan "Bantuan" di landing, halaman masuk & daftar, menu akun dashboard, dan halaman pembayaran membuka chat ke nomor ini. Perubahan langsung berlaku.</p>
		<div class="ui-card max-w-xl p-5">
			<form method="post" action="/admin/support" class="space-y-4">
				@layouts.CSRFField()
				<div>
					<label for="support-phone" class="ui-label">Nomor WhatsApp</label>
					<input id="support-phone" name="phone" type="tel" inputmode="tel" autocomplete="off" value={ displayPhone(sup.Phone) } placeholder="0812-3456-7890" class="ui-input"/>
					<p class="ui-hint">Kosongkan untuk menyembunyikan tautan bantuan.</p>
				</div>
				<div>
					<label for="support-message" class="ui-label">Pesan pembuka</label>
					<textarea id="support-message" name="message" rows="3" maxlength="300" class="ui-input">{ sup.Message }</textarea>
					<p class="ui-hint">Terisi otomatis di WhatsApp saat pelanggan membuka chat.</p>
				</div>
				<div class="flex flex-wrap items-center gap-3">
					<button type="submit" class="ui-btn ui-btn-primary">Simpan</button>
					if web.SupportURL() != "" {
						<a href={ templ.SafeURL(web.SupportURL()) } target="_blank" rel="noopener" class="ui-link text-sm">Coba buka chat ↗</a>
					}
				</div>
			</form>
		</div>
	}
}
