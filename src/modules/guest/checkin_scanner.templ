package guest

import (
	"strconv"

	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/static"
)

// Hasil pemindaian.
const (
	resultReady   = "ready"   // undangan sah, belum check-in → minta konfirmasi
	resultDone    = "done"    // check-in berhasil
	resultAlready = "already" // undangan sudah dipakai
	resultUnknown = "unknown" // bukan undangan wedding ini
	resultClosed  = "closed"  // check-in tidak dibuka
)

templ scannerHead() {
	@layouts.BrandFonts(true)
	<meta name="robots" content="noindex"/>
	<script src={ static.URL("js/checkin.js") } defer></script>
}

// scannerPage: halaman pemindai untuk penerima tamu (ponsel, sambil berdiri di
// pintu masuk): tombol besar, hasil terbaca dari jarak lengan.
templ scannerPage(s scanner) {
	@layouts.Document(layouts.Meta{Title: "Check-in tamu", Cacheable: true}, scannerHead(), layouts.BrandBody) {
		<main id="checkin" class="mx-auto w-full max-w-md px-4 pb-10 pt-5" data-scan-url={ s.Base + "/scan" } data-jsqr={ static.URL("js/vendor/jsqr.js") }>
			<header>
				<p class="text-xs font-medium uppercase tracking-[0.22em] text-lovoria-accent-ink">Check-in tamu</p>
				<h1 class="mt-1 break-words font-display text-2xl leading-tight text-lovoria-deep">{ s.W.Title }</h1>
				@scanStats(s, false)
			</header>
			if !s.W.CheckinOpen() {
				<div class="mt-5">
					@resultCard(s, resultClosed, Guest{}, "")
				</div>
			} else {
				<section class="mt-5" aria-label="Pemindai QR">
					<div class="relative aspect-square overflow-hidden rounded-3xl bg-lovoria-deep">
						<video id="checkin-video" playsinline muted class="h-full w-full object-cover"></video>
						<div class="pointer-events-none absolute inset-8 rounded-2xl border-2 border-white/70" aria-hidden="true"></div>
						<div id="checkin-idle" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-lovoria-deep px-6 text-center text-white">
							<p class="text-sm text-white/80">Arahkan kamera ke QR di undangan tamu.</p>
							<button type="button" id="checkin-start" class="rounded-xl bg-white px-6 py-3.5 text-base font-semibold text-lovoria-deep">Nyalakan kamera</button>
						</div>
					</div>
					<p id="checkin-status" class="mt-2 min-h-5 text-center text-sm text-lovoria-muted" role="status"></p>
				</section>
				<div id="checkin-result" class="mt-3" aria-live="assertive"></div>
				<details class="mt-5 rounded-2xl border border-lovoria-border bg-lovoria-surface">
					<summary class="cursor-pointer list-none p-4 font-medium text-lovoria-deep [&::-webkit-details-marker]:hidden">Cari manual (tanpa QR)</summary>
					<div class="border-t border-lovoria-border p-4">
						<label for="checkin-q" class="ui-label">Nama tamu atau kode undangan</label>
						<input
							id="checkin-q"
							name="q"
							type="search"
							autocomplete="off"
							class="ui-input"
							placeholder="mis. Budi"
							hx-get={ s.Base + "/search" }
							hx-trigger="input changed delay:350ms, search"
							hx-target="#checkin-search"
						/>
						<div id="checkin-search" class="mt-3"></div>
					</div>
				</details>
				<details class="mt-3 rounded-2xl border border-lovoria-border bg-lovoria-surface">
					<summary class="cursor-pointer list-none p-4 font-medium text-lovoria-deep [&::-webkit-details-marker]:hidden">Tamu tanpa undangan</summary>
					<form method="post" action={ templ.SafeURL(s.Base + "/walkin") } hx-post={ s.Base + "/walkin" } hx-target="#checkin-result" data-reset-on-success class="space-y-3 border-t border-lovoria-border p-4">
						<p class="text-sm text-lovoria-muted">Catat tamu yang datang tanpa undangan. Tercatat terpisah dari tamu undangan.</p>
						<div>
							<label for="walkin-name" class="ui-label">Nama</label>
							<input id="walkin-name" name="name" type="text" required maxlength="100" autocomplete="off" class="ui-input"/>
						</div>
						<div>
							<label for="walkin-pax" class="ui-label">Jumlah orang</label>
							<input id="walkin-pax" name="pax" type="number" inputmode="numeric" min="1" max="20" value="1" class="ui-input"/>
						</div>
						<button type="submit" class="ui-btn ui-btn-secondary w-full justify-center">Catat tamu tambahan</button>
					</form>
				</details>
			}
		</main>
	}
}

// scanStats: ringkasan kehadiran; oob=true → memperbarui baris di halaman.
templ scanStats(s scanner, oob bool) {
	<p
		id="checkin-stats"
		class="mt-2 text-sm text-lovoria-muted"
		if oob {
			hx-swap-oob="true"
		}
	>
		<span class="font-semibold text-lovoria-text">{ strconv.Itoa(s.Stats.CheckedIn) }</span> dari { strconv.Itoa(s.Stats.Invited) } undangan ·
		<span class="font-semibold text-lovoria-text">{ strconv.Itoa(s.Stats.TotalPax()) }</span> orang hadir
		if s.Stats.Walkins > 0 {
			· { strconv.Itoa(s.Stats.Walkins) } tamu tambahan
		}
	</p>
}

// scanResult: hasil pemindaian + statistik terbaru (OOB).
templ scanResult(s scanner, kind string, g Guest, via string) {
	@resultCard(s, kind, g, via)
	@scanStats(s, true)
}

// scanNote: pemberitahuan singkat (batal, tamu tambahan, kesalahan isian).
templ scanNote(s scanner, notice, errMsg string) {
	if errMsg != "" {
		<p class="ui-alert ui-alert-danger" role="alert">{ errMsg }</p>
	} else {
		<p class="ui-alert ui-alert-success" role="status">{ notice }</p>
	}
	@scanStats(s, true)
}

func checkedInTime(s scanner, g Guest) string {
	if g.CheckedInAt == nil {
		return ""
	}
	return g.CheckedInAt.In(s.Loc).Format("15.04")
}

templ guestLine(g Guest) {
	<p class="mt-1 break-words font-display text-3xl leading-tight">{ g.Name }</p>
	if g.GroupName != "" {
		<p class="mt-1 text-sm opacity-80">{ g.GroupName }</p>
	}
}

templ resultCard(s scanner, kind string, g Guest, via string) {
	switch kind {
		case resultReady:
			// data-scan-pause (semua kartu hasil): pemindai berhenti sampai penerima
			// tamu menekan tombol — QR yang masih di depan kamera tidak terbaca ulang
			// dan menimpa hasil "Selamat datang" dengan "Sudah check-in".
			<div class="rounded-3xl bg-lovoria-success p-5 text-white" data-scan-pause>
				<p class="text-sm font-semibold uppercase tracking-[0.18em]">Undangan sah</p>
				@guestLine(g)
				<form method="post" action={ templ.SafeURL(s.Base + "/confirm") } hx-post={ s.Base + "/confirm" } hx-target="#checkin-result" class="mt-4">
					<input type="hidden" name="guest_id" value={ g.ID.String() }/>
					<input type="hidden" name="via" value={ via }/>
					<label for="checkin-pax" class="block text-sm opacity-90">Jumlah orang yang datang (maks. { strconv.Itoa(max(g.MaxPax, 1)) })</label>
					<input id="checkin-pax" name="pax" type="number" inputmode="numeric" min="1" max={ strconv.Itoa(max(g.MaxPax, 1)) } value={ strconv.Itoa(g.SuggestedPax()) } class="mt-1 w-full rounded-xl border-0 bg-white px-4 py-3 text-center text-2xl font-semibold text-lovoria-deep"/>
					<button type="submit" class="mt-3 w-full rounded-xl bg-white px-6 py-4 text-lg font-semibold text-lovoria-success">Check-in</button>
				</form>
				<button type="button" data-scan-resume class="mt-2 w-full rounded-xl px-6 py-3 text-sm font-medium text-white/90 underline">Batal — pindai yang lain</button>
			</div>
		case resultDone:
			<div class="rounded-3xl bg-lovoria-success p-5 text-white" data-scan-pause>
				<p class="text-sm font-semibold uppercase tracking-[0.18em]">Selamat datang ✓</p>
				@guestLine(g)
				<p class="mt-2 text-lg">{ strconv.Itoa(g.CheckedInPax) } orang · pukul { checkedInTime(s, g) }</p>
				<button type="button" data-scan-resume class="mt-4 w-full rounded-xl bg-white px-6 py-4 text-lg font-semibold text-lovoria-success">Pindai berikutnya</button>
				<form method="post" action={ templ.SafeURL(s.Base + "/undo") } hx-post={ s.Base + "/undo" } hx-target="#checkin-result" class="mt-2 text-center">
					<input type="hidden" name="guest_id" value={ g.ID.String() }/>
					<button type="submit" class="px-3 py-2 text-sm text-white/90 underline">Salah pindai? Batalkan check-in ini</button>
				</form>
			</div>
		case resultAlready:
			<div class="rounded-3xl bg-lovoria-warning p-5 text-white" data-scan-pause>
				<p class="text-sm font-semibold uppercase tracking-[0.18em]">Sudah check-in</p>
				@guestLine(g)
				<p class="mt-2 text-lg">Undangan ini sudah dipakai pukul { checkedInTime(s, g) } · { strconv.Itoa(g.CheckedInPax) } orang.</p>
				<button type="button" data-scan-resume class="mt-4 w-full rounded-xl bg-white px-6 py-4 text-lg font-semibold text-lovoria-warning">Pindai berikutnya</button>
			</div>
		case resultClosed:
			<div class="rounded-3xl border border-lovoria-border bg-lovoria-surface p-5">
				<p class="font-display text-2xl text-lovoria-deep">Check-in belum dibuka</p>
				<p class="mt-2 text-sm leading-relaxed text-lovoria-muted">Check-in hanya bisa dilakukan saat undangan sedang terbit atau pada hari H, dan bila pasangan mengaktifkannya. Hubungi pasangan bila ini tidak sesuai.</p>
			</div>
		default:
			<div class="rounded-3xl bg-lovoria-danger p-5 text-white" data-scan-pause>
				<p class="text-sm font-semibold uppercase tracking-[0.18em]">Tidak dikenal</p>
				<p class="mt-1 font-display text-3xl leading-tight">Bukan undangan acara ini</p>
				<p class="mt-2 text-sm opacity-90">QR ini tidak terdaftar untuk pernikahan ini. Coba cari nama tamu secara manual.</p>
				<button type="button" data-scan-resume class="mt-4 w-full rounded-xl bg-white px-6 py-4 text-lg font-semibold text-lovoria-danger">Pindai berikutnya</button>
			</div>
	}
}

// searchResults: hasil cari manual — memilih tamu sama seperti memindai QR-nya.
templ searchResults(s scanner, q string, gs []Guest) {
	if len(gs) == 0 {
		if len(q) >= 2 {
			<p class="text-sm text-lovoria-muted">Tidak ada tamu bernama "{ q }".</p>
		}
	} else {
		<ul class="divide-y divide-lovoria-border">
			for _, g := range gs {
				<li class="flex items-center justify-between gap-3 py-2.5">
					<div class="min-w-0">
						<p class="break-words font-medium">{ g.Name }</p>
						<p class="text-xs text-lovoria-muted">
							if g.GroupName != "" {
								{ g.GroupName } ·
							}
							if g.CheckedInAt != nil {
								sudah check-in { checkedInTime(s, g) }
							} else {
								{ strconv.Itoa(max(g.MaxPax, 1)) } orang
							}
						</p>
					</div>
					<form method="post" action={ templ.SafeURL(s.Base + "/scan") } hx-post={ s.Base + "/scan" } hx-target="#checkin-result" class="flex-none">
						<input type="hidden" name="code" value={ g.InvitationCode }/>
						<input type="hidden" name="via" value={ ViaManual }/>
						<button type="submit" class="ui-btn ui-btn-secondary px-3 py-2 text-sm">Pilih</button>
					</form>
				</li>
			}
		</ul>
	}
}
