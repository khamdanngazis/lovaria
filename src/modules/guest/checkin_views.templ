package guest

import (
	"strconv"
	"time"

	"github.com/khamdanngazis/lovaria/src/modules/wedding"
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/src/templates/ui"
)

// checkinPage: pengaturan check-in QR di hari H (T31).
templ checkinPage(w wedding.Wedding, notice string, link CheckinLink, att attendanceState) {
	@wedding.Shell(w, "/checkin") {
		<div class="max-w-2xl space-y-4">
			@ui.Notice(notice)
			@ui.Card() {
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div class="min-w-0">
						<h2 class="font-display text-2xl leading-tight text-lovoria-deep">Check-in tamu dengan QR</h2>
						<p class="mt-2 text-sm leading-relaxed text-lovoria-muted">Untuk acara yang hanya menerima tamu berundangan: tiap tamu mendapat QR di undangan pribadinya, dan penerima tamu memindainya di pintu masuk.</p>
					</div>
					if w.CheckinEnabled {
						@ui.Badge(ui.Success, "Aktif")
					} else {
						@ui.Badge(ui.Muted, "Tidak aktif")
					}
				</div>
				<ol class="mt-5 space-y-2.5 text-sm leading-relaxed text-lovoria-text">
					<li class="flex gap-3"><span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-lovoria-primary-soft text-xs font-medium text-lovoria-primary">1</span><span>Aktifkan fitur ini. Bagian <strong>QR Kehadiran</strong> muncul di undangan pribadi tiap tamu (link <span class="font-mono text-xs">/i/KODE</span>) — bukan di link umum.</span></li>
					<li class="flex gap-3"><span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-lovoria-primary-soft text-xs font-medium text-lovoria-primary">2</span><span>Tamu menyimpan atau membuka QR-nya saat datang.</span></li>
					<li class="flex gap-3"><span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-lovoria-primary-soft text-xs font-medium text-lovoria-primary">3</span><span>Penerima tamu membuka <strong>link penerima tamu</strong> di ponselnya dan memindai QR tiap tamu yang datang.</span></li>
				</ol>
				if !w.CheckinEnabled && w.IsDraft() {
					<p class="mt-4 text-xs text-lovoria-muted">Bisa diaktifkan sekarang; QR baru tampil ke tamu setelah undangan diterbitkan.</p>
				} else if w.CheckinEnabled && !w.CheckinOpen() {
					<p class={ "mt-4", ui.AlertClass(ui.Warning) }>
						if w.IsDraft() {
							QR belum tampil ke tamu karena undangan masih draf.
						} else {
							Hari H sudah lewat: QR tidak lagi tampil di undangan. Data kehadiran tetap tersimpan.
						}
					</p>
				}
				<form
					method="post"
					action={ templ.SafeURL(w.DashboardURL("/checkin")) }
					class="mt-5"
					if w.CheckinEnabled {
						data-confirm="Matikan check-in QR? QR tidak lagi tampil di undangan tamu."
					}
				>
					@layouts.CSRFField()
					if w.CheckinEnabled {
						<input type="hidden" name="enabled" value="0"/>
						<button type="submit" class="ui-btn ui-btn-secondary">Matikan check-in QR</button>
					} else {
						<input type="hidden" name="enabled" value="1"/>
						<button type="submit" class="ui-btn ui-btn-primary">Aktifkan check-in QR</button>
					}
				</form>
			}
			if w.CheckinEnabled {
				@usherLinkCard(w, link)
				@attendanceCard(att)
				@ownerMarkCard(w)
			} else if att.Stats.CheckedIn > 0 || att.Stats.Walkins > 0 {
				// Fitur dimatikan tetapi sudah ada catatan: tetap bisa dilihat.
				@attendanceCard(att)
			}
		</div>
	}
}

func hhmm(a attendanceState, t time.Time) string { return t.In(a.Loc).Format("15.04") }

// attendanceCard: kehadiran nyata — memperbarui diri tiap 10 detik selama
// check-in dibuka (tanpa WebSocket).
templ attendanceCard(a attendanceState) {
	<div
		id="attendance"
		class="ui-card"
		if a.W.CheckinOpen() {
			hx-get={ a.W.DashboardURL("/checkin/attendance") }
			hx-trigger="every 10s"
			hx-swap="outerHTML"
		}
	>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<h2 class="font-semibold">Kehadiran</h2>
			if a.W.CheckinOpen() {
				<span class="flex items-center gap-1.5 text-xs text-lovoria-muted"><span class="h-2 w-2 rounded-full bg-lovoria-success" aria-hidden="true"></span>memperbarui otomatis</span>
			}
		</div>
		<div class="mt-3 grid grid-cols-3 gap-2">
			@attendanceStat("Undangan datang", strconv.Itoa(a.Stats.CheckedIn), "dari "+strconv.Itoa(a.Stats.Invited))
			@attendanceStat("Orang hadir", strconv.Itoa(a.Stats.TotalPax()), "termasuk tamu tambahan")
			@attendanceStat("Tamu tambahan", strconv.Itoa(a.Stats.Walkins), strconv.Itoa(a.Stats.WalkinPax)+" orang")
		</div>
		if len(a.Recent) == 0 && len(a.Walkins) == 0 {
			<p class="mt-4 text-sm text-lovoria-muted">Belum ada tamu yang check-in.</p>
		}
		if len(a.Recent) > 0 {
			<h3 class="mt-5 text-xs font-medium uppercase tracking-wide text-lovoria-muted">Check-in terbaru</h3>
			<ul class="mt-1 divide-y divide-lovoria-border text-sm">
				for _, g := range a.Recent {
					<li class="flex items-center justify-between gap-3 py-2.5">
						<div class="min-w-0">
							<p class="break-words font-medium">{ g.Name }</p>
							<p class="text-xs text-lovoria-muted">{ hhmm(a, *g.CheckedInAt) } · { strconv.Itoa(g.CheckedInPax) } orang · { ViaLabel(g.CheckedInVia) }</p>
						</div>
						<form method="post" action={ templ.SafeURL(a.W.DashboardURL("/checkin/mark")) } data-confirm={ "Batalkan check-in " + g.Name + "?" } class="flex-none">
							@layouts.CSRFField()
							<input type="hidden" name="guest_id" value={ g.ID.String() }/>
							<input type="hidden" name="undo" value="1"/>
							<button type="submit" class="text-xs text-lovoria-muted hover:text-lovoria-danger hover:underline">Batalkan</button>
						</form>
					</li>
				}
			</ul>
		}
		if len(a.Walkins) > 0 {
			<h3 class="mt-5 text-xs font-medium uppercase tracking-wide text-lovoria-muted">Tamu tambahan (tanpa undangan)</h3>
			<ul class="mt-1 divide-y divide-lovoria-border text-sm">
				for _, wk := range a.Walkins {
					<li class="flex items-center justify-between gap-3 py-2.5">
						<div class="min-w-0">
							<p class="break-words font-medium">{ wk.Name }</p>
							<p class="text-xs text-lovoria-muted">{ hhmm(a, wk.CreatedAt) } · { strconv.Itoa(wk.Pax) } orang</p>
						</div>
						<form method="post" action={ templ.SafeURL(a.W.DashboardURL("/checkin/walkins/" + wk.ID.String() + "/delete")) } data-confirm={ "Hapus catatan " + wk.Name + "?" } class="flex-none">
							@layouts.CSRFField()
							<button type="submit" class="text-xs text-lovoria-muted hover:text-lovoria-danger hover:underline">Hapus</button>
						</form>
					</li>
				}
			</ul>
		}
		<p class="mt-4 border-t border-lovoria-border pt-3 text-xs text-lovoria-muted">
			Rincian per tamu ada di <a href={ templ.SafeURL(a.W.DashboardURL("/guests")) } class="ui-link">Daftar tamu</a> dan ikut di
			<a href={ templ.SafeURL(a.W.DashboardURL("/guests/export")) } class="ui-link">ekspor CSV</a> (kolom kehadiran).
		</p>
	</div>
}

templ attendanceStat(label, value, sub string) {
	<div class="rounded-xl bg-lovoria-bg px-3 py-2.5">
		<p class="text-xs text-lovoria-muted">{ label }</p>
		<p class="font-display text-2xl leading-tight text-lovoria-deep">{ value }</p>
		<p class="text-xs text-lovoria-muted">{ sub }</p>
	</div>
}

// ownerMarkCard: pasangan menandai kedatangan secara manual (tanpa pemindai).
templ ownerMarkCard(w wedding.Wedding) {
	@ui.Card() {
		<h2 class="font-semibold">Tandai datang secara manual</h2>
		<p class="mt-1 text-sm text-lovoria-muted">Untuk merapikan catatan: cari tamu, lalu tandai datang.</p>
		<label for="owner-checkin-q" class="ui-label mt-3">Nama tamu atau kode undangan</label>
		<input
			id="owner-checkin-q"
			name="q"
			type="search"
			autocomplete="off"
			class="ui-input"
			placeholder="mis. Budi"
			hx-get={ w.DashboardURL("/checkin/search") }
			hx-trigger="input changed delay:350ms, search"
			hx-target="#owner-checkin-results"
		/>
		<div id="owner-checkin-results" class="mt-3"></div>
	}
}

templ ownerSearchResults(w wedding.Wedding, q string, gs []Guest, loc *time.Location) {
	if len(gs) == 0 {
		if len(q) >= 2 {
			<p class="text-sm text-lovoria-muted">Tidak ada tamu bernama "{ q }".</p>
		}
	} else {
		<ul class="divide-y divide-lovoria-border text-sm">
			for _, g := range gs {
				<li class="flex items-center justify-between gap-3 py-2.5">
					<div class="min-w-0">
						<p class="break-words font-medium">{ g.Name }</p>
						<p class="text-xs text-lovoria-muted">
							if g.CheckedInAt != nil {
								sudah datang { g.CheckedInAt.In(loc).Format("15.04") } · { strconv.Itoa(g.CheckedInPax) } orang
							} else {
								belum datang · { strconv.Itoa(g.SuggestedPax()) } orang
							}
						</p>
					</div>
					<form method="post" action={ templ.SafeURL(w.DashboardURL("/checkin/mark")) } class="flex-none">
						@layouts.CSRFField()
						<input type="hidden" name="guest_id" value={ g.ID.String() }/>
						if g.CheckedInAt != nil {
							<input type="hidden" name="undo" value="1"/>
							<button type="submit" class="ui-btn ui-btn-secondary px-3 py-2 text-sm">Batalkan</button>
						} else {
							<button type="submit" class="ui-btn ui-btn-primary px-3 py-2 text-sm">Tandai datang</button>
						}
					</form>
				</li>
			}
		</ul>
	}
}

// usherLinkCard: link halaman pemindai untuk penerima tamu (tanpa akun).
templ usherLinkCard(w wedding.Wedding, link CheckinLink) {
	@ui.Card() {
		<h2 class="font-semibold">Link penerima tamu</h2>
		<p class="mt-1 text-sm leading-relaxed text-lovoria-muted">Bagikan link ini ke orang yang bertugas di pintu masuk. Mereka bisa memindai QR tanpa akun Lunovia dan hanya melihat nama, grup, dan jumlah orang tiap tamu. Siapa pun yang memegang link ini bisa mencatat check-in, jadi bagikan seperlunya.</p>
		if link.URL != "" {
			<div class="mt-4 flex items-center gap-2" x-data={ templ.JSFuncCall("copyText", link.URL).CallInline }>
				<input type="text" readonly value={ link.URL } aria-label="Link penerima tamu" class="ui-control min-w-0 flex-1 bg-lovoria-bg px-3 py-2 text-sm text-lovoria-text" data-select-on-focus/>
				<button type="button" x-cloak @click="copy()" class="ui-btn ui-btn-secondary flex-none px-3 py-2 text-sm" x-text="copied ? 'Tersalin ✓' : 'Salin'">Salin</button>
			</div>
			<div class="mt-3 flex flex-wrap gap-2">
				<a href={ templ.SafeURL(link.URL) } target="_blank" rel="noopener" class="ui-btn ui-btn-primary px-4 py-2.5 text-sm">Buka pemindai ↗</a>
				<a href={ templ.SafeURL(WhatsAppURL("", "Link check-in tamu "+w.Title+": "+link.URL)) } target="_blank" rel="noopener" class="ui-btn ui-btn-secondary px-4 py-2.5 text-sm">Kirim lewat WhatsApp</a>
			</div>
			<div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-t border-lovoria-border pt-4 text-sm">
				<form method="post" action={ templ.SafeURL(w.DashboardURL("/checkin/link")) } data-confirm="Buat link baru? Link yang sekarang langsung tidak berlaku.">
					@layouts.CSRFField()
					<input type="hidden" name="action" value="new"/>
					<button type="submit" class="text-lovoria-primary hover:underline">Buat link baru</button>
				</form>
				<form method="post" action={ templ.SafeURL(w.DashboardURL("/checkin/link")) } data-confirm="Cabut link penerima tamu? Halaman pemindai tidak bisa dibuka lagi.">
					@layouts.CSRFField()
					<input type="hidden" name="action" value="revoke"/>
					<button type="submit" class="text-lovoria-danger hover:underline">Cabut link</button>
				</form>
			</div>
		} else {
			<form method="post" action={ templ.SafeURL(w.DashboardURL("/checkin/link")) } class="mt-4">
				@layouts.CSRFField()
				<input type="hidden" name="action" value="new"/>
				<button type="submit" class="ui-btn ui-btn-primary">Buat link penerima tamu</button>
			</form>
		}
	}
}
