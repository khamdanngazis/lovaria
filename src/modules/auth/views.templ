package auth

import (
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/src/templates/ui"
)

// form menampung nilai input & pesan error untuk dirender ulang.
type form struct {
	Values  map[string]string
	Errors  map[string]string
	Message string // error umum (mis. kredensial salah)
	Next    string
}

func (f form) v(name string) string { return f.Values[name] }
func (f form) e(name string) string { return f.Errors[name] }

type fieldSpec struct {
	Form         string // prefix id, mis. "register"
	Name         string
	Label        string
	Type         string
	Autocomplete string
	Validate     bool // validasi inline saat blur
	// Include: selector kolom lain yang ikut dikirim saat validasi inline
	// (mis. konfirmasi password perlu nilai password).
	Include string
}

// Teks panel brand halaman auth (di satu tempat supaya mudah disunting).
const (
	authTagline = "Your Love. Your Story. Your Forever."
	authLead    = "Website & undangan pernikahan digital yang personal — cerita cinta, RSVP, ucapan, dan kenangan dalam satu tempat."
)

// authBenefits: poin manfaat di halaman daftar — hanya fitur yang sudah ada.
var authBenefits = []string{
	"Undangan digital dengan link pribadi untuk setiap tamu",
	"RSVP, ucapan & doa, dan amplop digital dalam satu halaman",
	"Halaman kenangan tetap bisa dibuka setelah hari bahagia",
}

// authShell: kerangka login / daftar / lupa & reset password (T22). ≥ 1024px:
// panel brand Deep Plum di kiri + form di kanan; di bawahnya satu kolom dengan
// logo & tagline di atas kartu form. benefits: tampilkan poin manfaat (daftar).
templ authShell(title string, benefits bool) {
	@layouts.Document(layouts.Meta{Title: title}, layouts.BrandFonts(false), layouts.BrandBody) {
		<div class="min-h-dvh lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
			<aside class="relative hidden overflow-hidden bg-lovoria-deep text-white lg:flex lg:flex-col lg:justify-between lg:p-14 xl:p-20">
				@layouts.BrandMark("pointer-events-none absolute -bottom-24 -right-20 h-[28rem] w-auto text-white/[0.04]")
				<a href="/" aria-label="Lovoria — beranda" class="relative inline-block self-start text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">
					@layouts.BrandLogo("")
				</a>
				<div class="relative">
					@layouts.Sparkle("h-4 w-4 text-lovoria-accent")
					<p class="mt-6 font-display text-5xl leading-[1.15] xl:text-6xl">
						Your Love.
						<br/>
						Your Story.
						<br/>
						<span class="italic text-lovoria-accent">Your Forever.</span>
					</p>
					<div class="mt-8 h-px w-16 bg-lovoria-accent" aria-hidden="true"></div>
					<p class="mt-8 max-w-md leading-relaxed text-white/80">{ authLead }</p>
					if benefits {
						<ul class="mt-8 max-w-md space-y-3 text-sm text-white/90">
							for _, b := range authBenefits {
								<li class="flex gap-3">
									@layouts.Sparkle("mt-1 h-3 w-3 flex-none text-lovoria-accent")
									<span>{ b }</span>
								</li>
							}
						</ul>
					}
				</div>
				<p class="relative text-xs text-white/60">Romantic · Elegant · Modern · Timeless</p>
			</aside>
			<div class="flex min-h-dvh flex-col px-4 py-8 sm:py-12">
				<div class="text-center lg:hidden">
					<a href="/" aria-label="Lovoria — beranda" class="inline-block text-lovoria-primary">
						@layouts.BrandLogo("")
					</a>
					<p class="mt-3 font-display text-lg italic text-lovoria-accent-ink">{ authTagline }</p>
				</div>
				<main class="mx-auto my-auto w-full max-w-sm py-8">
					<div class="ui-card">
						<h1 class="font-display text-2xl text-lovoria-deep">{ title }</h1>
						{ children... }
					</div>
					if benefits {
						<ul class="mt-6 space-y-2 px-1 text-sm text-lovoria-muted lg:hidden">
							for _, b := range authBenefits {
								<li class="flex gap-2.5">
									@layouts.Sparkle("mt-1 h-3 w-3 flex-none text-lovoria-accent")
									<span>{ b }</span>
								</li>
							}
						</ul>
					}
				</main>
				@layouts.LegalLinks("")
			</div>
		</div>
	}
}

templ field(f form, s fieldSpec) {
	<div>
		<label for={ s.Form + "-" + s.Name } class="ui-label">{ s.Label }</label>
		<input
			id={ s.Form + "-" + s.Name }
			name={ s.Name }
			type={ s.Type }
			autocomplete={ s.Autocomplete }
			if s.Type != "password" {
				value={ f.v(s.Name) }
			}
			required
			class="ui-input"
			if f.e(s.Name) != "" {
				aria-invalid="true"
			}
			aria-describedby={ s.Form + "-" + s.Name + "-error" }
			if s.Validate {
				hx-post={ "/" + s.Form + "/validate" }
				hx-vals={ `{"field":"` + s.Name + `"}` }
				hx-trigger="blur changed"
				hx-target={ "#" + s.Form + "-" + s.Name + "-error" }
				hx-swap="outerHTML"
				hx-sync="closest form:abort"
				if s.Include != "" {
					hx-include={ s.Include }
				}
			}
		/>
		@fieldError(s.Form, s.Name, f.e(s.Name))
	</div>
}

templ fieldError(formID, name, msg string) {
	<p id={ formID + "-" + name + "-error" } class="ui-error min-h-5">{ msg }</p>
}

templ formMessage(msg string) {
	if msg != "" {
		<p class={ ui.AlertClass(ui.Danger) } role="alert">{ msg }</p>
	}
}

templ submitButton(label string) {
	<button type="submit" class="ui-btn ui-btn-primary w-full">
		{ label }
	</button>
}

// ---------- Login ----------
templ loginPage(f form, notice string) {
	@authShell("Masuk", false) {
		if notice != "" {
			<p class={ "mt-4", ui.AlertClass(ui.Success) } role="status">{ notice }</p>
		}
		@loginForm(f)
		<div class="mt-4 space-y-1 text-center text-sm text-lovoria-muted">
			<p><a href="/forgot-password" class="ui-link">Lupa password?</a></p>
			<p>Belum punya akun? <a href="/register" class="ui-link">Daftar</a></p>
		</div>
	}
}

templ loginForm(f form) {
	<form method="post" action="/login" hx-post="/login" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button" class="mt-4 space-y-3">
		@layouts.CSRFField()
		<input type="hidden" name="next" value={ f.Next }/>
		@formMessage(f.Message)
		@field(f, fieldSpec{Form: "login", Name: "email", Label: "Email", Type: "email", Autocomplete: "email"})
		@field(f, fieldSpec{Form: "login", Name: "password", Label: "Password", Type: "password", Autocomplete: "current-password"})
		@submitButton("Masuk")
	</form>
}

// ---------- Register ----------
templ registerPage(f form) {
	@authShell("Buat akun", true) {
		@registerForm(f)
		<p class="mt-4 text-center text-sm text-lovoria-muted">
			Sudah punya akun? <a href="/login" class="ui-link">Masuk</a>
		</p>
	}
}

templ registerForm(f form) {
	// hx-disinherit: validasi inline per kolom (hx-post di input) tidak mewarisi
	// hx-disabled-elt form — "find button" tidak ada di dalam input (error console).
	<form method="post" action="/register" hx-post="/register" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button" hx-disinherit="hx-disabled-elt" class="mt-4 space-y-3">
		@layouts.CSRFField()
		@formMessage(f.Message)
		@field(f, fieldSpec{Form: "register", Name: "name", Label: "Nama", Type: "text", Autocomplete: "name", Validate: true})
		@field(f, fieldSpec{Form: "register", Name: "email", Label: "Email", Type: "email", Autocomplete: "email", Validate: true})
		@field(f, fieldSpec{Form: "register", Name: "password", Label: "Password (min. 8 karakter)", Type: "password", Autocomplete: "new-password", Validate: true})
		@field(f, fieldSpec{Form: "register", Name: "password_confirmation", Label: "Ulangi password", Type: "password", Autocomplete: "new-password", Validate: true, Include: "#register-password"})
		@submitButton("Daftar")
	</form>
}

// ---------- Lupa password ----------
templ forgotPage(f form) {
	@authShell("Lupa password", false) {
		@forgotForm(f)
		<p class="mt-4 text-center text-sm text-lovoria-muted">
			<a href="/login" class="ui-link">Kembali ke halaman masuk</a>
		</p>
	}
}

templ forgotForm(f form) {
	<form method="post" action="/forgot-password" hx-post="/forgot-password" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button" class="mt-4 space-y-3">
		@layouts.CSRFField()
		<p class="text-sm text-lovoria-muted">Masukkan email akunmu. Kami kirim link untuk membuat password baru.</p>
		@formMessage(f.Message)
		@field(f, fieldSpec{Form: "forgot", Name: "email", Label: "Email", Type: "email", Autocomplete: "email"})
		@submitButton("Kirim link reset")
	</form>
}

templ forgotSent() {
	<div class={ "mt-4", ui.AlertClass(ui.Success) } role="status">
		Jika email tersebut terdaftar, link reset password sudah dikirim. Link berlaku 1 jam.
	</div>
}

templ forgotSentPage() {
	@authShell("Lupa password", false) {
		@forgotSent()
		<p class="mt-4 text-center text-sm"><a href="/login" class="ui-link">Kembali ke halaman masuk</a></p>
	}
}

// ---------- Reset password ----------
templ resetPage(f form, token string) {
	@authShell("Buat password baru", false) {
		@resetForm(f, token)
	}
}

templ resetForm(f form, token string) {
	<form method="post" action="/reset-password" hx-post="/reset-password" hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button" class="mt-4 space-y-3">
		@layouts.CSRFField()
		<input type="hidden" name="token" value={ token }/>
		@formMessage(f.Message)
		@field(f, fieldSpec{Form: "reset", Name: "password", Label: "Password baru (min. 8 karakter)", Type: "password", Autocomplete: "new-password"})
		@submitButton("Simpan password")
	</form>
}

templ resetInvalidPage() {
	@authShell("Link tidak valid", false) {
		<p class="mt-4 text-sm text-lovoria-muted">Link reset password tidak valid atau sudah kedaluwarsa.</p>
		<p class="mt-4 text-sm"><a href="/forgot-password" class="ui-link">Minta link baru</a></p>
	}
}

templ tooManyRequests() {
	<p class={ ui.AlertClass(ui.Warning) } role="alert">
		Terlalu banyak percobaan. Coba lagi dalam beberapa menit.
	</p>
}
