package example

templ noteList(notes []Note) {
	<ul id="notes" class="space-y-2">
		for _, n := range notes {
			@noteItem(n)
		}
	</ul>
}

templ noteItem(n Note) {
	<li class="rounded border border-lovoria-border bg-lovoria-surface px-3 py-2" data-note-id={ n.ID }>{ n.Body }</li>
}

templ noteError(msg string) {
	<p class="text-sm text-lovoria-danger" role="alert">{ msg }</p>
}
