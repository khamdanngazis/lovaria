package example

templ noteList(notes []Note) {
	<ul id="notes" class="space-y-2">
		for _, n := range notes {
			@noteItem(n)
		}
	</ul>
}

templ noteItem(n Note) {
	<li class="rounded border border-slate-200 bg-white px-3 py-2" data-note-id={ n.ID }>{ n.Body }</li>
}

templ noteError(msg string) {
	<p class="text-sm text-red-600" role="alert">{ msg }</p>
}
