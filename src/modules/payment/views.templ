package payment

import (
	"fmt"
	"strings"

	"github.com/khamdanngazis/lovaria/src/modules/wedding"
	"github.com/khamdanngazis/lovaria/src/platform/web"
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/src/templates/ui"
)

// publishState: data halaman publikasi & status pembayaran.
type publishState struct {
	W         wedding.Wedding
	Price     int64
	Enabled   bool // gateway terpasang
	Summary   Summary
	Checklist []wedding.ChecklistItem
	Orders    []Order
	Error     string
}

func (s publishState) ready() bool {
	for _, it := range s.Checklist {
		if !it.Done {
			return false
		}
	}
	return true
}

// Rupiah: 149000 → "Rp149.000".
func Rupiah(n int64) string {
	d := fmt.Sprint(n)
	var b strings.Builder
	for i, r := range d {
		if i > 0 && (len(d)-i)%3 == 0 {
			b.WriteByte('.')
		}
		b.WriteRune(r)
	}
	return "Rp" + b.String()
}

// Features: yang didapat dengan sekali bayar — hanya fitur yang sudah ada.
var Features = []string{
	"Semua tema undangan & kustomisasi warna, huruf, sampul",
	"Cerita cinta, acara, peta & simpan ke kalender",
	"Galeri foto",
	"RSVP dan buku ucapan & doa",
	"Amplop digital",
	"Link pribadi per tamu & kirim lewat WhatsApp",
	"Custom domain dengan HTTPS",
	"Halaman kenangan setelah hari bahagia",
}

// StatusLabel / statusVariant: label & warna status order (selalu dengan teks).
func StatusLabel(status string) string {
	switch status {
	case StatusPending:
		return "Menunggu pembayaran"
	case StatusPaid:
		return "Lunas"
	case StatusExpired:
		return "Kedaluwarsa"
	case StatusFailed:
		return "Gagal"
	case StatusCancelled:
		return "Dibatalkan"
	}
	return status
}

func statusVariant(status string) string {
	switch status {
	case StatusPaid:
		return ui.Success
	case StatusPending:
		return ui.Warning
	case StatusFailed:
		return ui.Danger
	}
	return ui.Muted
}

templ publishPage(s publishState) {
	@wedding.Shell(s.W, "") {
		<div class="mx-auto max-w-2xl space-y-4">
			@ui.Alert(s.Error)
			if s.W.IsPaid() {
				@paidCard(s)
			} else {
				@offerCard(s)
			}
			@orderHistory(s)
		</div>
	}
}

// offerCard: belum lunas — harga, yang didapat, dan tombol bayar.
templ offerCard(s publishState) {
	<div class="ui-card">
		<p class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.2em] text-lovoria-accent-ink">
			@layouts.Sparkle("h-3 w-3 text-lovoria-accent")
			Publikasikan undangan
		</p>
		<h2 class="mt-3 font-display text-3xl text-lovoria-deep">Siap dibagikan ke tamu?</h2>
		<p class="mt-2 text-sm text-lovoria-muted">Membuat, mengubah, dan melihat pratinjau undangan tetap gratis. Pembayaran hanya sekali, saat undangan dipublikasikan.</p>
		<p class="mt-2 text-sm"><a href={ templ.SafeURL(s.W.DashboardURL("/theme/preview")) } target="_blank" rel="noopener" class="ui-link">Lihat pratinjau sekali lagi ↗</a></p>
		<div class="mt-6 flex flex-wrap items-end gap-x-3 gap-y-1 border-y border-lovoria-border py-5">
			<p class="font-display text-5xl leading-none text-lovoria-primary">{ Rupiah(s.Price) }</p>
			<p class="pb-1 text-sm text-lovoria-muted">sekali bayar per undangan · tanpa langganan</p>
		</div>
		<ul class="mt-5 grid gap-2.5 text-sm sm:grid-cols-2">
			for _, f := range Features {
				<li class="flex gap-2.5">
					@layouts.Sparkle("mt-1 h-3 w-3 flex-none text-lovoria-accent")
					<span>{ f }</span>
				</li>
			}
		</ul>
		if latest := s.Summary.Latest; latest != nil && !s.Summary.Payable && latest.Status != StatusPaid {
			<p class={ "mt-6", ui.AlertClass(ui.Warning) } role="status">
				Pembayaran sebelumnya ({ latest.Number }) berstatus { strings.ToLower(StatusLabel(latest.Status)) }. Silakan coba lagi — undangan Anda tetap tersimpan.
			</p>
		}
		<div class="mt-6">
			if !s.Enabled {
				<p class={ ui.AlertClass(ui.Info) } role="status">Pembayaran belum tersedia saat ini. Undangan tetap bisa disunting dan dipratinjau.</p>
			} else if s.Summary.Payable {
				<p class="text-sm text-lovoria-muted">Ada pembayaran yang belum selesai ({ s.Summary.Latest.Number }), berlaku sampai { web.FormatDateID(s.Summary.Latest.ExpiredAt) } { s.Summary.Latest.ExpiredAt.In(jakarta).Format("15.04") } WIB.</p>
				// Tautan langsung ke halaman bayar gateway (bukan form): tidak
				// bergantung pada redirect setelah POST. Dibuka di tab baru; tab ini
				// pindah ke halaman status (data-then, lovoria.js).
				<a href={ templ.SafeURL(s.Summary.Latest.CheckoutURL) } target="_blank" rel="noopener" data-then={ s.W.DashboardURL("/payment/return") } class="ui-btn ui-btn-primary mt-3 w-full px-6 py-3 sm:w-auto">Lanjutkan pembayaran ↗</a>
			} else {
				// Halaman bayar gateway dibuka di TAB BARU (target=_blank) supaya
				// dashboard tidak tertutup; tab ini pindah ke halaman status yang
				// memperbarui diri (data-then, lovoria.js). Tanpa JS: tab baru tetap
				// terbuka, tab ini tetap di sini.
				<form method="post" action={ templ.SafeURL(s.W.DashboardURL("/payment")) } target="_blank" rel="noopener" data-then={ s.W.DashboardURL("/payment/return") }>
					@layouts.CSRFField()
					<button type="submit" class="ui-btn ui-btn-primary w-full px-6 py-3 sm:w-auto">Bayar &amp; Publikasikan</button>
				</form>
				<p class="mt-3 text-xs text-lovoria-muted">Halaman pembayaran aman (QRIS, transfer bank/virtual account, e-wallet) dibuka di tab baru. Halaman ini tetap terbuka dan memperbarui status pembayaran secara otomatis.</p>
			}
		</div>
	</div>
}

// paidCard: sudah lunas — publikasikan (atau tautan bila sudah terbit).
templ paidCard(s publishState) {
	<div class="ui-card">
		<div class="flex flex-wrap items-center gap-3">
			@ui.Badge(ui.Success, "Lunas ✓")
			<p class="text-sm text-lovoria-muted">Pembayaran diterima. Semua fitur terbuka untuk undangan ini.</p>
		</div>
		if s.W.IsDraft() {
			<h2 class="mt-4 font-display text-2xl text-lovoria-deep">Publikasikan undangan</h2>
			<p class="mt-1 text-sm text-lovoria-muted">Setelah dipublikasikan, tamu yang punya link bisa membuka undangan.</p>
			<ul class="mt-4 space-y-1 text-sm" aria-label="Syarat publikasi">
				for _, it := range s.Checklist {
					<li class={ "flex items-center gap-2", templ.KV("text-lovoria-success", it.Done), templ.KV("text-lovoria-text", !it.Done) }>
						if it.Done {
							<span aria-hidden="true">✓</span><span class="sr-only">Sudah:</span>
						} else {
							<span aria-hidden="true" class="text-lovoria-danger">✗</span><span class="sr-only">Belum:</span>
						}
						{ it.Label }
					</li>
				}
			</ul>
			<form method="post" action={ templ.SafeURL(s.W.DashboardURL("/status")) } class="mt-5" data-confirm="Publikasikan undangan? Tamu yang punya link bisa membukanya.">
				@layouts.CSRFField()
				<input type="hidden" name="_method" value="PATCH"/>
				<input type="hidden" name="status" value="published"/>
				<button type="submit" disabled?={ !s.ready() } class="ui-btn ui-btn-primary w-full px-6 py-3 sm:w-auto">Publikasikan</button>
			</form>
			if !s.ready() {
				<p class="mt-2 text-xs text-lovoria-muted">Lengkapi syarat di atas dulu, lalu publikasikan — tidak perlu membayar lagi.</p>
			}
		} else {
			<h2 class="mt-4 font-display text-2xl text-lovoria-deep">Undangan sudah dipublikasikan</h2>
			<div class="mt-4 flex flex-wrap gap-2">
				<a href={ templ.SafeURL("/w/" + s.W.Slug) } target="_blank" rel="noopener" class="ui-btn ui-btn-primary">Lihat undangan ↗</a>
				<a href={ templ.SafeURL(s.W.DashboardURL("/share")) } class="ui-btn ui-btn-secondary">Bagikan undangan</a>
			</div>
		}
	</div>
}

templ orderHistory(s publishState) {
	if len(s.Orders) > 0 {
		<details class="ui-card text-sm" open?={ !s.W.IsPaid() && len(s.Orders) > 1 }>
			<summary class="cursor-pointer font-medium">Riwayat pembayaran</summary>
			<div class="mt-3 overflow-x-auto">
				<table class="ui-table">
					<thead>
						<tr><th>No. order</th><th>Tanggal</th><th>Jumlah</th><th>Status</th></tr>
					</thead>
					<tbody>
						for _, o := range s.Orders {
							<tr>
								<td class="whitespace-nowrap font-mono text-xs">{ o.Number }</td>
								<td class="whitespace-nowrap">{ web.FormatDateID(o.CreatedAt) }</td>
								<td class="whitespace-nowrap">{ Rupiah(o.Amount) }</td>
								<td>
									@ui.Badge(statusVariant(o.Status), StatusLabel(o.Status))
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</details>
	}
}

// returnPage: kembali dari gateway — menampilkan status dan memeriksa ulang
// selagi pembayaran masih diproses.
templ returnPage(s publishState) {
	@wedding.Shell(s.W, "") {
		<div class="mx-auto max-w-2xl space-y-4">
			@paymentStatus(s)
		</div>
	}
}

// paymentStatus: fragmen status (htmx memuat ulang tiap beberapa detik selama
// pembayaran masih menunggu konfirmasi gateway).
templ paymentStatus(s publishState) {
	<div
		id="payment-status"
		class="ui-card"
		if !s.W.IsPaid() && s.Summary.Latest != nil && s.Summary.Latest.Status == StatusPending {
			hx-get={ s.W.DashboardURL("/payment/return") }
			hx-trigger="every 4s"
			hx-swap="outerHTML"
		}
	>
		switch  {
			case s.W.IsPaid():
				@ui.Badge(ui.Success, "Lunas ✓")
				<h2 class="mt-3 font-display text-3xl text-lovoria-deep">Pembayaran berhasil</h2>
				<p class="mt-2 text-sm text-lovoria-muted">Terima kasih! Undangan Anda siap dipublikasikan.</p>
				<a href={ templ.SafeURL(s.W.DashboardURL("/publish")) } class="ui-btn ui-btn-primary mt-5">Lanjut publikasikan</a>
			case s.Summary.Latest != nil && s.Summary.Latest.Status == StatusPending:
				@ui.Badge(ui.Warning, "Menunggu pembayaran")
				<h2 class="mt-3 font-display text-3xl text-lovoria-deep">Menunggu konfirmasi</h2>
				<p class="mt-2 text-sm text-lovoria-muted" role="status">Selesaikan pembayaran { s.Summary.Latest.Number } di tab pembayaran. Halaman ini diperbarui otomatis begitu pembayaran diterima — QRIS dan e-wallet biasanya dalam beberapa detik, transfer bank bisa lebih lama.</p>
				<div class="mt-5 flex flex-wrap gap-2">
					if s.Summary.Payable {
						<a href={ templ.SafeURL(s.Summary.Latest.CheckoutURL) } target="_blank" rel="noopener" class="ui-btn ui-btn-primary">Buka halaman pembayaran ↗</a>
					}
					<a href={ templ.SafeURL(s.W.DashboardURL("/payment/return")) } class="ui-btn ui-btn-secondary">Periksa lagi</a>
				</div>
				@layouts.SupportHint("mt-5")
			default:
				if s.Summary.Latest != nil {
					@ui.Badge(statusVariant(s.Summary.Latest.Status), StatusLabel(s.Summary.Latest.Status))
				}
				<h2 class="mt-3 font-display text-3xl text-lovoria-deep">Pembayaran belum berhasil</h2>
				<p class="mt-2 text-sm text-lovoria-muted">Tidak ada dana yang ditagihkan untuk percobaan ini. Undangan Anda tetap tersimpan — silakan coba lagi.</p>
				<a href={ templ.SafeURL(s.W.DashboardURL("/publish")) } class="ui-btn ui-btn-primary mt-5">Coba lagi</a>
				@layouts.SupportHint("mt-5")
		}
	</div>
}

// fakeCheckoutPage: halaman bayar simulasi (gateway "fake", dev/test saja).
templ fakeCheckoutPage(o Order) {
	@layouts.Public(layouts.Meta{Title: "Simulasi pembayaran"}) {
		<section class="py-12">
			<p class={ ui.AlertClass(ui.Warning) } role="note">Mode simulasi — tidak ada uang sungguhan. Hanya tersedia di development/test.</p>
			<div class="ui-card mt-4">
				<p class="text-xs uppercase tracking-wide text-lovoria-muted">Order</p>
				<p class="font-mono text-sm">{ o.Number }</p>
				<p class="mt-4 font-display text-4xl text-lovoria-primary">{ Rupiah(o.Amount) }</p>
				<form method="post" action={ templ.SafeURL(FakeCheckoutPath + o.Number) } class="mt-6 flex flex-wrap gap-2">
					@layouts.CSRFField()
					<button type="submit" name="result" value={ StatusPaid } class="ui-btn ui-btn-primary">Simulasikan berhasil</button>
					<button type="submit" name="result" value={ StatusFailed } class="ui-btn ui-btn-secondary">Simulasikan gagal</button>
					<button type="submit" name="result" value={ StatusExpired } class="ui-btn ui-btn-secondary">Simulasikan kedaluwarsa</button>
				</form>
			</div>
		</section>
	}
}
