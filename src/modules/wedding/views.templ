package wedding

import (
	"fmt"
	"time"

	"github.com/khamdanngazis/lovaria/src/platform/web"
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/src/templates/ui"
)

// form menampung nilai & error input untuk dirender ulang.
type form struct {
	Values  map[string]string
	Errors  map[string]string
	Message string
	Notice  string
}

func (f form) v(k string) string { return f.Values[k] }
func (f form) e(k string) string { return f.Errors[k] }

func weddingURL(w Wedding, suffix string) string {
	return w.DashboardURL(suffix)
}

func deref(s *string) string {
	if s == nil {
		return ""
	}
	return *s
}

func timezoneOptions() []ui.Option {
	out := make([]ui.Option, len(Timezones))
	for i, tz := range Timezones {
		out[i] = ui.Option{Value: tz.ID, Label: tz.Label}
	}
	return out
}

// ---------- Setup wizard (T29: pilih tema → nama & tanggal) ----------

const wizardSteps = 2

var stepTitles = [...]string{"", "Pilih tema", "Nama & tanggal"}

templ newPage(step int, f form, themes []ThemeChoice) {
	@layouts.Dashboard(layouts.Meta{Title: "Buat undangan"}) {
		<div class="mx-auto max-w-3xl">
			<h1 class="font-display text-2xl leading-tight text-lovoria-deep sm:text-3xl">Buat undangan pernikahan</h1>
			<p class="mt-1 text-lovoria-muted">Gratis dibuat dan dipratinjau — bayar hanya saat undangan diterbitkan.</p>
			<div class="mt-6">
				@wizardStep(step, f, themes)
			</div>
		</div>
	}
}

templ wizardProgress(step int) {
	<ol class="mb-5 flex gap-2" aria-label="Langkah">
		for i := 1; i <= wizardSteps; i++ {
			<li class="flex-1">
				<span
					class={ "block h-1.5 rounded-full", templ.KV("bg-lovoria-primary", i <= step), templ.KV("bg-lovoria-border", i > step) }
					if i == step {
						aria-current="step"
					}
				></span>
				<span class={ "mt-1 block text-xs", templ.KV("text-lovoria-text font-medium", i == step), templ.KV("text-lovoria-muted", i != step) }>
					{ fmt.Sprintf("%d. %s", i, stepTitles[i]) }
				</span>
			</li>
		}
	</ol>
}

// hiddenExcept membawa nilai langkah lain di form (wizard stateless).
templ hiddenExcept(f form, visible ...string) {
	for _, k := range wizardFields {
		if !contains(visible, k) {
			<input type="hidden" name={ k } value={ f.v(k) }/>
		}
	}
}

func contains(list []string, s string) bool {
	for _, x := range list {
		if x == s {
			return true
		}
	}
	return false
}

// themesOf: tema koleksi utama (regional=false) atau Koleksi Daerah (true).
func themesOf(list []ThemeChoice, regional bool) []ThemeChoice {
	var out []ThemeChoice
	for _, t := range list {
		if (t.Region != "") == regional {
			out = append(out, t)
		}
	}
	return out
}

// themeName: nama tema terpilih (ringkasan di langkah 2).
func themeName(list []ThemeChoice, id string) string {
	for _, t := range list {
		if t.ID == id {
			return t.Name
		}
	}
	return ""
}

templ wizardStep(step int, f form, themes []ThemeChoice) {
	<div id="wizard-step" class={ templ.KV("mx-auto max-w-lg", step != 1) }>
		@ui.Card() {
			if len(themes) > 0 {
				@wizardProgress(step)
			}
			<form
				method="post"
				if step < wizardSteps {
					action={ templ.SafeURL(fmt.Sprintf("/dashboard/weddings/new/steps/%d", step)) }
					hx-post={ fmt.Sprintf("/dashboard/weddings/new/steps/%d", step) }
				} else {
					action="/dashboard/weddings"
					hx-post="/dashboard/weddings"
				}
				hx-target="#wizard-step"
				hx-swap="outerHTML show:window:top"
				hx-disabled-elt="find button[type=submit]"
				class="space-y-4"
			>
				@layouts.CSRFField()
				@ui.Alert(f.Message)
				switch step {
					case 1:
						@hiddenExcept(f, "theme_id")
						@themePicker(f, themes)
					default:
						@hiddenExcept(f, "groom_name", "bride_name", "wedding_date")
						if themeName(themes, f.v("theme_id")) != "" {
							<p class="rounded-xl bg-lovoria-primary-soft px-4 py-3 text-sm text-lovoria-text">
								Tema: <span class="font-medium text-lovoria-primary">{ themeName(themes, f.v("theme_id")) }</span>
								<span class="text-lovoria-muted">— bisa diganti kapan saja.</span>
							</p>
						}
						@ui.Input(ui.Field{ID: "wedding-groom-name", Name: "groom_name", Label: "Nama mempelai pria", Type: "text", Value: f.v("groom_name"), Error: f.e("groom_name"), Placeholder: "Samuel", Required: true, MaxLength: 100, Autocomplete: "off"})
						@ui.Input(ui.Field{ID: "wedding-bride-name", Name: "bride_name", Label: "Nama mempelai wanita", Type: "text", Value: f.v("bride_name"), Error: f.e("bride_name"), Placeholder: "Sarah", Required: true, MaxLength: 100, Autocomplete: "off"})
						@ui.Input(ui.Field{ID: "wedding-date", Name: "wedding_date", Label: "Tanggal pernikahan", Type: "date", Value: f.v("wedding_date"), Error: f.e("wedding_date"), Required: true, Hint: "Belum pasti? Isi perkiraan dulu — bisa diubah nanti."})
				}
				// Langkah tema panjang di ponsel: tombol Lanjut menempel di bawah layar.
				<div class={ "flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:justify-between", templ.KV("sticky bottom-0 z-10 border-t border-lovoria-border bg-lovoria-surface pb-1 pt-3", step == 1) }>
					if step > 1 && len(themes) > 0 {
						@ui.SecondaryButton("Ganti tema", "back", "1")
					} else {
						<span></span>
					}
					if step < wizardSteps {
						@ui.PrimaryButton("Lanjut")
					} else {
						@ui.PrimaryButton("Buat & lihat undangan")
					}
				</div>
			</form>
		}
	</div>
}

// themePicker: langkah 1 — kartu tema dengan thumbnail asli, dikelompokkan
// koleksi utama & Koleksi Daerah.
templ themePicker(f form, themes []ThemeChoice) {
	<fieldset>
		<legend class="text-lg font-semibold">Pilih tema undangan</legend>
		<p class="mt-1 text-sm text-lovoria-muted">Pilih tampilan yang paling kalian. Warna, huruf, dan foto sampulnya bisa disesuaikan setelahnya.</p>
		if f.e("theme_id") != "" {
			<p role="alert" class="mt-2 text-sm text-lovoria-danger">{ f.e("theme_id") }</p>
		}
		<div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
			for _, t := range themesOf(themes, false) {
				@themeOption(t, f.v("theme_id"))
			}
		</div>
		if len(themesOf(themes, true)) > 0 {
			<p class="mt-7 text-xs font-medium uppercase tracking-[0.22em] text-lovoria-accent-ink">Koleksi Daerah</p>
			<p class="mt-1 text-sm text-lovoria-muted">Tradisi yang dikemas dengan rasa modern.</p>
			<div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
				for _, t := range themesOf(themes, true) {
					@themeOption(t, f.v("theme_id"))
				}
			</div>
		}
	</fieldset>
}

templ themeOption(t ThemeChoice, selected string) {
	<div>
		<label class="block cursor-pointer">
			<input type="radio" name="theme_id" value={ t.ID } checked?={ t.ID == selected } required class="peer sr-only"/>
			<span class="block overflow-hidden rounded-2xl bg-lovoria-surface ring-1 ring-lovoria-border transition peer-checked:ring-4 peer-checked:ring-lovoria-primary peer-focus-visible:ring-4">
				if t.Thumb != "" {
					<img src={ t.Thumb } alt="" width="600" height="750" loading="lazy" decoding="async" class="aspect-[4/5] w-full object-cover object-top"/>
				} else {
					<span class="flex aspect-[4/5] items-center justify-center px-2 text-center font-display text-lg" style={ "background:" + t.Surface + ";color:" + t.Primary }>{ t.Name }</span>
				}
				<span class="block p-2.5">
					if t.Featured {
						<span class="mb-1 inline-block whitespace-nowrap rounded-full bg-lovoria-primary-soft px-1.5 py-0.5 text-[10px] font-medium text-lovoria-primary">Pilihan Lunovia</span>
					}
					<span class="block text-sm font-semibold leading-snug">{ t.Name }</span>
				</span>
			</span>
		</label>
		if t.DemoURL != "" {
			<a href={ templ.SafeURL(t.DemoURL) } target="_blank" rel="noopener" class="mt-1.5 inline-block text-xs text-lovoria-primary hover:underline">Lihat contoh ↗</a>
		}
	</div>
}

// startPage: pratinjau pertama setelah wizard — undangan dengan tema pilihan
// dan nama pasangan; bagian yang masih kosong diisi contoh.
templ startPage(w Wedding) {
	@layouts.Dashboard(layouts.Meta{Title: "Undangan kalian sudah jadi"}) {
		<div class="mx-auto grid max-w-4xl gap-8 md:grid-cols-[minmax(0,1fr)_20rem] md:items-center">
			<div>
				<p class="text-xs font-medium uppercase tracking-[0.22em] text-lovoria-accent-ink">Langkah pertama selesai</p>
				<h1 class="mt-2 font-display text-3xl leading-tight text-lovoria-deep sm:text-4xl">Undangan kalian sudah jadi</h1>
				<p class="mt-3 leading-relaxed text-lovoria-muted">Ini tampilan awalnya. Bagian yang masih kosong diisi contoh — lengkapi dengan cerita, acara, dan foto kalian sendiri. Semuanya gratis sampai kalian siap menerbitkannya.</p>
				<div class="mt-6 flex flex-wrap gap-3">
					<a href={ templ.SafeURL(weddingURL(w, "/couple")) } class="ui-btn ui-btn-primary">Lanjut lengkapi undangan</a>
					<a href={ templ.SafeURL(weddingURL(w, "/theme/preview")) } target="_blank" rel="noopener" class="ui-btn ui-btn-secondary">Buka pratinjau penuh ↗</a>
				</div>
				<p class="mt-4 text-sm">
					<a href={ templ.SafeURL(weddingURL(w, "/theme")) } class="ui-link">Ganti tema</a>
					<span class="text-lovoria-muted" aria-hidden="true">·</span>
					<a href={ templ.SafeURL(weddingURL(w, "")) } class="ui-link">Ke beranda undangan</a>
				</p>
			</div>
			<div class="mx-auto w-full max-w-xs overflow-hidden rounded-[2rem] border border-lovoria-border bg-white shadow-soft">
				<iframe src={ weddingURL(w, "/theme/preview") } title="Pratinjau undangan" loading="lazy" class="block h-[36rem] w-full"></iframe>
			</div>
		</div>
	}
}

// ---------- Daftar ----------
templ listPage(weddings []Wedding, now time.Time) {
	@layouts.Dashboard(layouts.Meta{Title: "Wedding saya"}) {
		<div class="flex items-center justify-between gap-4">
			<h1 class="font-display text-2xl leading-tight text-lovoria-deep sm:text-3xl">Wedding saya</h1>
			<a href="/dashboard/weddings/new" class="ui-btn ui-btn-primary px-3 py-2 text-sm">+ Buat baru</a>
		</div>
		<ul class="mt-6 grid gap-4 sm:grid-cols-2">
			for _, w := range weddings {
				<li>
					<a href={ templ.SafeURL(weddingURL(w, "")) } class="ui-card block p-5 transition hover:border-lovoria-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lovoria-primary">
						<div class="flex items-start justify-between gap-3">
							<p class="font-semibold">{ w.Title }</p>
							<span class={ "flex-none rounded-full px-2.5 py-0.5 text-xs font-medium", statusBadge[w.Status] }>{ StatusLabel(w.Status) }</span>
						</div>
						<p class="mt-1 text-sm text-lovoria-muted">{ web.FormatDateID(w.WeddingDate) } · <span class="font-medium text-lovoria-text">{ w.CountdownText(now) }</span></p>
						<p class="mt-2 text-xs text-lovoria-muted">/w/{ w.Slug }</p>
					</a>
				</li>
			}
		</ul>
	}
}

// ---------- Halaman wedding ----------
// navItem / navGroups: navigasi dashboard satu wedding (sidebar desktop,
// bottom nav + menu di ponsel). Suffix = akhiran URL wedding.
type navItem struct{ Suffix, Label, Icon string }

var navGroups = []struct {
	Title string
	Items []navItem
}{
	{"", []navItem{{"", "Beranda", "home"}}},
	{"Konten undangan", []navItem{{"/info", "Info wedding", ""}, {"/couple", "Pasangan", ""}, {"/events", "Acara", "calendar"}, {"/stories", "Cerita", ""}, {"/gallery", "Galeri", ""}, {"/theme", "Tema", ""}}},
	{"Tamu", []navItem{{"/guests", "Daftar tamu", "users"}, {"/share", "Bagikan", ""}, {"/rsvp", "RSVP", "check"}, {"/guestbook", "Ucapan", ""}, {"/gifts", "Hadiah", ""}}},
	{"Pengaturan", []navItem{{"/domain", "Domain", ""}}},
}

// bottomNav: pintasan di bar bawah ponsel (sisanya lewat "Menu").
var bottomNav = []navItem{{"", "Beranda", "home"}, {"/events", "Acara", "calendar"}, {"/guests", "Tamu", "users"}, {"/rsvp", "RSVP", "check"}}

var navIcons = map[string]string{
	"home":     "M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z",
	"calendar": "M7 3v3m10-3v3M4 8h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z",
	"users":    "M16 19v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1m17 0v-1a4 4 0 0 0-3-3.9M13 4.1a4 4 0 0 1 0 7.8M9.5 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z",
	"check":    "M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
	"menu":     "M4 6h16M4 12h16M4 18h16",
}

templ navIcon(name string) {
	<svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={ navIcons[name] }></path></svg>
}

// Shell adalah kerangka halaman dashboard satu wedding (judul + navigasi).
// Dipakai juga oleh sub-paket (event, story, ...). active = suffix URL menu aktif.
templ Shell(w Wedding, active string) {
	@layouts.Dashboard(layouts.Meta{Title: w.Title}) {
		<div class="lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-8">
			<aside class="hidden lg:block" aria-label="Menu wedding">
				<nav class="sticky top-6 space-y-5 text-sm">
					for _, g := range navGroups {
						<div>
							if g.Title != "" {
								<p class="mb-1 px-3 text-xs font-medium uppercase tracking-wide text-lovoria-muted">{ g.Title }</p>
							}
							<ul class="space-y-0.5">
								for _, it := range g.Items {
									<li>
										<a
											href={ templ.SafeURL(weddingURL(w, it.Suffix)) }
											class={ "block rounded-lg px-3 py-2", templ.KV("bg-lovoria-primary-soft font-medium text-lovoria-primary", active == it.Suffix), templ.KV("text-lovoria-muted hover:bg-lovoria-subtle hover:text-lovoria-text", active != it.Suffix) }
											if active == it.Suffix {
												aria-current="page"
											}
										>{ it.Label }</a>
									</li>
								}
							</ul>
						</div>
					}
					<a href={ templ.SafeURL("/w/" + w.Slug) } target="_blank" rel="noopener" class="block px-3 text-lovoria-primary hover:underline">Lihat undangan ↗</a>
				</nav>
			</aside>
			<div class="min-w-0 pb-24 lg:pb-0">
				<p class="text-sm text-lovoria-muted"><a href="/dashboard/weddings" class="hover:underline">Wedding saya</a></p>
				<h1 class="mt-1 break-words font-display text-2xl leading-tight text-lovoria-deep sm:text-3xl">{ w.Title }</h1>
				if guideIndex(w, active) >= 0 {
					@guideSteps(w, active)
				}
				<div class="mt-6">
					{ children... }
				</div>
				if guideIndex(w, active) >= 0 {
					@guideNext(w, active)
				}
			</div>
		</div>
		@bottomBar(w, active)
	}
}

// ---------- Langkah terpandu melengkapi undangan (T29) ----------

// guide: urutan melengkapi undangan selama masih draf. Hanya panduan — tiap
// langkah bebas dilewati dan semua menu tetap bisa dibuka kapan saja.
var guide = []navItem{
	{"/couple", "Mempelai", ""}, {"/events", "Acara", ""}, {"/stories", "Cerita", ""},
	{"/gallery", "Galeri", ""}, {"/theme", "Tampilan", ""}, {"/guests", "Tamu", ""},
}

// guideIndex: posisi halaman aktif dalam panduan; -1 bila bukan langkah panduan
// atau undangan sudah bukan draf (panduan hilang setelah terbit).
func guideIndex(w Wedding, active string) int {
	if !w.IsDraft() {
		return -1
	}
	for i, g := range guide {
		if g.Suffix == active {
			return i
		}
	}
	return -1
}

// guideSteps: pita langkah di atas halaman + tombol pratinjau.
templ guideSteps(w Wedding, active string) {
	<nav aria-label="Langkah melengkapi undangan" class="mt-5 rounded-2xl border border-lovoria-border bg-lovoria-surface p-3 sm:p-4">
		<div class="flex items-center justify-between gap-3">
			<p class="text-sm font-medium text-lovoria-deep">
				Lengkapi undangan
				<span class="font-normal text-lovoria-muted">· langkah { fmt.Sprint(guideIndex(w, active) + 1) } dari { fmt.Sprint(len(guide)) }</span>
			</p>
			<a href={ templ.SafeURL(weddingURL(w, "/theme/preview")) } target="_blank" rel="noopener" class="flex-none text-sm font-medium text-lovoria-primary hover:underline">Lihat pratinjau ↗</a>
		</div>
		<ol class="scrollbar-none -mx-1 mt-3 flex gap-1.5 overflow-x-auto px-1 pb-0.5 text-sm">
			for i, g := range guide {
				<li class="flex-none">
					<a
						href={ templ.SafeURL(weddingURL(w, g.Suffix)) }
						class={ "flex items-center gap-1.5 rounded-full border px-3 py-1.5", templ.KV("border-lovoria-primary bg-lovoria-primary text-white", g.Suffix == active), templ.KV("border-lovoria-border text-lovoria-muted hover:border-lovoria-primary hover:text-lovoria-primary", g.Suffix != active) }
						if g.Suffix == active {
							aria-current="step"
						}
					>
						<span class="text-xs opacity-80">{ fmt.Sprint(i + 1) }</span>
						{ g.Label }
					</a>
				</li>
			}
		</ol>
	</nav>
}

// guideNext: navigasi di bawah halaman — kembali, dan lanjut ke langkah berikut
// (atau selesai di langkah terakhir). Lanjut = lewati: tidak ada yang wajib.
templ guideNext(w Wedding, active string) {
	{{ i := guideIndex(w, active) }}
	<div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-lovoria-border pt-5">
		if i > 0 {
			<a href={ templ.SafeURL(weddingURL(w, guide[i-1].Suffix)) } class="ui-btn ui-btn-ghost px-3 py-2 text-sm">← { guide[i-1].Label }</a>
		} else {
			<a href={ templ.SafeURL(weddingURL(w, "/start")) } class="ui-btn ui-btn-ghost px-3 py-2 text-sm">← Pratinjau awal</a>
		}
		<div class="flex flex-wrap items-center justify-end gap-3">
			<p class="text-xs text-lovoria-muted">Boleh dilewati — bisa diisi kapan saja.</p>
			if i < len(guide)-1 {
				<a href={ templ.SafeURL(weddingURL(w, guide[i+1].Suffix)) } class="ui-btn ui-btn-primary px-4 py-2.5 text-sm">Lanjut: { guide[i+1].Label } →</a>
			} else {
				<a href={ templ.SafeURL(weddingURL(w, "")) } class="ui-btn ui-btn-primary px-4 py-2.5 text-sm">Selesai — lihat ringkasan →</a>
			}
		</div>
	</div>
}

func inBottomNav(active string) bool {
	for _, it := range bottomNav {
		if it.Suffix == active {
			return true
		}
	}
	return false
}

// bottomBar: navigasi bawah di ponsel. "Menu" memakai <details> sehingga
// tetap berfungsi tanpa JS.
templ bottomBar(w Wedding, active string) {
	<nav class="fixed inset-x-0 bottom-0 z-40 border-t border-lovoria-border bg-lovoria-surface/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden" aria-label="Menu wedding (ponsel)">
		<ul class="mx-auto grid max-w-md grid-cols-5 text-[11px]">
			for _, it := range bottomNav {
				<li>
					<a
						href={ templ.SafeURL(weddingURL(w, it.Suffix)) }
						class={ "flex flex-col items-center gap-0.5 py-2", templ.KV("text-lovoria-primary font-medium", active == it.Suffix), templ.KV("text-lovoria-muted", active != it.Suffix) }
						if active == it.Suffix {
							aria-current="page"
						}
					>
						@navIcon(it.Icon)
						{ it.Label }
					</a>
				</li>
			}
			<li>
				<details>
					<summary class={ "flex cursor-pointer list-none flex-col items-center gap-0.5 py-2 [&::-webkit-details-marker]:hidden", templ.KV("text-lovoria-primary font-medium", !inBottomNav(active)), templ.KV("text-lovoria-muted", inBottomNav(active)) }>
						@navIcon("menu")
						Menu
					</summary>
					<div class="fixed inset-x-0 bottom-[calc(3.5rem+env(safe-area-inset-bottom))] max-h-[70dvh] overflow-y-auto border-t border-lovoria-border bg-lovoria-surface px-4 py-4 shadow-2xl">
						for _, g := range navGroups[1:] {
							<p class="mt-3 text-xs font-medium uppercase tracking-wide text-lovoria-muted first:mt-0">{ g.Title }</p>
							<ul class="mt-1 grid grid-cols-2 gap-1 text-sm">
								for _, it := range g.Items {
									<li>
										<a
											href={ templ.SafeURL(weddingURL(w, it.Suffix)) }
											class={ "block rounded-lg px-3 py-2.5", templ.KV("bg-lovoria-primary-soft font-medium text-lovoria-primary", active == it.Suffix), templ.KV("text-lovoria-text hover:bg-lovoria-subtle", active != it.Suffix) }
										>{ it.Label }</a>
									</li>
								}
							</ul>
						}
						<a href={ templ.SafeURL("/w/" + w.Slug) } target="_blank" rel="noopener" class="mt-3 block px-3 py-2 text-sm text-lovoria-primary">Lihat undangan ↗</a>
					</div>
				</details>
			</li>
		</ul>
	</nav>
}

// overviewState: data halaman ringkasan wedding.
type overviewState struct {
	W         Wedding
	Couple    Couple
	Checklist []ChecklistItem
	History   []StatusChange
	Notice    string
	Error     string
	Now       time.Time
	// Home: widget beranda dari paket dashboard (boleh nil).
	Home templ.Component
}

func (o overviewState) ready() bool {
	for _, it := range o.Checklist {
		if !it.Done {
			return false
		}
	}
	return true
}

var statusHint = map[string]string{
	StatusDraft:      "Hanya Anda yang bisa melihat undangan. Publikasikan saat siap dibagikan ke tamu.",
	StatusPublished:  "Undangan bisa dibuka tamu. Pada hari H status berubah otomatis menjadi Hari H.",
	StatusWeddingDay: "Hari bahagia! Sehari setelahnya status otomatis menjadi Kenangan.",
	StatusMemory:     "RSVP ditutup, buku tamu tetap terbuka. Undangan tampil sebagai halaman kenangan: foto hari bahagia dan ucapan favorit di bagian atas.",
	StatusArchived:   "Undangan diarsipkan: cerita, galeri, dan ucapan tetap bisa dibaca, tetapi semua form ditutup.",
}

var statusBadge = map[string]string{
	StatusDraft:      "bg-lovoria-subtle text-lovoria-text",
	StatusPublished:  "bg-lovoria-success-soft text-lovoria-success",
	StatusWeddingDay: "bg-lovoria-primary text-white",
	StatusMemory:     "bg-lovoria-warning-soft text-lovoria-warning",
	StatusArchived:   "bg-lovoria-border text-lovoria-muted",
}

templ overviewPage(o overviewState) {
	@Shell(o.W, "") {
		<div class="space-y-4">
			@ui.Notice(o.Notice)
			@ui.Alert(o.Error)
			<div class="rounded-2xl bg-lovoria-deep p-5 text-white shadow-soft">
				<p class="font-display text-2xl">{ o.Couple.GroomName } &amp; { o.Couple.BrideName }</p>
				<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
					<p class="text-sm text-white/90">{ web.FormatDateID(o.W.WeddingDate) }</p>
					<p class="rounded-full bg-white/20 px-3 py-0.5 text-sm font-semibold">{ o.W.CountdownText(o.Now) }</p>
				</div>
			</div>
			@statusCard(o)
			if o.Home != nil {
				@o.Home
			}
		</div>
	}
}

templ statusCard(o overviewState) {
	if o.W.IsDraft() {
		@draftCard(o)
	} else {
		@liveCard(o)
	}
}

// draftCard: beranda undangan draf (T29) — mengajak melihat pratinjau dan
// melengkapi isi. Harga tidak ditampilkan, dan tombol publikasi baru muncul
// setelah syarat terbit terpenuhi.
templ draftCard(o overviewState) {
	@ui.Card() {
		<div class="flex flex-wrap items-center gap-2">
			<span class={ "rounded-full px-3 py-1 text-sm font-medium", statusBadge[o.W.Status] }>{ StatusLabel(o.W.Status) }</span>
			if o.W.IsPaid() {
				@ui.Badge(ui.Success, "Lunas ✓")
			}
		</div>
		<h2 class="mt-3 font-display text-2xl leading-tight text-lovoria-deep">Undangan kalian masih draf</h2>
		<p class="mt-2 text-sm leading-relaxed text-lovoria-muted">
			Hanya kalian yang bisa melihatnya.
			if !o.W.IsPaid() {
				Gratis dibuat dan dipratinjau — bayar hanya saat undangan diterbitkan.
			}
		</p>
		<div class="mt-4 flex flex-wrap gap-2">
			<a href={ templ.SafeURL(weddingURL(o.W, "/theme/preview")) } target="_blank" rel="noopener" class="ui-btn ui-btn-primary px-4 py-2.5">Lihat pratinjau ↗</a>
			<a href={ templ.SafeURL(weddingURL(o.W, guide[0].Suffix)) } class="ui-btn ui-btn-secondary px-4 py-2.5">Lanjut lengkapi</a>
		</div>
		<div class="mt-5 border-t border-lovoria-border pt-4">
			<p class="text-xs uppercase tracking-wide text-lovoria-muted">Syarat terbit</p>
			@publishChecklist(o)
			if o.ready() {
				<div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl bg-lovoria-primary-soft px-4 py-3">
					<p class="text-sm text-lovoria-text">Undangan sudah bisa diterbitkan kapan pun kalian siap.</p>
					if o.W.IsPaid() {
						<form method="post" action={ templ.SafeURL(weddingURL(o.W, "/status")) } data-confirm="Publikasikan undangan? Tamu yang punya link bisa membukanya.">
							@layouts.CSRFField()
							<input type="hidden" name="_method" value="PATCH"/>
							<input type="hidden" name="status" value="published"/>
							<button type="submit" class="ui-btn ui-btn-primary px-4 py-2.5">Publikasikan undangan</button>
						</form>
					} else {
						// Belum lunas (T23): harga & pembayaran ada di halaman publikasi.
						<a href={ templ.SafeURL(weddingURL(o.W, "/publish")) } class="ui-btn ui-btn-primary px-4 py-2.5">Publikasikan undangan</a>
					}
				</div>
			} else {
				<p class="mt-3 text-xs text-lovoria-muted">Tombol publikasi muncul setelah syarat di atas terpenuhi.</p>
			}
		</div>
		@statusHistory(o)
	}
}

templ publishChecklist(o overviewState) {
	<ul class="mt-2 space-y-1 text-sm" aria-label="Syarat publikasi">
		for _, it := range o.Checklist {
			<li class={ "flex items-center gap-2", templ.KV("text-lovoria-success", it.Done), templ.KV("text-lovoria-text", !it.Done) }>
				if it.Done {
					<span aria-hidden="true">✓</span><span class="sr-only">Sudah:</span>
				} else {
					<span aria-hidden="true" class="text-lovoria-danger">✗</span><span class="sr-only">Belum:</span>
				}
				{ it.Label }
				if !it.Done && it.Label == "Minimal 1 acara" {
					<a href={ templ.SafeURL(weddingURL(o.W, "/events")) } class="text-lovoria-primary hover:underline">Tambah acara</a>
				}
			</li>
		}
	</ul>
}

templ statusHistory(o overviewState) {
	if len(o.History) > 0 {
		<details class="mt-3 text-sm text-lovoria-muted">
			<summary class="cursor-pointer">Riwayat status</summary>
			<ul class="mt-2 space-y-1">
				for _, h := range o.History {
					<li>{ h.At.Format("02/01/2006 15:04") } — { StatusLabel(h.From) } → { StatusLabel(h.To) } <span class="text-lovoria-muted">({ actorLabel(h.Actor) })</span></li>
				}
			</ul>
		</details>
	}
}

// liveCard: status undangan yang sudah terbit / hari H / kenangan / arsip.
templ liveCard(o overviewState) {
	@ui.Card() {
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<p class="text-xs uppercase tracking-wide text-lovoria-muted">Status undangan</p>
				<p class="mt-1"><span class={ "rounded-full px-3 py-1 text-sm font-medium", statusBadge[o.W.Status] }>{ StatusLabel(o.W.Status) }</span></p>
			</div>
			if o.W.Status == StatusPublished {
				<form method="post" action={ templ.SafeURL(weddingURL(o.W, "/status")) } data-confirm="Tarik publikasi? Tamu tidak bisa membuka undangan sampai dipublikasikan lagi.">
					@layouts.CSRFField()
					<input type="hidden" name="_method" value="PATCH"/>
					<input type="hidden" name="status" value="draft"/>
					<button type="submit" class="ui-btn ui-btn-secondary px-4 py-2.5">Tarik publikasi</button>
				</form>
			}
		</div>
		<p class="mt-3 text-sm text-lovoria-muted">{ statusHint[o.W.Status] }</p>
		<p class="mt-3 flex flex-wrap items-center gap-2 border-t border-lovoria-border pt-3 text-sm">
			<span class="text-lovoria-muted">Pembayaran</span>
			if o.W.IsPaid() {
				@ui.Badge(ui.Success, "Lunas ✓")
			} else {
				@ui.Badge(ui.Muted, "Belum dibayar")
			}
		</p>
		if o.W.ShowsMemoryLayout() {
			@archiveVisibilityForm(o.W)
		}
		@statusHistory(o)
	}
}

// archiveVisibilityForm: pilihan siapa yang bisa membuka arsip (T19). Muncul
// sejak Kenangan supaya pasangan bisa memilih sebelum diarsipkan.
templ archiveVisibilityForm(w Wedding) {
	<form method="post" action={ templ.SafeURL(weddingURL(w, "/archive-visibility")) } class="mt-4 rounded-xl border border-lovoria-border p-4">
		@layouts.CSRFField()
		<input type="hidden" name="_method" value="PATCH"/>
		<fieldset>
			<legend class="text-sm font-medium text-lovoria-text">Visibilitas arsip</legend>
			<p class="mt-1 text-xs text-lovoria-muted">Berlaku setelah undangan diarsipkan.</p>
			<div class="mt-3 space-y-2 text-sm">
				<label class="flex items-start gap-2">
					<input type="radio" name="visibility" value={ ArchivePublicVisibility } checked?={ w.ArchiveVisibility != ArchivePrivate } class="mt-1"/>
					<span><span class="font-medium">Publik</span> — tamu dengan link tetap bisa membaca cerita, galeri, dan ucapan.</span>
				</label>
				<label class="flex items-start gap-2">
					<input type="radio" name="visibility" value={ ArchivePrivate } checked?={ w.ArchiveVisibility == ArchivePrivate } class="mt-1"/>
					<span><span class="font-medium">Privat</span> — hanya Anda (saat login); tamu melihat halaman ringkas.</span>
				</label>
			</div>
		</fieldset>
		<button type="submit" class="ui-btn ui-btn-secondary mt-3 px-4 py-2 text-sm">Simpan visibilitas</button>
	</form>
}

func actorLabel(a ActorKind) string {
	switch a {
	case ActorSystem:
		return "otomatis"
	case ActorAdmin:
		return "admin"
	default:
		return "Anda"
	}
}

templ infoPage(w Wedding, f form) {
	@Shell(w, "/info") {
		@infoForm(w, f)
	}
}

templ infoForm(w Wedding, f form) {
	@ui.Card() {
		<form
			method="post"
			action={ templ.SafeURL(weddingURL(w, "/info")) }
			hx-patch={ weddingURL(w, "/info") }
			hx-target="this"
			hx-swap="outerHTML"
			hx-disabled-elt="find button"
			class="space-y-4"
		>
			@layouts.CSRFField()
			<input type="hidden" name="_method" value="PATCH"/>
			@ui.Notice(f.Notice)
			@ui.Alert(f.Message)
			@ui.Input(ui.Field{ID: "info-title", Name: "title", Label: "Judul website", Type: "text", Value: f.v("title"), Error: f.e("title"), Required: true, MaxLength: 150})
			@ui.Input(ui.Field{ID: "info-date", Name: "wedding_date", Label: "Tanggal pernikahan", Type: "date", Value: f.v("wedding_date"), Error: f.e("wedding_date"), Required: true})
			@ui.Select(ui.Field{ID: "info-timezone", Name: "timezone", Label: "Zona waktu acara", Value: f.v("timezone"), Error: f.e("timezone"), Required: true}, timezoneOptions())
			@ui.TextArea(ui.Field{ID: "info-description", Name: "description", Label: "Deskripsi", Value: f.v("description"), Error: f.e("description"), MaxLength: 2000}, 5)
			@ui.ImageUpload(ui.Field{ID: "info-photo", Name: "main_photo_url", Label: "Foto utama", Value: f.v("main_photo_url"), Error: f.e("main_photo_url")}, weddingURL(w, "/gallery/items"), "cover")
			@ui.PrimaryButton("Simpan")
		</form>
	}
}

templ couplePage(w Wedding, f form) {
	@Shell(w, "/couple") {
		@coupleForm(w, f)
	}
}

templ coupleForm(w Wedding, f form) {
	<form
		method="post"
		action={ templ.SafeURL(weddingURL(w, "/couple")) }
		hx-patch={ weddingURL(w, "/couple") }
		hx-target="this"
		hx-swap="outerHTML"
		hx-disabled-elt="find button"
		class="space-y-4"
	>
		@layouts.CSRFField()
		<input type="hidden" name="_method" value="PATCH"/>
		@ui.Notice(f.Notice)
		@ui.Alert(f.Message)
		<div class="grid gap-4 md:grid-cols-2">
			@ui.Card() {
				<h2 class="font-semibold">Mempelai pria</h2>
				<div class="mt-3 space-y-4">
					@ui.Input(ui.Field{ID: "couple-groom-name", Name: "groom_name", Label: "Nama", Type: "text", Value: f.v("groom_name"), Error: f.e("groom_name"), Required: true, MaxLength: 100})
					@ui.ImageUpload(ui.Field{ID: "couple-groom-photo", Name: "groom_photo_url", Label: "Foto", Value: f.v("groom_photo_url"), Error: f.e("groom_photo_url")}, weddingURL(w, "/gallery/items"), "couple")
					@ui.TextArea(ui.Field{ID: "couple-groom-desc", Name: "groom_description", Label: "Deskripsi", Value: f.v("groom_description"), Error: f.e("groom_description"), MaxLength: 1000, Placeholder: "Putra dari Bapak … & Ibu …"}, 3)
				</div>
			}
			@ui.Card() {
				<h2 class="font-semibold">Mempelai wanita</h2>
				<div class="mt-3 space-y-4">
					@ui.Input(ui.Field{ID: "couple-bride-name", Name: "bride_name", Label: "Nama", Type: "text", Value: f.v("bride_name"), Error: f.e("bride_name"), Required: true, MaxLength: 100})
					@ui.ImageUpload(ui.Field{ID: "couple-bride-photo", Name: "bride_photo_url", Label: "Foto", Value: f.v("bride_photo_url"), Error: f.e("bride_photo_url")}, weddingURL(w, "/gallery/items"), "couple")
					@ui.TextArea(ui.Field{ID: "couple-bride-desc", Name: "bride_description", Label: "Deskripsi", Value: f.v("bride_description"), Error: f.e("bride_description"), MaxLength: 1000, Placeholder: "Putri dari Bapak … & Ibu …"}, 3)
				</div>
			}
		</div>
		@ui.PrimaryButton("Simpan")
	</form>
}
