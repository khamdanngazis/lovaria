package publicsite

import (
	"fmt"
	"time"

	"github.com/khamdanngazis/lovaria/src/modules/payment"
	"github.com/khamdanngazis/lovaria/src/platform/web"
	"github.com/khamdanngazis/lovaria/src/templates/layouts"
	"github.com/khamdanngazis/lovaria/static"
)

// landingData: isi dinamis landing page (T18).
type landingData struct {
	Themes []landingTheme
	// PriceIDR: harga publikasi sekali bayar per wedding (T23); 0 → bagian
	// harga disembunyikan.
	PriceIDR int64
	LoggedIn bool
	OGImage  string // URL absolut gambar Open Graph
	URL      string // URL kanonik landing
	// Kode verifikasi Search Console / Bing Webmaster (kosong → tanpa meta).
	GoogleVerification, BingVerification string
	// NavPrefix: awalan tautan menu (#tema, …): "" di landing, "/" di halaman lain.
	NavPrefix string
	// Testimonials: testimoni asli dari admin; kosong → bagiannya disembunyikan.
	Testimonials []web.Testimonial
}

type landingTheme struct {
	ID, Name, Description string
	Primary, Surface, Ink string // warna bawaan tema (kartu pratinjau)
	DemoURL               string // "" bila undangan contoh belum dibuat
	Photo                 string // thumbnail sampul undangan contoh ("" → kartu warna)
	Couple                string // "Raka & Nadia"
	Thumb                 string // tangkapan layar asli tema ("" → foto sampul / kartu warna)
	Featured              bool   // label "Pilihan Lunovia"
	Pitch                 string // uraian panjang (halaman /tema/<id>)
	Region                string // daerah inspirasi (Koleksi Daerah); "" = koleksi utama
	Accent                string
	FontHeading, FontBody string
}

// Teks utama landing di satu tempat supaya mudah disunting pemilik produk.
const (
	landingLead = "Undangan digital elegan yang dirancang untuk merayakan hari paling berarti dalam hidup Anda."
	landingDesc = seoDesc
)

// seoHead: meta kanonik + Open Graph / Twitter untuk halaman publik yang
// boleh diindeks (landing & etalase tema).
templ seoHead(url, title, desc, image string) {
	@layouts.BrandFonts(false)
	<link rel="apple-touch-icon" href={ static.URL("img/brand/apple-touch-icon.png") }/>
	<link rel="canonical" href={ url }/>
	<meta name="robots" content="index, follow, max-image-preview:large"/>
	<meta property="og:type" content="website"/>
	<meta property="og:site_name" content="Lunovia"/>
	<meta property="og:locale" content="id_ID"/>
	<meta property="og:title" content={ title }/>
	<meta property="og:description" content={ desc }/>
	<meta property="og:url" content={ url }/>
	<meta property="og:image" content={ image }/>
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:title" content={ title }/>
	<meta name="twitter:description" content={ desc }/>
	<meta name="twitter:image" content={ image }/>
}

templ landingHead(d landingData) {
	@seoHead(d.URL, "Lunovia — "+seoTitle, landingDesc, d.OGImage)
	<meta property="og:image:width" content="1200"/>
	<meta property="og:image:height" content="630"/>
	if d.GoogleVerification != "" {
		<meta name="google-site-verification" content={ d.GoogleVerification }/>
	}
	if d.BingVerification != "" {
		<meta name="msvalidate.01" content={ d.BingVerification }/>
	}
	@templ.JSONScript("ld-site", landingLD(d)).WithType("application/ld+json")
	<script src={ static.URL("js/landing.js") } defer></script>
}

templ landingPage(d landingData) {
	@layouts.Document(layouts.Meta{Title: seoTitle, Description: landingDesc, Cacheable: true}, landingHead(d), "bg-lovoria-bg font-ui text-lovoria-text antialiased") {
		@landingHeader(d)
		<main>
			@landingHero()
			@landingCollection(d)
			@landingGuestExperience()
			@landingFeatures(d)
			if len(d.Testimonials) > 0 {
				@landingTestimonials(d)
			}
			if d.PriceIDR > 0 {
				@landingPricing(d)
			}
			@landingCTA(d)
		</main>
		@landingFooter(d)
	}
}

// ---------- Ikon garis tipis (stroke 1.5, ujung membulat) ----------

var landingIcons = map[string]string{
	"heart":   "M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.65A4 4 0 0 1 19 10c0 5.65-7 10-7 10z",
	"pin":     "M12 21s-6-5.33-6-10.5A6 6 0 0 1 18 10.5C18 15.67 12 21 12 21zm0-8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
	"image":   "M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm0 10 4.5-4.5 3.5 3.5 2.5-2.5L20 17M15 9.5h.01",
	"check":   "M9 12.5l2 2 4-4.5M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z",
	"gift":    "M4 10h16v10H4zM3 7h18v3H3zm9 0v13M12 7c-1.5-3-5-3.5-5-1.25C7 7 9.5 7 12 7zm0 0c1.5-3 5-3.5 5-1.25C17 7 14.5 7 12 7z",
	"qr":      "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2.5v2.5H14zM20 14v2.5M14 20h2.5M20 20h.01M17.5 18h2.5v2",
	"shield":  "M12 3l7 3v5.5c0 4.5-3 7.8-7 9.5-4-1.7-7-5-7-9.5V6zM9 12l2 2 4-4.5",
	"chart":   "M4 20h16M7 16v-5M12 16V6M17 16v-8",
	"arrow":   "M5 12h14m-5-5 5 5-5 5",
	"chevron": "M6 9l6 6 6-6",
	"menu":    "M4 7h16M4 12h16M4 17h16",
}

templ icon(name, class string) {
	<svg aria-hidden="true" viewBox="0 0 24 24" class={ class } fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={ landingIcons[name] }></path></svg>
}

const (
	btnPrimary   = "inline-flex items-center justify-center gap-2 rounded-xl bg-lovoria-primary px-6 py-3.5 text-sm font-medium text-white shadow-soft transition hover:bg-lovoria-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lovoria-primary"
	btnSecondary = "inline-flex items-center justify-center gap-2 rounded-xl border border-lovoria-primary px-6 py-3.5 text-sm font-medium text-lovoria-primary transition hover:bg-lovoria-primary/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lovoria-primary"
	container    = "mx-auto w-full max-w-6xl px-5 sm:px-8"
	eyebrowClass = "text-[11px] font-medium uppercase tracking-[0.28em] text-lovoria-accent-ink"
	h2Class      = "mt-4 font-display text-3xl leading-tight text-lovoria-deep sm:text-4xl"
)

// textLink: tautan teks bergaris bawah dengan panah (ajakan tiap bagian).
templ textLink(href, label string) {
	<a href={ templ.SafeURL(href) } class="inline-flex items-center gap-2 border-b border-lovoria-accent pb-1 text-sm font-medium text-lovoria-deep transition hover:text-lovoria-primary">
		{ label }
		@icon("arrow", "h-4 w-4")
	</a>
}

// ---------- Header ----------
templ landingNavLinks(d landingData) {
	<a href="/" class="hover:text-lovoria-primary">Home</a>
	<a href={ templ.SafeURL(d.NavPrefix + "#tema") } class="hover:text-lovoria-primary">Collection</a>
	<a href={ templ.SafeURL(d.NavPrefix + "#cara-kerja") } class="hover:text-lovoria-primary">How It Works</a>
	if d.PriceIDR > 0 {
		<a href={ templ.SafeURL(d.NavPrefix + "#harga") } class="hover:text-lovoria-primary">Pricing</a>
	}
	<a href="/faq" class="hover:text-lovoria-primary">FAQ</a>
}

templ landingHeader(d landingData) {
	<header class="sticky top-0 z-40 border-b border-lovoria-border/70 bg-lovoria-bg/90 backdrop-blur">
		<div class={ container, "flex h-16 items-center justify-between gap-4" }>
			<a href="/" aria-label="Lunovia — beranda" class="text-lovoria-primary">
				@layouts.BrandLogo("")
			</a>
			<nav aria-label="Navigasi utama" class="hidden items-center gap-7 text-sm font-medium text-lovoria-text md:flex">
				@landingNavLinks(d)
			</nav>
			<div class="flex items-center gap-2">
				if d.LoggedIn {
					<a href="/dashboard" class={ btnPrimary, "!px-4 !py-2.5" }>Dashboard</a>
				} else {
					<a href="/login" class="hidden px-3 py-2 text-sm font-medium text-lovoria-text hover:text-lovoria-primary sm:inline">Login</a>
					<a href="/register" class={ btnPrimary, "whitespace-nowrap !px-4 !py-2.5" }>Get Started</a>
				}
				<details class="relative md:hidden">
					<summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg text-lovoria-deep [&::-webkit-details-marker]:hidden" aria-label="Menu">
						@icon("menu", "h-6 w-6")
					</summary>
					<nav aria-label="Navigasi (ponsel)" class="absolute right-0 top-12 flex w-52 flex-col gap-1 rounded-2xl border border-lovoria-border bg-white p-3 text-sm font-medium shadow-soft [&>a]:rounded-lg [&>a]:px-3 [&>a]:py-2.5 [&>a:hover]:bg-lovoria-bg">
						@landingNavLinks(d)
						if !d.LoggedIn {
							<a href="/login" class="hover:text-lovoria-primary">Login</a>
						}
					</nav>
				</details>
			</div>
		</div>
	</header>
}

// ---------- Hero ----------

// heroSrcset: foto hero 2 ukuran (sumber: cmd/server/demomedia/CREDITS.md).
func heroSrcset() string {
	return static.URL("img/landing/hero-720.webp") + " 720w, " + static.URL("img/landing/hero-1200.webp") + " 1200w"
}

templ landingHero() {
	<section class="relative overflow-hidden bg-lovoria-bg">
		<div class="relative h-[52svh] min-h-72 w-full lg:absolute lg:inset-y-0 lg:right-0 lg:h-auto lg:w-[60%]">
			<img src={ static.URL("img/landing/hero-720.webp") } srcset={ heroSrcset() } sizes="(min-width: 1024px) 60vw, 100vw" alt="Sepasang pengantin berbusana adat putih saling mendekat" width="1200" height="1300" fetchpriority="high" decoding="async" class="h-full w-full object-cover object-[50%_25%]"/>
			<div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(180deg,transparent_65%,#faf7f5)] lg:bg-[linear-gradient(90deg,#faf7f5,rgba(250,247,245,0.55)_22%,transparent_50%)]"></div>
		</div>
		<div class={ container, "relative pb-14 pt-4 lg:flex lg:min-h-[38rem] lg:items-center lg:py-20" }>
			<div class="lg:max-w-lg">
				<p class={ eyebrowClass }>Lunovia</p>
				<h1 class="mt-4 font-display text-[2.6rem] leading-[1.12] text-lovoria-deep sm:text-5xl lg:text-6xl">Your Love Story, Beautifully Invited.</h1>
				<p class="mt-5 max-w-md text-base leading-relaxed text-lovoria-muted sm:text-lg">{ landingLead }</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href="#tema" class={ btnPrimary }>
						Explore Invitations
						@icon("arrow", "h-4 w-4")
					</a>
					<a href="#cara-kerja" class={ btnSecondary }>See How It Works</a>
				</div>
				<p class="mt-8 text-[11px] uppercase tracking-[0.2em] text-lovoria-muted">Designed with care · Made for your moment</p>
			</div>
		</div>
	</section>
}

// ---------- Koleksi ----------

// landingCollectionIDs: tema terbaik yang tampil di beranda (sisanya di /tema).
var landingCollectionIDs = []string{"signature", "elegant", "romantic", "jawa"}

// collectionThemes: tema pilihan yang masih aktif, sesuai urutan di atas.
func collectionThemes(d landingData) []landingTheme {
	var out []landingTheme
	for _, id := range landingCollectionIDs {
		for _, t := range d.Themes {
			if t.ID == id {
				out = append(out, t)
			}
		}
	}
	return out
}

// themeHref: phone menuju undangan contoh; tanpa contoh → halaman tema.
func themeHref(t landingTheme) string {
	if t.DemoURL != "" {
		return t.DemoURL
	}
	return "/tema/" + t.ID
}

templ landingCollection(d landingData) {
	<section id="tema" class="scroll-mt-20 border-t border-lovoria-border/70 bg-lovoria-bg">
		<div class={ container, "grid gap-10 pt-16 sm:pt-20 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:items-end lg:gap-10" }>
			<div class="lg:pb-20">
				<p class={ eyebrowClass }>The Collection</p>
				<h2 class={ h2Class }>Timeless Designs for Your Special Day</h2>
				<p class="mt-4 max-w-md leading-relaxed text-lovoria-muted">Koleksi undangan digital dengan estetika modern dan sentuhan elegan, termasuk Koleksi Daerah bernuansa adat. Warna, huruf, dan foto sampulnya bisa disesuaikan dengan kisah Anda.</p>
				<p class="mt-7">
					@textLink("/tema", "Discover the Collection")
				</p>
			</div>
			<ul class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 scrollbar-none sm:mx-0 sm:gap-4 sm:px-0">
				for _, t := range collectionThemes(d) {
					@themePhone(t)
				}
			</ul>
		</div>
	</section>
}

// themePhone: tangkapan layar tema di dalam bingkai ponsel, terpotong di tepi
// bawah bagian (seperti ponsel yang berdiri di belakang garis).
templ themePhone(t landingTheme) {
	<li class="w-[58vw] max-w-52 flex-none snap-center sm:w-44 lg:w-auto lg:flex-1">
		<div class="min-h-9">
			<h3 class="text-xs font-medium leading-snug text-lovoria-deep"><a href={ templ.SafeURL("/tema/" + t.ID) } class="hover:text-lovoria-primary">{ t.Name }</a></h3>
			if t.Featured {
				<p class="mt-0.5 text-[10px] uppercase tracking-[0.12em] text-lovoria-accent-ink">Pilihan Lunovia</p>
			}
		</div>
		<a href={ templ.SafeURL(themeHref(t)) } aria-label={ "Lihat contoh tema " + t.Name } class="relative mt-2 block overflow-hidden rounded-t-[1.75rem] border-[5px] border-b-0 border-lovoria-deep bg-lovoria-deep shadow-soft transition duration-300 hover:-translate-y-1">
			<span aria-hidden="true" class="absolute left-1/2 top-1.5 z-10 h-1.5 w-12 -translate-x-1/2 rounded-full bg-lovoria-deep"></span>
			if t.Thumb != "" {
				<img src={ t.Thumb } alt="" width="600" height="750" loading="lazy" decoding="async" class="aspect-[4/5] w-full rounded-t-[1.4rem] object-cover object-top"/>
			} else {
				<span class="flex aspect-[4/5] items-center justify-center rounded-t-[1.4rem] px-3 text-center font-display text-lg" style={ "background:" + t.Surface + ";color:" + t.Primary }>{ t.Name }</span>
			}
		</a>
	</li>
}

// ---------- Guest experience (QR check-in) ----------

var guestPoints = [][2]string{
	{"qr", "Undangan Personal & QR Guest Pass"},
	{"shield", "Validasi Tamu Anti Duplikasi"},
	{"chart", "Dashboard Rekap Kehadiran"},
}

templ landingGuestExperience() {
	<section id="cara-kerja" class="scroll-mt-20 bg-lovoria-subtle py-16 sm:py-20">
		<div class={ container, "grid items-center gap-12 lg:grid-cols-2" }>
			<div class="relative pb-10 pr-10 sm:pr-16">
				<img src={ static.URL("img/landing/venue.webp") } alt="Pelaminan dan lorong resepsi berhias bunga putih" width="1000" height="750" loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded-2xl object-cover"/>
				@guestPassPhone()
			</div>
			<div>
				<p class={ eyebrowClass }>Guest Experience</p>
				<h2 class={ h2Class }>A Seamless Welcome for Every Guest</h2>
				<p class="mt-4 max-w-lg leading-relaxed text-lovoria-muted">Lebih dari sekadar undangan, Lunovia menghadirkan pengalaman check-in modern dengan QR code: tamu menunjukkan QR di undangan pribadinya, penerima tamu memindainya, dan rekap kehadiran terus diperbarui di dashboard.</p>
				<ul class="mt-7 grid gap-4 sm:grid-cols-3">
					for _, p := range guestPoints {
						<li class="flex items-center gap-3 text-sm leading-snug text-lovoria-text sm:flex-col sm:items-start">
							<span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-white text-lovoria-primary">
								@icon(p[0], "h-5 w-5")
							</span>
							{ p[1] }
						</li>
					}
				</ul>
				<p class="mt-8">
					@textLink("/faq#qr-checkin", "Discover Guest Check-in")
				</p>
			</div>
		</div>
	</section>
}

// guestPassPhone: ilustrasi QR di undangan tamu (HTML/CSS; data contoh).
templ guestPassPhone() {
	<div aria-hidden="true" class="absolute bottom-0 right-0 w-36 rounded-[1.6rem] border-[5px] border-lovoria-deep bg-lovoria-bg px-3 pb-4 pt-5 text-center shadow-soft sm:w-44">
		<p class="text-[8px] uppercase tracking-[0.3em] text-lovoria-muted">Lunovia</p>
		<p class="mt-2 font-display text-sm text-lovoria-deep sm:text-base">Guest Pass</p>
		<p class="text-[9px] text-lovoria-muted">Scan to Check-in</p>
		<img src={ static.URL("img/landing/qr-sample.svg") } alt="" width="120" height="120" loading="lazy" class="mx-auto mt-2 w-20 sm:w-24"/>
		<p class="mt-2 font-display text-xs text-lovoria-deep sm:text-sm">Raka &amp; Nadia</p>
		<p class="text-[9px] tracking-widest text-lovoria-muted">14 · 02 · 2027</p>
	</div>
}

// ---------- Fitur ----------

// firstDemo: undangan contoh pertama dari koleksi; "" bila belum ada.
func firstDemo(d landingData) string {
	for _, t := range collectionThemes(d) {
		if t.DemoURL != "" {
			return t.DemoURL
		}
	}
	return ""
}

templ landingFeatures(d landingData) {
	<section id="fitur" class="scroll-mt-20 bg-lovoria-bg py-16 sm:py-20">
		<div class={ container, "grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-12" }>
			<div>
				<p class={ eyebrowClass }>More Than Just an Invitation</p>
				<h2 class={ h2Class }>A Complete Experience for Your Wedding Day</h2>
				<p class="mt-4 max-w-md leading-relaxed text-lovoria-muted">Dari informasi acara hingga galeri kenangan, semua yang Anda butuhkan dalam satu undangan digital yang indah dan mudah diakses.</p>
				if firstDemo(d) != "" {
					<p class="mt-7">
						@textLink(firstDemo(d), "See It in Action")
					</p>
				}
			</div>
			<ul class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-2 scrollbar-none sm:mx-0 sm:px-0">
				@featureCard("pin", "Detail Acara & Lokasi") {
					<p class="font-display text-[11px] text-lovoria-deep">Akad &amp; Resepsi</p>
					for _, l := range []string{"Sabtu, 14 Februari", "10.00 WIB", "Lihat peta"} {
						<p class="mt-2 border-t border-lovoria-border pt-2 text-[9px] text-lovoria-muted">{ l }</p>
					}
				}
				@featureCard("image", "Galeri Foto") {
					<div class="grid grid-cols-2 gap-1">
						for _, n := range []string{"g1", "g2", "g3", "g4"} {
							<img src={ static.URL("img/landing/" + n + ".webp") } alt="" width="200" height="200" loading="lazy" decoding="async" class="aspect-square w-full rounded object-cover"/>
						}
					</div>
				}
				@featureCard("check", "RSVP Kehadiran") {
					<p class="font-display text-[11px] text-lovoria-deep">Konfirmasi</p>
					for _, l := range []string{"Nama tamu", "Jumlah tamu"} {
						<p class="mt-2 rounded border border-lovoria-border bg-white px-2 py-1.5 text-left text-[9px] text-lovoria-muted">{ l }</p>
					}
					<p class="mt-2 rounded bg-lovoria-primary py-1.5 text-[9px] text-white">Kirim</p>
				}
				@featureCard("heart", "Cerita Pasangan") {
					<img src={ static.URL("img/landing/story.webp") } alt="" width="320" height="320" loading="lazy" decoding="async" class="aspect-square w-full rounded object-cover"/>
					<p class="mt-2 font-display text-[11px] text-lovoria-deep">Our Story</p>
				}
				@featureCard("gift", "Amplop Digital") {
					<p class="font-display text-[11px] text-lovoria-deep">Tanda Kasih</p>
					<p class="mt-2 rounded border border-lovoria-border bg-white px-2 py-2 text-[9px] text-lovoria-muted">No. rekening &amp; e-wallet</p>
					<p class="mt-2 rounded border border-lovoria-primary py-1.5 text-[9px] text-lovoria-primary">Salin</p>
				}
			</ul>
		</div>
	</section>
}

// featureCard: ikon + nama fitur di atas cuplikan layar mini (dekoratif).
templ featureCard(iconName, label string) {
	<li class="w-32 flex-none snap-center text-center lg:w-auto lg:flex-1">
		@icon(iconName, "mx-auto h-5 w-5 text-lovoria-accent-ink")
		<p class="mt-2 min-h-10 text-xs leading-snug text-lovoria-text">{ label }</p>
		<div aria-hidden="true" class="mt-3 min-h-40 rounded-lg border border-lovoria-border bg-white p-2.5 text-center">
			{ children... }
		</div>
	</li>
}

// ---------- Testimoni ----------

// Hanya dari data asli (admin → Testimoni); tanpa data, bagian ini tidak tampil.
templ landingTestimonials(d landingData) {
	<section id="testimoni" class="scroll-mt-20 bg-lovoria-subtle py-16 sm:py-20">
		<div class={ container, "grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:items-center" }>
			<div>
				<p class={ eyebrowClass }>Real Stories</p>
				<h2 class={ h2Class }>Loved by Couples, Trusted by Families</h2>
			</div>
			<ul class="-mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 scrollbar-none sm:mx-0 sm:px-0">
				for _, t := range d.Testimonials {
					<li class="w-72 flex-none snap-center rounded-2xl border border-lovoria-border bg-white p-6">
						<figure>
							<blockquote class="font-display leading-relaxed text-lovoria-deep">“{ t.Quote }”</blockquote>
							<figcaption class="mt-4 text-[11px] uppercase tracking-[0.2em] text-lovoria-muted">{ t.Name }</figcaption>
						</figure>
					</li>
				}
			</ul>
		</div>
	</section>
}

// ---------- Harga ----------

// Lunovia punya satu harga (T23), jadi paket tampil satu kartu dengan harga
// asli — bukan tiga paket contoh pada mockup.
templ landingPricing(d landingData) {
	<section id="harga" class="scroll-mt-20 border-t border-lovoria-border/70 bg-lovoria-bg py-16 sm:py-20">
		<div class={ container, "grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:items-center" }>
			<div>
				<p class={ eyebrowClass }>Our Package</p>
				<h2 class={ h2Class }>One Price, the Complete Experience</h2>
				<p class="mt-4 leading-relaxed text-lovoria-muted">Buat dan sunting undangan sepuasnya tanpa biaya. Bayar sekali saat undangan siap dipublikasikan.</p>
			</div>
			<div class="rounded-2xl border border-lovoria-border bg-white p-6 shadow-soft sm:p-8">
				<div class="flex flex-wrap items-end gap-x-4 gap-y-2">
					<p class="font-display text-4xl leading-none text-lovoria-primary sm:text-5xl">{ payment.Rupiah(d.PriceIDR) }</p>
					<p class="text-sm text-lovoria-muted">sekali bayar per undangan · tanpa langganan</p>
				</div>
				<ul class="mt-6 grid gap-3 border-t border-lovoria-border pt-6 text-sm text-lovoria-text sm:grid-cols-2">
					for _, f := range payment.Features {
						<li class="flex gap-2">
							@icon("check", "h-5 w-5 flex-none text-lovoria-accent-ink")
							{ f }
						</li>
					}
				</ul>
				<div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
					<a href="/register" class={ btnPrimary }>Buat Undangan — Gratis Dicoba</a>
					<p class="text-sm text-lovoria-muted">Pembayaran baru diminta saat Anda menekan Publikasikan.</p>
				</div>
			</div>
		</div>
	</section>
}

// ---------- FAQ (halaman /faq) ----------

const faqCheckinQ = "Bagaimana cara kerja QR check-in?"

var landingFAQs = [][2]string{
	{"Apakah tamu perlu mengunduh aplikasi?", "Tidak. Undangan dibuka langsung di browser ponsel dari link yang kalian kirim, termasuk dari WhatsApp."},
	{"Bagaimana cara mengirim undangan ke tamu?", "Tambahkan daftar tamu (ketik, tempel dari catatan, atau import CSV). Setiap tamu mendapat link pribadi dengan namanya; kirim lewat tombol WhatsApp atau salin pesan yang sudah disiapkan."},
	{faqCheckinQ, "Aktifkan check-in dari dashboard, lalu tiap tamu mendapat QR di undangan pribadinya. Penerima tamu memindai QR itu di pintu masuk lewat ponsel; QR yang sudah dipakai langsung terdeteksi, dan rekap kehadiran tampil di dashboard."},
	{"Bisakah memakai domain sendiri?", "Bisa. Hubungkan domain seperti www.namakalian.com dari menu Domain; kami memandu pengaturan DNS-nya langkah demi langkah dan HTTPS aktif otomatis."},
	{"Apakah isi undangan bisa diubah setelah dibagikan?", "Bisa kapan saja. Perubahan langsung terlihat oleh tamu tanpa perlu mengirim ulang link."},
	{"Apa yang terjadi setelah hari pernikahan?", "Website berubah menjadi halaman kenangan: konfirmasi kehadiran ditutup, sementara cerita dan ucapan tetap bisa dikunjungi. Halaman kenangan tetap bisa dibuka setelah hari bahagia."},
	{"Apakah data tamu aman?", "Link pribadi tamu tidak diindeks mesin pencari, data tidak dijual, dan cadangan data dibuat setiap hari. Selengkapnya di Kebijakan Privasi."},
}

// faqs: pertanyaan umum; soal biaya mengikuti harga publikasi yang berlaku.
func faqs(d landingData) [][2]string {
	if d.PriceIDR <= 0 {
		return landingFAQs
	}
	price := [2]string{"Berapa biayanya?", "Membuat, menyunting, dan melihat pratinjau undangan gratis. Bayar " + payment.Rupiah(d.PriceIDR) + " satu kali saat undangan dipublikasikan — tanpa langganan, dan semua fitur termasuk custom domain sudah termasuk."}
	return append([][2]string{price}, landingFAQs...)
}

const (
	faqTitle = "Pertanyaan Seputar Undangan Pernikahan Digital"
	faqDesc  = "Jawaban atas pertanyaan yang sering diajukan tentang undangan pernikahan digital Lunovia: biaya, cara mengirim ke tamu, QR check-in, domain sendiri, dan keamanan data."
)

templ faqHead(d landingData) {
	@seoHead(siteBase(d)+"/faq", faqTitle+" — Lunovia", faqDesc, d.OGImage)
	@templ.JSONScript("ld-faq", faqLD(d)).WithType("application/ld+json")
	@templ.JSONScript("ld-breadcrumb", breadcrumbLD(siteBase(d), [2]string{"Beranda", "/"}, [2]string{"FAQ", "/faq"})).WithType("application/ld+json")
}

templ faqPage(d landingData) {
	@sitePage(d, layouts.Meta{Title: faqTitle, Description: faqDesc, Cacheable: true}, faqHead(d)) {
		<section class="py-12 sm:py-16">
			<div class={ container }>
				@crumbs([2]string{"Beranda", "/"}, [2]string{"FAQ", "/faq"})
				<h1 class="mt-6 font-display text-4xl leading-tight text-lovoria-deep sm:text-5xl">Pertanyaan yang sering diajukan</h1>
				<div id="faq" class="mt-10 max-w-3xl divide-y divide-lovoria-border border-y border-lovoria-border">
					for _, q := range faqs(d) {
						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-lovoria-deep [&::-webkit-details-marker]:hidden">
								{ q[0] }
								@icon("chevron", "h-5 w-5 flex-none text-lovoria-primary transition group-open:rotate-180")
							</summary>
							// Jangkar di dalam <details>: browser membukanya saat dituju.
							<p
								class="mt-3 scroll-mt-32 leading-relaxed text-lovoria-muted"
								if q[0] == faqCheckinQ {
									id="qr-checkin"
								}
							>{ q[1] }</p>
						</details>
					}
				</div>
			</div>
		</section>
		@themeCTA(d)
	}
}

// ---------- CTA & footer ----------
templ landingCTA(d landingData) {
	<section class="relative overflow-hidden">
		<img src={ static.URL("img/landing/bouquet.webp") } alt="" width="1200" height="800" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover"/>
		<div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(90deg,rgba(250,247,245,0.92),rgba(250,247,245,0.6))]"></div>
		<div class={ container, "relative flex flex-col gap-7 py-16 sm:py-20 lg:flex-row lg:items-center lg:justify-between" }>
			<div>
				<h2 class="font-display text-3xl leading-tight text-lovoria-deep sm:text-4xl">Your Special Day Starts Here.</h2>
				<p class="mt-3 max-w-md leading-relaxed text-lovoria-text">Buat undangan digital Anda sekarang dan wujudkan momen istimewa dengan cara yang lebih berkesan.</p>
			</div>
			<a href={ templ.SafeURL(ctaURL(d)) } class={ btnPrimary, "self-start lg:self-auto" }>
				if d.LoggedIn {
					Buka Dashboard
				} else {
					Mulai Sekarang
				}
				@icon("arrow", "h-4 w-4")
			</a>
		</div>
	</section>
}

func ctaURL(d landingData) string {
	if d.LoggedIn {
		return "/dashboard"
	}
	return "/register"
}

templ landingFooter(d landingData) {
	<footer class="border-t border-lovoria-border bg-lovoria-bg text-lovoria-muted">
		<div class={ container, "flex flex-col gap-8 py-12 sm:flex-row sm:items-start sm:justify-between" }>
			<div>
				<span class="text-lovoria-primary">
					@layouts.BrandLogo("")
				</span>
				<p class="mt-3 text-sm">More than an invitation.</p>
			</div>
			<nav aria-label="Tautan footer" class="grid grid-cols-2 gap-x-12 gap-y-2 text-sm [&>a:hover]:text-lovoria-primary">
				<a href="/">Home</a>
				<a href="/privacy">Kebijakan Privasi</a>
				<a href="/#tema">Collection</a>
				<a href="/terms">Syarat &amp; Ketentuan</a>
				<a href="/#cara-kerja">How It Works</a>
				<a href="/faq">FAQ</a>
				if d.PriceIDR > 0 {
					<a href="/#harga">Pricing</a>
				}
				<a href="/login">Login</a>
				<a href="/register">Daftar</a>
				if web.SupportURL() != "" {
					<a href={ templ.SafeURL(web.SupportURL()) } target="_blank" rel="noopener">Bantuan (WhatsApp)</a>
				}
			</nav>
		</div>
		if web.Contact().HasContact() {
			<address class={ container, "grid gap-1.5 border-t border-lovoria-border py-6 text-sm not-italic sm:grid-cols-[auto_1fr] sm:gap-x-8" }>
				<p class="text-xs font-medium uppercase tracking-[0.2em] sm:row-span-4">Hubungi kami</p>
				if c := web.Contact(); c.Email != "" {
					<p>Email: <a href={ templ.SafeURL("mailto:" + c.Email) } class="text-lovoria-text hover:underline">{ c.Email }</a></p>
				}
				if c := web.Contact(); c.Tel != "" {
					<p>Telepon: <a href={ templ.SafeURL("tel:+" + c.Tel) } class="text-lovoria-text hover:underline">{ c.TelDisplay() }</a></p>
				}
				if web.SupportURL() != "" {
					<p>WhatsApp: <a href={ templ.SafeURL(web.SupportURL()) } target="_blank" rel="noopener" class="text-lovoria-text hover:underline">chat dengan tim Lunovia ↗</a></p>
				}
				if c := web.Contact(); c.Address != "" {
					<p class="whitespace-pre-line">Alamat: { c.Address }</p>
				}
			</address>
		}
		<p class={ container, "pb-10 text-xs" }>© { fmt.Sprint(time.Now().Year()) } Lunovia. Semua hak dilindungi.</p>
	</footer>
}

// themesIn: tema koleksi utama (regional=false) atau Koleksi Daerah (true).
func themesIn(d landingData, regional bool) []landingTheme {
	var out []landingTheme
	for _, t := range d.Themes {
		if (t.Region != "") == regional {
			out = append(out, t)
		}
	}
	return out
}
